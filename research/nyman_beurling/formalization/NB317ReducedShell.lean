namespace Mathia.NB317

open Finset
open scoped BigOperators
open scoped ArithmeticFunction

def finPeriodEquiv (P j : ℕ) (hdiv : j ∣ P) [NeZero j] [NeZero (P / j)] :
    Fin P ≃ Fin j × Fin (P / j) where
  toFun n := (⟨n.val % j, Nat.mod_lt _ (NeZero.pos j)⟩, ⟨n.val / j,
    (Nat.div_lt_iff_lt_mul (NeZero.pos j)).2 (by
      have hfac : P = j * (P / j) := (Nat.mul_div_cancel' hdiv).symm
      calc
        n.val < P := n.isLt
        _ = j * (P / j) := hfac
        _ = (P / j) * j := Nat.mul_comm _ _)⟩)
  invFun p := ⟨p.1.val + j * p.2.val, by
    have hfac : P = j * (P / j) := (Nat.mul_div_cancel' hdiv).symm
    have hr := p.1.isLt
    have ht := p.2.isLt
    calc
      p.1.val + j * p.2.val < j * p.2.val + j := by omega
      _ = j * (p.2.val + 1) := by rw [Nat.mul_add, Nat.mul_one]
      _ ≤ j * (P / j) := Nat.mul_le_mul_left j (Nat.succ_le_of_lt ht)
      _ = P := hfac.symm⟩
  left_inv n := by
    apply Fin.ext
    exact Nat.mod_add_div n.val j
  right_inv p := by
    apply Prod.ext
    · apply Fin.ext
      change (p.1.val + j * p.2.val) % j = p.1.val
      rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt p.1.isLt]
    · apply Fin.ext
      dsimp
      rw [Nat.add_mul_div_left _ _ (NeZero.pos j), Nat.div_eq_of_lt p.1.isLt]
      simp

def cyclicDft (P : ℕ) [NeZero P] (f : Fin P → ℂ) (h : ZMod P) : ℂ :=
  ∑ k : Fin P, f k * ZMod.stdAddChar (-(h * (k.val : ZMod P)))

/-- The normalized finite Fourier coefficient, using the negative exponential. -/
def normalizedDft (P : ℕ) [NeZero P] (f : Fin P → ℂ) (h : ZMod P) : ℂ :=
  (P : ℂ)⁻¹ * cyclicDft P f h

def shellSequence (j : ℕ) (k : Fin P) : ℂ :=
  ((k.val % j : ℕ) : ℂ) / (j : ℂ)

/-- The finite section generated by the reciprocal-period sawtooth shells. -/
def shellSection (P N : ℕ) (a : ℕ → ℂ) (k : Fin P) : ℂ :=
  ∑ j ∈ Icc 2 N, a j * shellSequence j k

/-- The reduced-denominator coordinate attached to a shell section. -/
def divisorCoordinate (N : ℕ) (a : ℕ → ℂ) (q : ℕ) : ℂ :=
  ∑ j ∈ Icc 2 N, if q ∣ j then a j / (j : ℂ) else 0

/-- A finite divisor-poset form of the reduced-denominator coordinate. -/
def divisorPosetCoordinate (M : ℕ) (x : ℕ → ℝ) (q : ℕ) : ℝ :=
  ∑ d ∈ (M / q).divisors, x (M / d)

/-- The reduced-denominator coordinate for real shell coefficients `x_j=a_j/j`. -/
def reducedShellCoordinate (N : ℕ) (x : ℕ → ℝ) (q : ℕ) : ℝ :=
  ∑ j ∈ Icc 2 N, if q ∣ j then x j else 0

/-- Encode a truncated shell coefficient vector on the divisor poset of a common
period, setting coordinates outside `2,...,N` to zero. -/
def shellPosetProfile (P N : ℕ) (x : ℕ → ℝ) : ℕ → ℝ :=
  fun d => if d ∈ Icc 2 N then x d else 0

abbrev ReducedCoordinateIndex (N : ℕ) := {q : ℕ // q ∈ Icc 2 N}

/-- Extend a finite coefficient vector by zero outside its shell range. -/
def shellCoefficientProfile (N : ℕ) (x : ReducedCoordinateIndex N → ℝ) : ℕ → ℝ :=
  fun j => if hj : j ∈ Icc 2 N then x ⟨j, hj⟩ else 0

/-- Recover the original generator coefficients `a_j` from normalized shell
coordinates `x_j = a_j/j`. -/
def shellCoefficientsFromNormalized (N : ℕ)
    (x : ReducedCoordinateIndex N → ℝ) : ℕ → ℝ :=
  fun j => if hj : j ∈ Icc 2 N then (j : ℝ) * x ⟨j, hj⟩ else 0

/-- The shell-to-reduced-denominator coordinate transformation as a linear map
on the finite coefficient space. -/
def reducedCoordinateMap (N : ℕ) :
    (ReducedCoordinateIndex N → ℝ) →ₗ[ℝ] (ReducedCoordinateIndex N → ℝ) where
  toFun x q := ∑ j : ReducedCoordinateIndex N,
    if q.val ∣ j.val then x j else 0
  map_add' x y := by
    funext q
    change (∑ j : ReducedCoordinateIndex N,
        if q.val ∣ j.val then x j + y j else 0) =
      (∑ j : ReducedCoordinateIndex N,
        if q.val ∣ j.val then x j else 0) +
      (∑ j : ReducedCoordinateIndex N,
        if q.val ∣ j.val then y j else 0)
    rw [← Finset.sum_add_distrib]
    apply sum_congr rfl
    intro j hj
    by_cases hdiv : q.val ∣ j.val <;> simp [hdiv]
  map_smul' c x := by
    funext q
    change (∑ j : ReducedCoordinateIndex N,
        if q.val ∣ j.val then c * x j else 0) =
      c * (∑ j : ReducedCoordinateIndex N,
        if q.val ∣ j.val then x j else 0)
    rw [Finset.mul_sum]
    apply sum_congr rfl
    intro j hj
    by_cases hdiv : q.val ∣ j.val <;> simp [hdiv, smul_eq_mul]

private theorem reducedCoordinateMap_eq_shellCoordinate
    (N : ℕ) (x : ReducedCoordinateIndex N → ℝ) (q : ReducedCoordinateIndex N) :
    reducedCoordinateMap N x q =
      reducedShellCoordinate N (shellCoefficientProfile N x) q.val := by
  change (∑ j : ReducedCoordinateIndex N,
      if q.val ∣ j.val then x j else 0) =
    ∑ j ∈ Icc 2 N, if q.val ∣ j then shellCoefficientProfile N x j else 0
  calc
    _ = ∑ j : ReducedCoordinateIndex N,
        if q.val ∣ j.val then shellCoefficientProfile N x j.val else 0 := by
          apply sum_congr rfl
          intro j hj
          by_cases hdiv : q.val ∣ j.val <;> simp [hdiv, shellCoefficientProfile, j.property]
    _ = _ := by
          rw [Finset.sum_subtype (s := Icc 2 N) (h := fun j => Iff.rfl)
            (fun j => if q.val ∣ j then shellCoefficientProfile N x j else 0)]

/-- Möbius inversion on the divisor poset, used for the free shell coordinates. -/
theorem divisorPoset_mobius_inversion (M j : ℕ) (x : ℕ → ℝ)
    (hjM : j ∣ M) (hjpos : 0 < j) (hMpos : 0 < M) :
    x j = ∑ ℓ ∈ (M / j).divisors,
      (ArithmeticFunction.moebius ℓ : ℝ) * divisorPosetCoordinate M x (j * ℓ) := by
  classical
  let f : ℕ → ℝ := fun d => x (M / d)
  let g : ℕ → ℝ := fun n => ∑ d ∈ n.divisors, f d
  have hforward : ∀ n > 0, (∑ d ∈ n.divisors, f d) = g n := by
    intro n hn
    rfl
  have hinv := (ArithmeticFunction.sum_eq_iff_sum_mul_moebius_eq
    (f := f) (g := g)).mp hforward (M / j) (Nat.div_pos
      (Nat.le_of_dvd hMpos hjM) hjpos)
  have hinv' : (∑ ℓ ∈ (M / j).divisors,
      (ArithmeticFunction.moebius ℓ : ℝ) * g ((M / j) / ℓ)) = f (M / j) := by
    calc
      _ = ∑ p ∈ (M / j).divisorsAntidiagonal,
          (ArithmeticFunction.moebius p.1 : ℝ) * g p.2 :=
            (Nat.sum_divisorsAntidiagonal
              (fun ℓ r => (ArithmeticFunction.moebius ℓ : ℝ) * g r)
              (n := M / j)).symm
      _ = f (M / j) := hinv
  have hjfactor : M = j * (M / j) := (Nat.mul_div_cancel' hjM).symm
  have hnpos : 0 < M / j := Nat.div_pos (Nat.le_of_dvd hMpos hjM) hjpos
  have hval : f (M / j) = x j := by
    dsimp [f]
    rw [hjfactor]
    congr 1
    rw [Nat.mul_div_right _ hjpos]
    exact Nat.mul_div_left j hnpos
  have hsum : (∑ ℓ ∈ (M / j).divisors,
      (ArithmeticFunction.moebius ℓ : ℝ) * g ((M / j) / ℓ)) =
      ∑ ℓ ∈ (M / j).divisors,
        (ArithmeticFunction.moebius ℓ : ℝ) * divisorPosetCoordinate M x (j * ℓ) := by
    apply sum_congr rfl
    intro ℓ hℓ
    have hquot : M / (j * ℓ) = (M / j) / ℓ :=
      (Nat.div_div_eq_div_mul M j ℓ).symm
    simp [g, divisorPosetCoordinate, f, hquot]
  calc
    x j = f (M / j) := hval.symm
    _ = ∑ ℓ ∈ (M / j).divisors,
        (ArithmeticFunction.moebius ℓ : ℝ) * g ((M / j) / ℓ) := hinv'.symm
    _ = ∑ ℓ ∈ (M / j).divisors,
        (ArithmeticFunction.moebius ℓ : ℝ) * divisorPosetCoordinate M x (j * ℓ) := hsum

private theorem stdChar_fin_mul (P : ℕ) [NeZero P] (h : ZMod P) (k : Fin P) :
    ZMod.stdAddChar (-(h * (k.val : ZMod P))) =
      (ZMod.stdAddChar (-h)) ^ k.val := by
  have harg : -(h * (k.val : ZMod P)) = k.val • (-h) := by
    rw [nsmul_eq_mul]
    ring
  rw [harg]
  exact AddChar.map_nsmul_eq_pow _ _ _

private theorem sum_finPeriodEquiv {P j : ℕ} (hdiv : j ∣ P) [NeZero j] [NeZero (P / j)]
    {R : Type*} [AddCommMonoid R] (f : Fin P → R) :
    (∑ k : Fin P, f k) =
      ∑ r : Fin j, ∑ t : Fin (P / j), f ((finPeriodEquiv P j hdiv).symm (r, t)) := by
  calc
    (∑ k : Fin P, f k) =
        ∑ p : Fin j × Fin (P / j), f ((finPeriodEquiv P j hdiv).symm p) := by
          exact Fintype.sum_equiv (finPeriodEquiv P j hdiv) _ _ (fun _ => by simp)
    _ = ∑ r : Fin j, ∑ t : Fin (P / j),
        f ((finPeriodEquiv P j hdiv).symm (r, t)) := by
          rw [Fintype.sum_prod_type]

private theorem cyclicDft_shell_factor {P j : ℕ} (hdiv : j ∣ P) [NeZero P] [NeZero j]
    [NeZero (P / j)] (h : ZMod P) :
    cyclicDft P (shellSequence j) h =
      (∑ r : Fin j, ((r.val : ℂ) / (j : ℂ)) *
        (ZMod.stdAddChar (-h)) ^ r.val) *
      (∑ t : Fin (P / j), (ZMod.stdAddChar (-h) ^ j) ^ t.val) := by
  let z : ℂ := ZMod.stdAddChar (-h)
  calc
    cyclicDft P (shellSequence j) h =
        ∑ r : Fin j, ∑ t : Fin (P / j),
          ((r.val : ℂ) / (j : ℂ)) * z ^ (r.val + j * t.val) := by
      unfold cyclicDft shellSequence
      rw [sum_finPeriodEquiv hdiv]
      simp_rw [stdChar_fin_mul]
      apply sum_congr rfl
      intro r _
      apply sum_congr rfl
      intro t _
      simp [finPeriodEquiv, z, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt r.isLt]
    _ = (∑ r : Fin j, ((r.val : ℂ) / (j : ℂ)) * z ^ r.val) *
        (∑ t : Fin (P / j), (z ^ j) ^ t.val) := by
          calc
            _ = ∑ r : Fin j, (((r.val : ℂ) / (j : ℂ)) * z ^ r.val) *
                (∑ t : Fin (P / j), (z ^ j) ^ t.val) := by
                  apply sum_congr rfl
                  intro r _
                  rw [Finset.mul_sum]
                  apply sum_congr rfl
                  intro t _
                  rw [pow_add, pow_mul]
                  ring
            _ = _ := (Finset.sum_mul Finset.univ _ _).symm

private theorem geom_sum_mul (z : ℂ) (n : ℕ) :
    (1 - z) * (∑ k ∈ range n, z ^ k) = 1 - z ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [sum_range_succ, pow_succ]
      rw [mul_add, ih]
      ring

private theorem weighted_geom_identity (z : ℂ) (n : ℕ) :
    (1 - z) * (∑ k ∈ range n, (k : ℂ) * z ^ k) =
      (∑ k ∈ range n, z ^ k) - 1 - ((n : ℂ) - 1) * z ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [sum_range_succ, sum_range_succ, pow_succ]
      rw [mul_add, ih]
      push_cast
      ring

private theorem stdChar_pow_eq_one_iff {P : ℕ} [NeZero P] (h : ZMod P) (n : ℕ) :
    (ZMod.stdAddChar (-h)) ^ n = 1 ↔ addOrderOf h ∣ n := by
  constructor
  · intro hz
    have hc : ZMod.stdAddChar (n • (-h)) = 1 := by
      rw [AddChar.map_nsmul_eq_pow]
      exact hz
    have hzero : n • (-h) = 0 := ZMod.injective_stdAddChar (by simpa using hc)
    have hzero' : n • h = 0 := by simpa using congrArg Neg.neg hzero
    exact (addOrderOf_dvd_iff_nsmul_eq_zero).2 hzero'
  · intro hd
    have hzero : n • h = 0 := (addOrderOf_dvd_iff_nsmul_eq_zero).1 hd
    have hzero' : n • (-h) = 0 := by simpa using congrArg Neg.neg hzero
    have hc : ZMod.stdAddChar (n • (-h)) = 1 := by simp [hzero']
    rw [AddChar.map_nsmul_eq_pow] at hc
    exact hc

private theorem geom_sum_zero_of_root (z : ℂ) (n : ℕ) (hz : z ^ n = 1) (hne : z ≠ 1) :
    (∑ k ∈ range n, z ^ k) = 0 := by
  have hgeom := geom_sum_mul z n
  rw [hz] at hgeom
  have hden : 1 - z ≠ 0 := sub_ne_zero.mpr hne.symm
  have hmul : (1 - z) * (∑ k ∈ range n, z ^ k) = 0 := by
    calc
      _ = (1 - z) * (∑ k ∈ range n, z ^ k) := by ring
      _ = 0 := by rw [hgeom]; simp
  exact (mul_eq_zero.mp hmul).resolve_left hden

private theorem weighted_geom_root (z : ℂ) (n : ℕ) (hz : z ^ n = 1) (hne : z ≠ 1) :
    (∑ k ∈ range n, (k : ℂ) * z ^ k) = -(n : ℂ) / (1 - z) := by
  have hden : 1 - z ≠ 0 := sub_ne_zero.mpr hne.symm
  have hweighted := weighted_geom_identity z n
  rw [geom_sum_zero_of_root z n hz hne, hz] at hweighted
  have hmul : (1 - z) * (∑ k ∈ range n, (k : ℂ) * z ^ k) = -(n : ℂ) := by
    calc
      _ = 0 - 1 - ((n : ℂ) - 1) * 1 := hweighted
      _ = -(n : ℂ) := by ring
  calc
    (∑ k ∈ range n, (k : ℂ) * z ^ k) =
        ((1 - z) * (∑ k ∈ range n, (k : ℂ) * z ^ k)) / (1 - z) := by
          field_simp [hden]
    _ = -(n : ℂ) / (1 - z) := by rw [hmul]

private theorem sum_fin_eq_range {R : Type*} [AddCommMonoid R] {n : ℕ} (f : ℕ → R) :
    (∑ k : Fin n, f k.val) = ∑ k ∈ range n, f k := by
  simpa using Fin.sum_univ_eq_sum_range f n

private theorem sum_range_id_real (n : ℕ) :
    (∑ k ∈ range n, (k : ℝ)) = (n : ℝ) * ((n : ℝ) - 1) / 2 := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Finset.sum_range_succ, ih]
      push_cast
      ring

private theorem sum_range_sq_real (n : ℕ) :
    (∑ k ∈ range n, (k : ℝ) ^ 2) =
      ((n : ℝ) - 1) * (n : ℝ) * (2 * (n : ℝ) - 1) / 6 := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Finset.sum_range_succ, ih]
      push_cast
      ring

private theorem sum_fin_val_real (n : ℕ) :
    (∑ k : Fin n, (k.val : ℝ)) = (n : ℝ) * ((n : ℝ) - 1) / 2 := by
  rw [sum_fin_eq_range]
  exact sum_range_id_real n

private theorem sum_fin_val_sq_real (n : ℕ) :
    (∑ k : Fin n, (k.val : ℝ) ^ 2) =
      ((n : ℝ) - 1) * (n : ℝ) * (2 * (n : ℝ) - 1) / 6 := by
  calc
    _ = ∑ k ∈ range n, (k : ℝ) ^ 2 := sum_fin_eq_range (fun k : ℕ => (k : ℝ) ^ 2)
    _ = _ := sum_range_sq_real n

private theorem sum_periodic_remainder_real {P q : ℕ} (hdiv : q ∣ P)
    [NeZero q] [NeZero (P / q)] :
    (∑ k : Fin P, ((k.val % q : ℕ) : ℝ)) =
      (P / q : ℝ) * ∑ r : Fin q, (r.val : ℝ) := by
  have hcast : ((P / q : ℕ) : ℝ) = (P : ℝ) / (q : ℝ) :=
    Nat.cast_div hdiv (by exact_mod_cast (NeZero.ne q))
  rw [sum_finPeriodEquiv hdiv]
  calc
    _ = ∑ r : Fin q, ∑ t : Fin (P / q), (r.val : ℝ) := by
      apply sum_congr rfl
      intro r hr
      apply sum_congr rfl
      intro t ht
      simp [finPeriodEquiv, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt r.isLt]
    _ = ∑ r : Fin q, (r.val : ℝ) * (P / q : ℝ) := by simp [mul_comm, hcast]
    _ = ∑ r : Fin q, (P / q : ℝ) * (r.val : ℝ) := by
      apply sum_congr rfl
      intro r hr
      ring
    _ = (P / q : ℝ) * ∑ r : Fin q, (r.val : ℝ) := by rw [Finset.mul_sum]

private theorem sum_periodic_remainder_sq_real {P q : ℕ} (hdiv : q ∣ P)
    [NeZero q] [NeZero (P / q)] :
    (∑ k : Fin P, ((k.val % q : ℕ) : ℝ) ^ 2) =
      (P / q : ℝ) * ∑ r : Fin q, (r.val : ℝ) ^ 2 := by
  have hcast : ((P / q : ℕ) : ℝ) = (P : ℝ) / (q : ℝ) :=
    Nat.cast_div hdiv (by exact_mod_cast (NeZero.ne q))
  rw [sum_finPeriodEquiv hdiv]
  calc
    _ = ∑ r : Fin q, ∑ t : Fin (P / q), (r.val : ℝ) ^ 2 := by
      apply sum_congr rfl
      intro r hr
      apply sum_congr rfl
      intro t ht
      simp [finPeriodEquiv, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt r.isLt]
    _ = ∑ r : Fin q, (r.val : ℝ) ^ 2 * (P / q : ℝ) := by simp [mul_comm, hcast]
    _ = ∑ r : Fin q, (P / q : ℝ) * (r.val : ℝ) ^ 2 := by
      apply sum_congr rfl
      intro r hr
      ring
    _ = (P / q : ℝ) * ∑ r : Fin q, (r.val : ℝ) ^ 2 := by rw [Finset.mul_sum]

private def realShellSequence (q : ℕ) (k : Fin P) : ℝ :=
  ((k.val % q : ℕ) : ℝ) / (q : ℝ)

private theorem sum_realShellSequence {P q : ℕ} [NeZero P] (hdiv : q ∣ P)
    [NeZero q] [NeZero (P / q)] :
    (∑ k : Fin P, realShellSequence q k) =
      (P : ℝ) * ((q : ℝ) - 1) / 2 / (q : ℝ) := by
  have hq : (q : ℝ) ≠ 0 := by exact_mod_cast (NeZero.ne q)
  calc
    _ = (q : ℝ)⁻¹ * ∑ k : Fin P, ((k.val % q : ℕ) : ℝ) := by
      unfold realShellSequence
      calc
        _ = ∑ k : Fin P, (q : ℝ)⁻¹ * ((k.val % q : ℕ) : ℝ) := by
          apply sum_congr rfl
          intro k hk
          simp [div_eq_mul_inv, mul_comm]
        _ = _ := (Finset.mul_sum Finset.univ _ _).symm
    _ = (q : ℝ)⁻¹ * ((P / q : ℝ) * ((q : ℝ) * ((q : ℝ) - 1) / 2)) := by
      rw [sum_periodic_remainder_real hdiv, sum_fin_val_real]
    _ = (P : ℝ) * ((q : ℝ) - 1) / 2 / (q : ℝ) := by
      field_simp [hq]

private theorem sum_realShellSequence_sq {P q : ℕ} [NeZero P] (hdiv : q ∣ P)
    [NeZero q] [NeZero (P / q)] :
    (∑ k : Fin P, (realShellSequence q k) ^ 2) =
      (P / q : ℝ) * (((q : ℝ) - 1) * (2 * (q : ℝ) - 1)) /
        (6 * (q : ℝ)) := by
  have hq : (q : ℝ) ≠ 0 := by exact_mod_cast (NeZero.ne q)
  calc
    _ = (q : ℝ)⁻¹ ^ 2 *
        ∑ k : Fin P, ((k.val % q : ℕ) : ℝ) ^ 2 := by
      calc
        _ = ∑ k : Fin P,
            (q : ℝ)⁻¹ ^ 2 * ((k.val % q : ℕ) : ℝ) ^ 2 := by
          apply sum_congr rfl
          intro k hk
          unfold realShellSequence
          simp [div_eq_mul_inv, mul_pow]
          ring
        _ = _ := (Finset.mul_sum Finset.univ _ _).symm
    _ = (q : ℝ)⁻¹ ^ 2 *
        ((P / q : ℝ) * (((q : ℝ) - 1) * (q : ℝ) *
          (2 * (q : ℝ) - 1) / 6)) := by
      rw [sum_periodic_remainder_sq_real hdiv, sum_fin_val_sq_real]
    _ = (P / q : ℝ) * (((q : ℝ) - 1) * (2 * (q : ℝ) - 1)) /
        (6 * (q : ℝ)) := by
      field_simp [hq]

private theorem sum_sub_sq_fin {P : ℕ} (x : Fin P → ℝ) (m : ℝ) :
    (∑ k : Fin P, (x k - m) ^ 2) =
      (∑ k : Fin P, (x k) ^ 2) - 2 * m * (∑ k : Fin P, x k) +
        (P : ℝ) * m ^ 2 := by
  calc
    _ = ∑ k : Fin P, ((x k) ^ 2 - (2 * m * x k) + m ^ 2) := by
      apply sum_congr rfl
      intro k hk
      ring
    _ = (∑ k : Fin P, (x k) ^ 2) -
        (∑ k : Fin P, 2 * m * x k) +
        (∑ k : Fin P, m ^ 2) := by
      rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
    _ = _ := by
      have hscalar : (∑ k : Fin P, 2 * m * x k) =
          2 * m * ∑ k : Fin P, x k := by
        rw [Finset.mul_sum]
      rw [hscalar]
      simp [Finset.sum_const, Fintype.card_fin, nsmul_eq_mul]

private def realShellMean (P q : ℕ) [NeZero P] : ℝ :=
  (P : ℝ)⁻¹ * ∑ k : Fin P, realShellSequence q k

private theorem realShellMean_eq {P q : ℕ} [NeZero P] (hdiv : q ∣ P)
    [NeZero q] [NeZero (P / q)] :
    realShellMean P q = ((q : ℝ) - 1) / (2 * (q : ℝ)) := by
  have hP : (P : ℝ) ≠ 0 := by exact_mod_cast (NeZero.ne P)
  have hq : (q : ℝ) ≠ 0 := by exact_mod_cast (NeZero.ne q)
  unfold realShellMean
  rw [sum_realShellSequence hdiv]
  field_simp [hP, hq]

private theorem realShellVariance_eq {P q : ℕ} [NeZero P] (hdiv : q ∣ P)
    [NeZero q] [NeZero (P / q)] :
    (P : ℝ)⁻¹ * ∑ k : Fin P,
        (realShellSequence q k - realShellMean P q) ^ 2 =
      ((q : ℝ) ^ 2 - 1) / (12 * (q : ℝ) ^ 2) := by
  have hP : (P : ℝ) ≠ 0 := by exact_mod_cast (NeZero.ne P)
  have hq : (q : ℝ) ≠ 0 := by exact_mod_cast (NeZero.ne q)
  rw [realShellMean_eq hdiv]
  rw [sum_sub_sq_fin]
  rw [sum_realShellSequence_sq hdiv, sum_realShellSequence hdiv]
  field_simp [hP, hq]
  ring

private def oneShellCoefficients (q : ℕ) : ℕ → ℂ := fun j => if j = q then 1 else 0

private theorem shellSection_oneShell {P q : ℕ} [NeZero P] (hq : 2 ≤ q)
    (k : Fin P) :
    shellSection P q (oneShellCoefficients q) k = shellSequence q k := by
  unfold shellSection oneShellCoefficients
  rw [Finset.sum_eq_single q]
  · simp [mem_Icc.mpr ⟨hq, le_rfl⟩]
  · intro j hj hjne
    simp [hjne]
  · intro hnot
    exact False.elim (hnot (mem_Icc.mpr ⟨hq, le_rfl⟩))

private theorem shellSequence_eq_ofReal_realShell {P q : ℕ} (k : Fin P) :
    shellSequence q k = (realShellSequence q k : ℂ) := by
  simp [shellSequence, realShellSequence, Complex.ofReal_div]

private theorem cyclicDft_shell_of_ne_zero {P j : ℕ} (hdiv : j ∣ P)
    [NeZero P] [NeZero j] [NeZero (P / j)] (h : ZMod P) (hh : h ≠ 0) :
    cyclicDft P (shellSequence j) h =
      if addOrderOf h ∣ j then
        -((P / j : ℕ) : ℂ) / (1 - ZMod.stdAddChar (-h)) else 0 := by
  let z : ℂ := ZMod.stdAddChar (-h)
  have hzne : z ≠ 1 := by
    intro hz
    have hchar : ZMod.stdAddChar (-h) = ZMod.stdAddChar (0 : ZMod P) := by simpa [z] using hz
    have hneg : -h = 0 := ZMod.injective_stdAddChar hchar
    exact hh (neg_eq_zero.mp hneg)
  rw [cyclicDft_shell_factor hdiv h]
  by_cases hd : addOrderOf h ∣ j
  · have hzj : z ^ j = 1 := by
      exact (stdChar_pow_eq_one_iff h j).2 hd
    have hinner :
        (∑ r : Fin j, ((r.val : ℂ) / (j : ℂ)) * z ^ r.val) = -1 / (1 - z) := by
      calc
        _ = (j : ℂ)⁻¹ * (∑ r : Fin j, (r.val : ℂ) * z ^ r.val) := by
          rw [Finset.mul_sum]
          apply sum_congr rfl
          intro r _
          field_simp
        _ = (j : ℂ)⁻¹ * (-(j : ℂ) / (1 - z)) := by
          have hsum := sum_fin_eq_range (fun k : ℕ => (k : ℂ) * z ^ k) (n := j)
          rw [hsum, weighted_geom_root z j hzj hzne]
        _ = -1 / (1 - z) := by
          have hj : (j : ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne j)
          field_simp [hj]
    have hjC : (j : ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne j)
    have hdivC : ((P / j : ℕ) : ℂ) = (P : ℂ) / (j : ℂ) := by
      have hmul : (j : ℂ) * ((P / j : ℕ) : ℂ) = (P : ℂ) := by
        exact_mod_cast (Nat.mul_div_cancel' hdiv)
      calc
        ((P / j : ℕ) : ℂ) =
            ((j : ℂ) * ((P / j : ℕ) : ℂ)) / (j : ℂ) := by field_simp [hjC]
        _ = (P : ℂ) / (j : ℂ) := by rw [hmul]
    have houter :
        (∑ t : Fin (P / j), (z ^ j) ^ t.val) = (P / j : ℂ) := by
      simp [hzj, ← hdivC]
    simp only [if_pos hd, z]
    rw [hinner, houter, hdivC]
    ring
  · have hzj : z ^ j ≠ 1 := by
      intro hz
      exact hd ((stdChar_pow_eq_one_iff h j).1 (by simpa [z] using hz))
    have horderP : addOrderOf h ∣ P := by
      simpa using (addOrderOf_dvd_card (x := h))
    have hzP : z ^ P = 1 := (stdChar_pow_eq_one_iff h P).2 horderP
    have hfac : j * (P / j) = P := Nat.mul_div_cancel' hdiv
    have hzperiod : (z ^ j) ^ (P / j) = 1 := by
      rw [← pow_mul, hfac]
      exact hzP
    have houter :
        (∑ t : Fin (P / j), (z ^ j) ^ t.val) = 0 := by
      rw [sum_fin_eq_range]
      exact geom_sum_zero_of_root (z ^ j) (P / j) hzperiod hzj
    simp only [if_neg hd, z]
    rw [houter]
    simp

/-- Each nonzero Fourier coefficient depends only on its reduced denominator. -/
theorem cyclicDft_shellSection_factor {P N : ℕ} [NeZero P] (a : ℕ → ℂ)
    (hperiod : ∀ j ∈ Icc 2 N, a j ≠ 0 → j ∣ P) (h : ZMod P) (hh : h ≠ 0) :
    cyclicDft P (shellSection P N a) h =
      - (P : ℂ) * divisorCoordinate N a (addOrderOf h) /
        (1 - ZMod.stdAddChar (-h)) := by
  classical
  let q := addOrderOf h
  have hP : 0 < P := NeZero.pos P
  unfold cyclicDft shellSection divisorCoordinate
  simp only [Finset.sum_mul]
  rw [Finset.sum_comm]
  have hterm (j : ℕ) (hj : j ∈ Icc 2 N) :
      (∑ k : Fin P, a j * shellSequence j k *
          ZMod.stdAddChar (-(h * (k.val : ZMod P)))) =
        if q ∣ j then
          a j * (-(P / j : ℕ) : ℂ) /
            (1 - ZMod.stdAddChar (-h)) else 0 := by
    by_cases hazero : a j = 0
    · simp [hazero]
    · have hdiv : j ∣ P := hperiod j hj hazero
      have hjpos : 0 < j := by have := (mem_Icc.mp hj).1; omega
      have hle : j ≤ P := Nat.le_of_dvd hP hdiv
      letI : NeZero j := ⟨by omega⟩
      letI : NeZero (P / j) := ⟨Nat.ne_of_gt (Nat.div_pos hle (NeZero.pos j))⟩
      rw [show (∑ k : Fin P, a j * shellSequence j k *
          ZMod.stdAddChar (-(h * (k.val : ZMod P)))) =
          a j * cyclicDft P (shellSequence j) h by
            simp [cyclicDft, mul_assoc, Finset.mul_sum]]
      rw [cyclicDft_shell_of_ne_zero hdiv h hh]
      by_cases hqj : q ∣ j
      · simp only [if_pos hqj]
        have hcast : ((P / j : ℕ) : ℂ) = (P : ℂ) / (j : ℂ) := by
          have hjC : (j : ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne j)
          have hmul : (j : ℂ) * ((P / j : ℕ) : ℂ) = (P : ℂ) := by
            exact_mod_cast (Nat.mul_div_cancel' hdiv)
          have hmul' : ((P / j : ℕ) : ℂ) * (j : ℂ) = (P : ℂ) := by
            rw [mul_comm]
            exact hmul
          field_simp [hjC]
          rw [hmul']
        have hqj' : addOrderOf h ∣ j := by simpa [q] using hqj
        simp only [q, if_pos hqj']
        rw [hcast]
        ring
      · have hqj' : ¬ addOrderOf h ∣ j := by simpa [q] using hqj
        simp only [q, if_neg hqj']
        simp
  calc
    _ = ∑ j ∈ Icc 2 N, if q ∣ j then
          a j * (-(P / j : ℕ) : ℂ) / (1 - ZMod.stdAddChar (-h)) else 0 := by
          apply sum_congr rfl
          intro j hj
          exact hterm j hj
    _ = - (P : ℂ) * divisorCoordinate N a q /
          (1 - ZMod.stdAddChar (-h)) := by
          simp only [divisorCoordinate]
          rw [div_eq_mul_inv, Finset.mul_sum, Finset.sum_mul]
          apply sum_congr rfl
          intro j hj
          by_cases hqj : q ∣ j
          · by_cases hazero : a j = 0
            · simp [hqj, hazero]
            · simp only [if_pos hqj]
              have hjpos : 0 < j := by have := (mem_Icc.mp hj).1; omega
              have hdiv : j ∣ P := hperiod j hj hazero
              have hjC : (j : ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hjpos)
              have hmul : (j : ℂ) * ((P / j : ℕ) : ℂ) = (P : ℂ) := by
                exact_mod_cast (Nat.mul_div_cancel' hdiv)
              have hcast : ((P / j : ℕ) : ℂ) = (P : ℂ) / (j : ℂ) := by
                have hmul' : ((P / j : ℕ) : ℂ) * (j : ℂ) = (P : ℂ) := by
                  rw [mul_comm]
                  exact hmul
                field_simp [hjC]
                exact hmul'
              rw [hcast]
              ring
          · simp [hqj]

/-- The mean of a finite periodic shell section over one period. -/
def shellMean (P N : ℕ) [NeZero P] (a : ℕ → ℂ) : ℂ :=
  (P : ℂ)⁻¹ * ∑ k : Fin P, shellSection P N a k

/-- Centering removes the constant Fourier mode. -/
def centeredShellSection (P N : ℕ) [NeZero P] (a : ℕ → ℂ) (k : Fin P) : ℂ :=
  shellSection P N a k - shellMean P N a

private theorem stdChar_sum_fin_eq_zero {P : ℕ} [NeZero P] (h : ZMod P) (hh : h ≠ 0) :
    (∑ k : Fin P, ZMod.stdAddChar (-(h * (k.val : ZMod P)))) = 0 := by
  let z : ℂ := ZMod.stdAddChar (-h)
  have hne : z ≠ 1 := by
    intro hz
    have hchar : ZMod.stdAddChar (-h) = ZMod.stdAddChar (0 : ZMod P) := by
      simpa [z] using hz
    have hneg : -h = 0 := ZMod.injective_stdAddChar hchar
    exact hh (neg_eq_zero.mp hneg)
  have horder : addOrderOf h ∣ P := by
    simpa using (addOrderOf_dvd_card (x := h))
  have hzP : z ^ P = 1 := by
    exact (stdChar_pow_eq_one_iff h P).2 horder
  rw [show (∑ k : Fin P, ZMod.stdAddChar (-(h * (k.val : ZMod P)))) =
      ∑ k : Fin P, z ^ k.val by
        apply sum_congr rfl
        intro k hk
        simpa [z] using stdChar_fin_mul P h k]
  rw [sum_fin_eq_range]
  exact geom_sum_zero_of_root z P hzP hne

private theorem stdChar_sum_zmod {P : ℕ} [NeZero P] (t : ZMod P) :
    (∑ h : ZMod P, ZMod.stdAddChar (t * h)) =
      if t = 0 then (P : ℂ) else 0 := by
  classical
  by_cases ht : t = 0
  · simp [ht]
  · let ψ : AddChar (ZMod P) ℂ :=
      ZMod.stdAddChar.compAddMonoidHom (AddMonoidHom.mulLeft t)
    have hψ : ψ ≠ 1 := by
      intro h
      have hval := congrArg (fun χ : AddChar (ZMod P) ℂ => χ 1) h
      have hchar : ZMod.stdAddChar t = ZMod.stdAddChar (0 : ZMod P) := by
        simpa [ψ, AddMonoidHom.mulLeft] using hval
      exact ht (ZMod.injective_stdAddChar hchar)
    simpa [ψ, ht] using AddChar.sum_eq_zero_of_ne_one hψ

private theorem stdChar_star {P : ℕ} [NeZero P] (h : ZMod P) (k : Fin P) :
    star (ZMod.stdAddChar (-(h * (k.val : ZMod P)))) =
      ZMod.stdAddChar (h * (k.val : ZMod P)) := by
  rw [show -(h * (k.val : ZMod P)) = -(h * (k.val : ZMod P)) by rfl]
  rw [AddChar.map_neg_eq_conj ZMod.stdAddChar (h * (k.val : ZMod P))]
  simp

private theorem stdChar_normSq_one {P : ℕ} [NeZero P] (h : ZMod P) :
    Complex.normSq (ZMod.stdAddChar h) = 1 := by
  rw [Complex.normSq_eq_norm_sq, ZMod.stdAddChar_apply, Circle.norm_coe]
  norm_num

private theorem stdChar_re_bounds {P : ℕ} [NeZero P] (h : ZMod P) :
    -1 ≤ (ZMod.stdAddChar h).re ∧ (ZMod.stdAddChar h).re ≤ 1 := by
  have hnorm : ‖ZMod.stdAddChar h‖ = 1 := by
    have hsq := Complex.sq_norm (ZMod.stdAddChar h)
    rw [stdChar_normSq_one] at hsq
    have hnonneg : 0 ≤ ‖ZMod.stdAddChar h‖ := norm_nonneg _
    nlinarith
  have habs := Complex.abs_re_le_norm (ZMod.stdAddChar h)
  rw [hnorm] at habs
  exact abs_le.mp habs

private theorem fin_val_cast_eq_iff {P : ℕ} [NeZero P] (k l : Fin P) :
    (k.val : ZMod P) = l.val ↔ k = l := by
  constructor
  · intro h
    apply Fin.ext
    have hv := congrArg ZMod.val h
    simpa [ZMod.val_natCast_of_lt k.isLt, ZMod.val_natCast_of_lt l.isLt] using hv
  · intro h
    cases h
    rfl

/-- Fourier inversion for the normalized cyclic transform used in this file. -/
theorem normalizedDft_inverse {P : ℕ} [NeZero P] (f : Fin P → ℂ) (k : Fin P) :
    f k = ∑ h : ZMod P,
      normalizedDft P f h * ZMod.stdAddChar (h * (k.val : ZMod P)) := by
  classical
  have hsum :
      (∑ h : ZMod P,
        (∑ l : Fin P, f l * ZMod.stdAddChar (-(h * (l.val : ZMod P)))) *
          ZMod.stdAddChar (h * (k.val : ZMod P))) =
        (P : ℂ) * f k := by
    calc
      _ = ∑ h : ZMod P, ∑ l : Fin P,
          f l * ZMod.stdAddChar
            (h * ((k.val : ZMod P) - (l.val : ZMod P))) := by
              apply sum_congr rfl
              intro h hh
              rw [Finset.sum_mul]
              apply sum_congr rfl
              intro l hl
              calc
                _ = f l * (ZMod.stdAddChar (-(h * (l.val : ZMod P))) *
                    ZMod.stdAddChar (h * (k.val : ZMod P))) := by ring
                _ = f l * ZMod.stdAddChar
                    (h * ((k.val : ZMod P) - (l.val : ZMod P))) := by
                      congr 2
                      rw [← AddChar.map_add_eq_mul]
                      congr 1
                      ring
      _ = ∑ l : Fin P, ∑ h : ZMod P,
          f l * ZMod.stdAddChar
            (h * ((k.val : ZMod P) - (l.val : ZMod P))) := by
              rw [Finset.sum_comm]
      _ = ∑ l : Fin P, f l *
          (if k = l then (P : ℂ) else 0) := by
              apply sum_congr rfl
              intro l hl
              have horth := stdChar_sum_zmod (P := P)
                ((k.val : ZMod P) - (l.val : ZMod P))
              have horth' :
                  (∑ h : ZMod P,
                    ZMod.stdAddChar (h *
                      ((k.val : ZMod P) - (l.val : ZMod P)))) =
                    if (k.val : ZMod P) = l.val then (P : ℂ) else 0 := by
                simpa [mul_comm, sub_eq_zero] using horth
              have horth'' :
                  (∑ h : ZMod P,
                    ZMod.stdAddChar (h *
                      ((k.val : ZMod P) - (l.val : ZMod P)))) =
                    if k = l then (P : ℂ) else 0 := by
                simpa [fin_val_cast_eq_iff] using horth'
              rw [← Finset.mul_sum, horth'']
      _ = (P : ℂ) * f k := by simp; ring
  unfold normalizedDft cyclicDft
  calc
    f k = (P : ℂ)⁻¹ * ((P : ℂ) * f k) := by
      have hP : (P : ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne P)
      field_simp [hP]
    _ = (P : ℂ)⁻¹ *
        (∑ h : ZMod P,
          (∑ l : Fin P, f l * ZMod.stdAddChar (-(h * (l.val : ZMod P)))) *
            ZMod.stdAddChar (h * (k.val : ZMod P))) := by rw [hsum]
    _ = ∑ h : ZMod P,
        ((P : ℂ)⁻¹ *
          (∑ l : Fin P, f l * ZMod.stdAddChar (-(h * (l.val : ZMod P))))) *
          ZMod.stdAddChar (h * (k.val : ZMod P)) := by
            rw [Finset.mul_sum]
            apply sum_congr rfl
            intro h hh
            ring

private theorem stdChar_pos_nat_mul (P : ℕ) [NeZero P] (h : ZMod P) (k : ℕ) :
    ZMod.stdAddChar (h * (k : ZMod P)) = (ZMod.stdAddChar h) ^ k := by
  have harg : h * (k : ZMod P) = k • h := by
    rw [nsmul_eq_mul]
    ring
  rw [harg]
  exact AddChar.map_nsmul_eq_pow _ _ _

private theorem stdChar_sum_fin_geom {P n : ℕ} [NeZero P] (h : ZMod P)
    (hh : h ≠ 0) :
    (∑ k : Fin n, ZMod.stdAddChar (h * (k.val : ZMod P))) =
      (1 - (ZMod.stdAddChar h) ^ n) / (1 - ZMod.stdAddChar h) := by
  let z := ZMod.stdAddChar h
  have hzne : z ≠ 1 := by
    intro hz
    have hchar : ZMod.stdAddChar h = ZMod.stdAddChar (0 : ZMod P) := by
      simpa [z] using hz
    exact hh (ZMod.injective_stdAddChar hchar)
  rw [show (∑ k : Fin n, ZMod.stdAddChar (h * (k.val : ZMod P))) =
      ∑ k : Fin n, z ^ k.val by
        apply sum_congr rfl
        intro k hk
        simpa [z] using stdChar_pos_nat_mul P h k.val]
  rw [sum_fin_eq_range]
  have hgeom := geom_sum_mul z n
  have hden : 1 - z ≠ 0 := sub_ne_zero.mpr hzne.symm
  apply (eq_div_iff hden).2
  calc
    (∑ x ∈ range n, z ^ x) * (1 - z) =
        (1 - z) * ∑ x ∈ range n, z ^ x := by ring
    _ = 1 - z ^ n := hgeom

/-- Finite Parseval identity for the unnormalized cyclic DFT. -/
private theorem cyclicDft_inner_product {P : ℕ} [NeZero P] (f : Fin P → ℂ) :
    (∑ h : ZMod P, star (cyclicDft P f h) * cyclicDft P f h) =
      (P : ℂ) * ∑ k : Fin P, star (f k) * f k := by
  classical
  have hpoint (h : ZMod P) :
      star (cyclicDft P f h) * cyclicDft P f h =
        ∑ k : Fin P, ∑ l : Fin P,
          star (f k) * f l * ZMod.stdAddChar
            (h * ((k.val : ZMod P) - (l.val : ZMod P))) := by
    calc
      _ = (∑ k : Fin P, star (f k) * ZMod.stdAddChar
            (h * (k.val : ZMod P))) *
          (∑ l : Fin P, f l * ZMod.stdAddChar
            (-(h * (l.val : ZMod P)))) := by
              simp [cyclicDft, map_sum, map_mul, stdChar_star, mul_comm]
      _ = ∑ k : Fin P, ∑ l : Fin P,
            star (f k) * f l * ZMod.stdAddChar
              (h * ((k.val : ZMod P) - (l.val : ZMod P))) := by
              rw [Finset.sum_mul]
              apply sum_congr rfl
              intro k hk
              rw [Finset.mul_sum]
              apply sum_congr rfl
              intro l hl
              calc
                _ = star (f k) * f l *
                    (ZMod.stdAddChar (h * (k.val : ZMod P)) *
                      ZMod.stdAddChar (-(h * (l.val : ZMod P)))) := by ring
                _ = star (f k) * f l * ZMod.stdAddChar
                    (h * ((k.val : ZMod P) - (l.val : ZMod P))) := by
                      congr 2
                      rw [← AddChar.map_add_eq_mul]
                      congr 1
                      ring
  calc
    _ = ∑ h : ZMod P, ∑ k : Fin P, ∑ l : Fin P,
        star (f k) * f l * ZMod.stdAddChar
          (h * ((k.val : ZMod P) - (l.val : ZMod P))) := by
          apply sum_congr rfl
          intro h hh
          exact hpoint h
    _ = ∑ k : Fin P, ∑ l : Fin P, ∑ h : ZMod P,
        star (f k) * f l * ZMod.stdAddChar
          (h * ((k.val : ZMod P) - (l.val : ZMod P))) := by
          rw [Finset.sum_comm]
          apply sum_congr rfl
          intro k hk
          rw [Finset.sum_comm]
    _ = ∑ k : Fin P, ∑ l : Fin P,
        star (f k) * f l * (if k = l then (P : ℂ) else 0) := by
          apply sum_congr rfl
          intro k hk
          apply sum_congr rfl
          intro l hl
          have horth := stdChar_sum_zmod (P := P)
            ((k.val : ZMod P) - (l.val : ZMod P))
          have horth' : (∑ i : ZMod P,
              ZMod.stdAddChar (i * ((k.val : ZMod P) - (l.val : ZMod P)))) =
                if (k.val : ZMod P) = l.val then (P : ℂ) else 0 := by
            simpa [mul_comm, sub_eq_zero] using horth
          have horth'' : (∑ i : ZMod P,
              ZMod.stdAddChar (i * ((k.val : ZMod P) - (l.val : ZMod P)))) =
                if k = l then (P : ℂ) else 0 := by
            simpa [fin_val_cast_eq_iff] using horth'
          rw [← Finset.mul_sum, horth'']
    _ = (P : ℂ) * ∑ k : Fin P, star (f k) * f k := by
          rw [Finset.mul_sum]
          apply sum_congr rfl
          intro k hk
          simp [mul_comm, mul_left_comm, mul_assoc]

private theorem complex_normSq_sum_eq_inner {α : Type*} (s : Finset α)
    (f : α → ℂ) :
    (↑(∑ i ∈ s, Complex.normSq (f i)) : ℂ) =
      ∑ i ∈ s, star (f i) * f i := by
  rw [Complex.ofReal_sum]
  apply sum_congr rfl
  intro i hi
  exact Complex.normSq_eq_conj_mul_self

/-- The unnormalized DFT preserves the finite energy up to the period factor. -/
private theorem cyclicDft_parseval_normSq {P : ℕ} [NeZero P] (f : Fin P → ℂ) :
    (∑ h : ZMod P, Complex.normSq (cyclicDft P f h)) =
      (P : ℝ) * ∑ k : Fin P, Complex.normSq (f k) := by
  apply Complex.ofReal_injective
  calc
    (↑(∑ h : ZMod P, Complex.normSq (cyclicDft P f h)) : ℂ) =
        ∑ h : ZMod P, star (cyclicDft P f h) * cyclicDft P f h :=
          complex_normSq_sum_eq_inner Finset.univ _
    _ = (P : ℂ) * ∑ k : Fin P, star (f k) * f k := cyclicDft_inner_product f
    _ = ↑((P : ℝ) * ∑ k : Fin P, Complex.normSq (f k)) := by
          rw [Complex.ofReal_mul, Complex.ofReal_natCast,
            ← complex_normSq_sum_eq_inner Finset.univ]

private theorem normSq_period_inverse {P : ℕ} [NeZero P] :
    Complex.normSq ((P : ℂ)⁻¹) = (P : ℝ)⁻¹ ^ 2 := by
  have hP : (P : ℝ) ≠ 0 := by exact_mod_cast (NeZero.ne P)
  rw [Complex.normSq_inv, ← Complex.ofReal_natCast P, Complex.normSq_ofReal]
  ring

/-- Parseval for normalized coefficients: mean-square equals Fourier energy. -/
theorem normalizedDft_parseval_normSq {P : ℕ} [NeZero P] (f : Fin P → ℂ) :
    (∑ h : ZMod P, Complex.normSq (normalizedDft P f h)) =
      (P : ℝ)⁻¹ * ∑ k : Fin P, Complex.normSq (f k) := by
  have hP : (P : ℝ) ≠ 0 := by exact_mod_cast (NeZero.ne P)
  calc
    _ = ∑ h : ZMod P,
        ((P : ℝ)⁻¹ ^ 2) * Complex.normSq (cyclicDft P f h) := by
          apply sum_congr rfl
          intro h hh
          rw [normalizedDft, Complex.normSq_mul, normSq_period_inverse]
    _ = ((P : ℝ)⁻¹ ^ 2) *
        ∑ h : ZMod P, Complex.normSq (cyclicDft P f h) := by
          rw [← Finset.mul_sum]
    _ = (P : ℝ)⁻¹ * ∑ k : Fin P, Complex.normSq (f k) := by
          rw [cyclicDft_parseval_normSq]
          field_simp [hP]

/-- The centered Cesàro energy, represented as a mean-square over one period. -/
def centeredCesaroEnergy (P N : ℕ) [NeZero P] (a : ℕ → ℂ) : ℝ :=
  (P : ℝ)⁻¹ * ∑ k : Fin P, Complex.normSq (centeredShellSection P N a k)

private theorem shellMean_oneShell {P q : ℕ} [NeZero P] (hdiv : q ∣ P)
    (hq : 2 ≤ q) [NeZero q] [NeZero (P / q)] :
    shellMean P q (oneShellCoefficients q) = (realShellMean P q : ℂ) := by
  unfold shellMean
  rw [Finset.sum_congr rfl (fun k hk => shellSection_oneShell hq k)]
  rw [show (∑ k : Fin P, shellSequence q k) =
    (∑ k : Fin P, (realShellSequence q k : ℂ)) by
      apply sum_congr rfl
      intro k hk
      rw [shellSequence_eq_ofReal_realShell]]
  have hsum : (∑ k : Fin P, (realShellSequence q k : ℂ)) =
      (∑ k : Fin P, realShellSequence q k : ℝ) := by
    simpa using (map_sum Complex.ofRealHom (fun k : Fin P => realShellSequence q k)
      Finset.univ).symm
  rw [hsum]
  simp [realShellMean, Complex.ofReal_mul, Complex.ofReal_inv, Complex.ofReal_natCast]

private theorem centeredShellSection_oneShell {P q : ℕ} [NeZero P]
    (hdiv : q ∣ P) (hq : 2 ≤ q) [NeZero q] [NeZero (P / q)] (k : Fin P) :
    centeredShellSection P q (oneShellCoefficients q) k =
      (realShellSequence q k - realShellMean P q : ℝ) := by
  rw [centeredShellSection, shellSection_oneShell hq k, shellSequence_eq_ofReal_realShell,
    shellMean_oneShell hdiv hq]
  simp [Complex.ofReal_sub]

private theorem centeredEnergy_oneShell {P q : ℕ} [NeZero P]
    (hdiv : q ∣ P) (hq : 2 ≤ q) [NeZero q] [NeZero (P / q)] :
    centeredCesaroEnergy P q (oneShellCoefficients q) =
      ((q : ℝ) ^ 2 - 1) / (12 * (q : ℝ) ^ 2) := by
  unfold centeredCesaroEnergy
  have hsum : (∑ k : Fin P,
      Complex.normSq (centeredShellSection P q (oneShellCoefficients q) k)) =
      ∑ k : Fin P, (realShellSequence q k - realShellMean P q) ^ 2 := by
    apply sum_congr rfl
    intro k hk
    rw [centeredShellSection_oneShell hdiv hq k]
    rw [Complex.normSq_ofReal]
    ring
  rw [hsum]
  exact realShellVariance_eq hdiv


/-- The same energy in normalized Fourier coordinates. -/
def centeredFourierEnergy (P N : ℕ) [NeZero P] (a : ℕ → ℂ) : ℝ :=
  ∑ h : ZMod P, Complex.normSq
    (normalizedDft P (centeredShellSection P N a) h)

/-- Weight of one additive-order class in the finite cyclic group. -/
def reducedDenominatorWeight (P q : ℕ) [NeZero P] : ℝ :=
  ∑ h ∈ (Finset.univ.filter fun h : ZMod P => h ≠ 0 ∧ addOrderOf h = q),
    Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹)

/-- The finite primitive-evaluation kernel on one reduced-denominator class.
The real part is `1 - cos(2π a K/q)`, and the reciprocal norm-square is the
corresponding `|1 - exp(2π i a/q)|⁻²` weight. -/
def reducedPrimitiveKernel (P q : ℕ) [NeZero P] (K : Fin P) : ℝ :=
  ∑ h ∈ (Finset.univ.filter fun h : ZMod P => h ≠ 0 ∧ addOrderOf h = q),
    (1 - (ZMod.stdAddChar (-(h * (K.val : ZMod P)))).re) *
      Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹)

/-- Squared dual norm of primitive evaluation at the integer endpoint `K`. -/
def primitiveEvaluationDualNormSq (P N : ℕ) [NeZero P] (K : Fin P) : ℝ :=
  ∑ q ∈ Icc 2 N,
    (reducedPrimitiveKernel P q K) ^ 2 / reducedDenominatorWeight P q

/-- Reduced-coordinate Cesàro energy for real coefficient coordinates. -/
def reducedCoordinateEnergy (P N : ℕ) [NeZero P] (B : ℕ → ℝ) : ℝ :=
  ∑ q ∈ Icc 2 N, reducedDenominatorWeight P q * (B q) ^ 2

/-- Integer primitive evaluation in the reduced-denominator coordinates. -/
def reducedPrimitiveEvaluation (P N : ℕ) [NeZero P] (B : ℕ → ℝ) (K : Fin P) : ℝ :=
  -∑ q ∈ Icc 2 N, B q * reducedPrimitiveKernel P q K

/-- The centered primitive at an integer endpoint, summed over the first `K`
unit shells of one common period. -/
def integerCenteredPrimitive (P N : ℕ) [NeZero P] (a : ℕ → ℂ) (K : Fin P) : ℂ :=
  ∑ k : Fin K.val,
    centeredShellSection P N a ⟨k.val, Nat.lt_trans k.isLt K.isLt⟩

/-- Affine interpolation of the primitive across one unit cell of a periodic
real shell sequence. -/
def finiteCellPrimitive (P : ℕ) (f : Fin P → ℝ) (K : Fin P) (θ : ℝ) : ℝ :=
  (∑ k : Fin K.val, f ⟨k.val, Nat.lt_trans k.isLt K.isLt⟩) + θ * f K

/-- On each unit cell, the absolute primitive value is bounded by the larger
absolute value at that cell's two integer endpoints. This is the finite
endpoint reduction for the piecewise-constant shell model. -/
theorem finiteCellPrimitive_abs_le_endpoints
    {P : ℕ} (f : Fin P → ℝ) (K : Fin P) (θ : ℝ)
    (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) :
    |finiteCellPrimitive P f K θ| ≤ max
      |∑ k : Fin K.val, f ⟨k.val, Nat.lt_trans k.isLt K.isLt⟩|
      |(∑ k : Fin K.val, f ⟨k.val, Nat.lt_trans k.isLt K.isLt⟩) + f K| := by
  let L := ∑ k : Fin K.val, f ⟨k.val, Nat.lt_trans k.isLt K.isLt⟩
  let R := L + f K
  have hL := abs_le.mp (le_max_left |L| |R|)
  have hR := abs_le.mp (le_max_right |L| |R|)
  have hθ1 : 0 ≤ 1 - θ := by linarith
  have hlow := add_le_add
    (mul_le_mul_of_nonneg_left hL.1 hθ1)
    (mul_le_mul_of_nonneg_left hR.1 hθ0)
  have hupp := add_le_add
    (mul_le_mul_of_nonneg_left hL.2 hθ1)
    (mul_le_mul_of_nonneg_left hR.2 hθ0)
  have hrewrite : L + θ * f K = (1 - θ) * L + θ * R := by
    dsimp [R]
    ring
  rw [show finiteCellPrimitive P f K θ = L + θ * f K by rfl, hrewrite]
  apply abs_le.mpr
  constructor <;> dsimp [R] at * <;> nlinarith

/-- The real-valued centered shell profile for a real coefficient family. -/
def realCenteredShellSection (P N : ℕ) [NeZero P]
    (a : ℕ → ℝ) (k : Fin P) : ℝ :=
  Complex.re (centeredShellSection P N (fun j => (a j : ℂ)) k)

/-- The integral of the real centered shell profile through `n` whole unit cells. -/
def realCenteredPrimitivePrefix (P N : ℕ) [NeZero P]
    (a : ℕ → ℝ) (n : ℕ) (hn : n ≤ P) : ℝ :=
  ∑ k : Fin n, realCenteredShellSection P N a
    ⟨k.val, Nat.lt_of_lt_of_le k.isLt hn⟩

private theorem centeredShellSection_period_sum_zero {P N : ℕ} [NeZero P]
    (a : ℕ → ℂ) :
    (∑ k : Fin P, centeredShellSection P N a k) = 0 := by
  classical
  unfold centeredShellSection shellMean
  rw [Finset.sum_sub_distrib]
  have hP : (P : ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne P)
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  field_simp [hP]
  ring

private theorem realCenteredShellSection_period_sum_zero {P N : ℕ} [NeZero P]
    (a : ℕ → ℝ) :
    (∑ k : Fin P, realCenteredShellSection P N a k) = 0 := by
  calc
    _ = Complex.re (∑ k : Fin P,
        centeredShellSection P N (fun j => (a j : ℂ)) k) := by
          rw [Complex.re_sum]
          rfl
    _ = 0 := by rw [centeredShellSection_period_sum_zero]; simp

private theorem realCenteredPrimitivePrefix_eq_integer
    {P N : ℕ} [NeZero P] (a : ℕ → ℝ) (K : Fin P) :
    realCenteredPrimitivePrefix P N a K.val (Nat.le_of_lt K.isLt) =
      Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K) := by
  unfold realCenteredPrimitivePrefix realCenteredShellSection integerCenteredPrimitive
  rw [Complex.re_sum]

private theorem realCenteredPrimitivePrefix_period_zero
    {P N : ℕ} [NeZero P] (a : ℕ → ℝ) :
    realCenteredPrimitivePrefix P N a P le_rfl = 0 := by
  simpa [realCenteredPrimitivePrefix, realCenteredShellSection] using
    realCenteredShellSection_period_sum_zero (P := P) (N := N) a

/-- The exact diagonal energy in reduced-denominator coordinates. The `Fin` index
is a finite encoding of `2 ≤ q ≤ N`; each class contains the `φ(q)` frequencies
of reduced denominator `q`. -/
def centeredDiagonalEnergy (P N : ℕ) [NeZero P] (a : ℕ → ℂ) : ℝ :=
  ∑ q ∈ (Finset.univ.filter fun q : Fin (P + 1) => q.val ∈ Icc 2 N),
    Complex.normSq (divisorCoordinate N a q.val) * reducedDenominatorWeight P q.val

theorem centeredCesaroEnergy_eq_fourierEnergy {P N : ℕ} [NeZero P]
    (a : ℕ → ℂ) :
    centeredCesaroEnergy P N a = centeredFourierEnergy P N a := by
  exact (normalizedDft_parseval_normSq (centeredShellSection P N a)).symm

theorem normalizedDft_centeredShell_zero {P N : ℕ} [NeZero P] (a : ℕ → ℂ) :
    normalizedDft P (centeredShellSection P N a) 0 = 0 := by
  unfold normalizedDft cyclicDft centeredShellSection shellMean
  have hP : (P : ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne P)
  simp only [zero_mul, neg_zero, AddChar.map_zero_eq_one]
  simp only [mul_one]
  rw [Finset.sum_sub_distrib]
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin]
  simp only [nsmul_eq_mul]
  rw [← mul_assoc, mul_inv_cancel₀ hP, one_mul]
  ring

theorem cyclicDft_centered_eq_shell {P N : ℕ} [NeZero P] (a : ℕ → ℂ)
    (h : ZMod P) (hh : h ≠ 0) :
    cyclicDft P (centeredShellSection P N a) h = cyclicDft P (shellSection P N a) h := by
  unfold cyclicDft centeredShellSection shellMean
  calc
    _ = (∑ k : Fin P, shellSection P N a k *
        ZMod.stdAddChar (-(h * (k.val : ZMod P)))) -
        (∑ k : Fin P, (P : ℂ)⁻¹ *
          (∑ k : Fin P, shellSection P N a k) *
            ZMod.stdAddChar (-(h * (k.val : ZMod P)))) := by
          rw [← Finset.sum_sub_distrib]
          apply sum_congr rfl
          intro k hk
          ring
    _ = cyclicDft P (shellSection P N a) h := by
          rw [← Finset.mul_sum, stdChar_sum_fin_eq_zero h hh]
          simp [cyclicDft]

/-- The normalized centered coefficient has the reduced-denominator factorization. -/
theorem normalizedDft_centeredShell_factor {P N : ℕ} [NeZero P] (a : ℕ → ℂ)
    (hperiod : ∀ j ∈ Icc 2 N, a j ≠ 0 → j ∣ P) (h : ZMod P) (hh : h ≠ 0) :
    normalizedDft P (centeredShellSection P N a) h =
      - divisorCoordinate N a (addOrderOf h) /
        (1 - ZMod.stdAddChar (-h)) := by
  rw [normalizedDft, cyclicDft_centered_eq_shell a h hh,
    cyclicDft_shellSection_factor a hperiod h hh]
  have hP : (P : ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne P)
  have hden : 1 - ZMod.stdAddChar (-h) ≠ 0 := by
    intro hz
    have hz' : ZMod.stdAddChar (-h) = 1 := (sub_eq_zero.mp hz).symm
    have hchar : ZMod.stdAddChar (-h) = ZMod.stdAddChar (0 : ZMod P) := by
      simpa using hz'
    have hneg : -h = 0 := ZMod.injective_stdAddChar hchar
    exact hh (neg_eq_zero.mp hneg)
  field_simp [hP, hden]

private theorem addOrderOf_ge_two_of_ne_zero {P : ℕ} [NeZero P] (h : ZMod P)
    (hh : h ≠ 0) : 2 ≤ addOrderOf h := by
  have hpos := addOrderOf_pos h
  by_contra hlt
  have hle : addOrderOf h ≤ 1 := by omega
  have heq : addOrderOf h = 1 := by omega
  have hdata := (addOrderOf_eq_iff (x := h) (n := 1) (by omega)).mp heq
  exact hh (by simpa using hdata.1)

private theorem addOrderOf_le_period {P : ℕ} [NeZero P] (h : ZMod P) :
    addOrderOf h ≤ P := by
  have hdvd : addOrderOf h ∣ P := by
    simpa [ZMod.card] using (addOrderOf_dvd_card (x := h))
  exact Nat.le_of_dvd (NeZero.pos P) hdvd

private def denominatorIndex {P : ℕ} [NeZero P] (h : ZMod P) : Fin (P + 1) :=
  ⟨addOrderOf h, Nat.lt_succ_of_le (addOrderOf_le_period h)⟩

private theorem denominatorIndex_eq_iff {P : ℕ} [NeZero P]
    (h : ZMod P) (q : Fin (P + 1)) :
    denominatorIndex h = q ↔ addOrderOf h = q.val := by
  constructor
  · intro he
    exact congrArg Fin.val he
  · intro he
    apply Fin.ext
    exact he

private theorem divisorCoordinate_eq_zero_of_gt {N q : ℕ} (hq : N < q)
    (a : ℕ → ℂ) : divisorCoordinate N a q = 0 := by
  unfold divisorCoordinate
  apply sum_eq_zero
  intro j hj
  by_cases hdiv : q ∣ j
  · have hjpos : 0 < j := by have h := (mem_Icc.mp hj).1; omega
    have hle := Nat.le_of_dvd hjpos hdiv
    have hjle := (mem_Icc.mp hj).2
    simp [hdiv]
    omega
  · simp [hdiv]

private theorem reducedDenominatorWeight_eq_zero_of_lt_two {P q : ℕ} [NeZero P]
    (hq : q < 2) : reducedDenominatorWeight P q = 0 := by
  unfold reducedDenominatorWeight
  apply sum_eq_zero
  intro h hh
  have hcond := Finset.mem_filter.mp hh |>.2
  have hge := addOrderOf_ge_two_of_ne_zero h hcond.1
  omega

/-- Parseval turns the centered shell mean-square into an exact sum of
reduced-denominator diagonal blocks. -/
theorem centeredCesaroEnergy_eq_diagonal {P N : ℕ} [NeZero P] (a : ℕ → ℂ)
    (hN : 2 ≤ N) (hperiod : ∀ j ∈ Icc 2 N, a j ≠ 0 → j ∣ P) :
    centeredCesaroEnergy P N a = centeredDiagonalEnergy P N a := by
  classical
  let s : Finset (ZMod P) := Finset.univ.erase 0
  let weightTerm (h : ZMod P) : ℝ :=
    Complex.normSq (divisorCoordinate N a (addOrderOf h)) *
      Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹)
  have hpoint (h : ZMod P) (hh : h ∈ s) :
      Complex.normSq (normalizedDft P (centeredShellSection P N a) h) =
        weightTerm h := by
    have hne : h ≠ 0 := (Finset.mem_erase.mp hh).1
    rw [normalizedDft_centeredShell_factor a hperiod h hne]
    simp [weightTerm, div_eq_mul_inv, Complex.normSq_mul]
  have hremove : centeredFourierEnergy P N a =
      ∑ h ∈ s, Complex.normSq
        (normalizedDft P (centeredShellSection P N a) h) := by
    unfold centeredFourierEnergy s
    rw [← Finset.sum_erase_add Finset.univ
      (fun h : ZMod P => Complex.normSq
        (normalizedDft P (centeredShellSection P N a) h))
      (Finset.mem_univ 0)]
    simp [normalizedDft_centeredShell_zero]
  have hfiber :
      (∑ q : Fin (P + 1), ∑ h ∈ s with denominatorIndex h = q, weightTerm h) =
        ∑ h ∈ s, weightTerm h := by
    exact Finset.sum_fiberwise_of_maps_to
      (s := s) (t := Finset.univ) (g := denominatorIndex)
      (fun _ _ => Finset.mem_univ _) weightTerm
  have hclass (q : Fin (P + 1)) :
      (∑ h ∈ s with denominatorIndex h = q, weightTerm h) =
        Complex.normSq (divisorCoordinate N a q.val) *
          reducedDenominatorWeight P q.val := by
    calc
      _ = ∑ h ∈ s with denominatorIndex h = q,
          Complex.normSq (divisorCoordinate N a q.val) *
            Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹) := by
          apply sum_congr rfl
          intro h hh
          have horder := (denominatorIndex_eq_iff h q).mp
            (Finset.mem_filter.mp hh).2
          simp [weightTerm, horder]
      _ = Complex.normSq (divisorCoordinate N a q.val) *
          ∑ h ∈ s with denominatorIndex h = q,
            Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹) := by
          rw [← Finset.mul_sum]
      _ = Complex.normSq (divisorCoordinate N a q.val) *
          reducedDenominatorWeight P q.val := by
          congr 1
          have hsets : s.filter (fun h : ZMod P => denominatorIndex h = q) =
              Finset.univ.filter fun h : ZMod P =>
                h ≠ 0 ∧ addOrderOf h = q.val := by
            ext h
            simp [s, denominatorIndex_eq_iff]
          rw [hsets, reducedDenominatorWeight]
  have hsum : centeredCesaroEnergy P N a =
      ∑ q ∈ (Finset.univ.filter fun q : Fin (P + 1) => q.val ∈ Icc 2 N),
        Complex.normSq (divisorCoordinate N a q.val) *
          reducedDenominatorWeight P q.val := by
    rw [centeredCesaroEnergy_eq_fourierEnergy, hremove]
    calc
      (∑ h ∈ s, Complex.normSq
        (normalizedDft P (centeredShellSection P N a) h)) =
          ∑ h ∈ s, weightTerm h := by
            apply sum_congr rfl
            intro h hh
            exact hpoint h hh
      _ = ∑ q : Fin (P + 1),
          Complex.normSq (divisorCoordinate N a q.val) *
            reducedDenominatorWeight P q.val := by
              calc
                _ = ∑ q : Fin (P + 1),
                    ∑ h ∈ s with denominatorIndex h = q, weightTerm h := hfiber.symm
                _ = _ := by
                    apply sum_congr rfl
                    intro q hq
                    exact hclass q
      _ = ∑ q ∈ (Finset.univ.filter fun q : Fin (P + 1) => q.val ∈ Icc 2 N),
          Complex.normSq (divisorCoordinate N a q.val) *
            reducedDenominatorWeight P q.val := by
              symm
              apply Finset.sum_subset
                (Finset.filter_subset _ _)
              intro q hq hnot
              have hqout : q.val ∉ Icc 2 N := by
                intro hmem
                exact hnot (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hmem⟩)
              by_cases hlow : q.val < 2
              · rw [reducedDenominatorWeight_eq_zero_of_lt_two hlow]
                simp
              · have hhigh : N < q.val := by
                  have hqge : 2 ≤ q.val := Nat.not_lt.mp hlow
                  have hnotle : ¬ q.val ≤ N := by
                    intro hle
                    exact hqout (mem_Icc.mpr ⟨hqge, hle⟩)
                  omega
                rw [divisorCoordinate_eq_zero_of_gt hhigh]
                simp
  simpa [centeredDiagonalEnergy] using hsum

private theorem divisorCoordinate_oneShell {q d : ℕ} (hq : 2 ≤ q) :
    divisorCoordinate q (oneShellCoefficients q) d =
      if d ∣ q then (q : ℂ)⁻¹ else 0 := by
  unfold divisorCoordinate oneShellCoefficients
  rw [Finset.sum_eq_single q]
  · simp [mem_Icc.mpr ⟨hq, le_rfl⟩]
  · intro j hj hjne
    simp [hjne]
  · intro hnot
    exact False.elim (hnot (mem_Icc.mpr ⟨hq, le_rfl⟩))

private theorem sum_fin_filter_eq_Icc {P N : ℕ} (hNP : N ≤ P) (f : ℕ → ℝ) :
    (∑ i ∈ (Finset.univ.filter fun i : Fin (P + 1) => i.val ∈ Icc 2 N), f i.val) =
      ∑ d ∈ Icc 2 N, f d := by
  apply Finset.sum_bij (fun i _ => i.val)
  · intro i hi
    exact (Finset.mem_filter.mp hi).2
  · intro i hi j hj hij
    apply Fin.ext
    exact hij
  · intro d hd
    let i : Fin (P + 1) := ⟨d, by
      have hle : d ≤ N := (mem_Icc.mp hd).2
      omega⟩
    refine ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩, rfl⟩
    exact hd
  · intro i hi
    rfl

private theorem centeredDiagonalEnergy_oneShell_sum {P q : ℕ} [NeZero P]
    (hq : 2 ≤ q) (hdiv : q ∣ P) :
    centeredDiagonalEnergy P q (oneShellCoefficients q) =
      (q : ℝ)⁻¹ ^ 2 *
        ∑ d ∈ Icc 2 q, if d ∣ q then reducedDenominatorWeight P d else 0 := by
  have hqP : q ≤ P := Nat.le_of_dvd (NeZero.pos P) hdiv
  have hnormcoord (d : ℕ) :
      Complex.normSq (divisorCoordinate q (oneShellCoefficients q) d) =
        if d ∣ q then (q : ℝ)⁻¹ ^ 2 else 0 := by
    rw [divisorCoordinate_oneShell hq]
    by_cases hd : d ∣ q
    · simp [hd, normSq_period_inverse]
      ring
    · simp [hd]
  calc
    centeredDiagonalEnergy P q (oneShellCoefficients q) =
        ∑ d ∈ Icc 2 q,
          Complex.normSq (divisorCoordinate q (oneShellCoefficients q) d) *
            reducedDenominatorWeight P d := by
      simpa [centeredDiagonalEnergy] using
        (sum_fin_filter_eq_Icc hqP
          (fun d => Complex.normSq (divisorCoordinate q (oneShellCoefficients q) d) *
            reducedDenominatorWeight P d))
    _ = ∑ d ∈ Icc 2 q,
        (if d ∣ q then (q : ℝ)⁻¹ ^ 2 else 0) * reducedDenominatorWeight P d := by
      apply sum_congr rfl
      intro d hd
      rw [hnormcoord]
    _ = (q : ℝ)⁻¹ ^ 2 *
        ∑ d ∈ Icc 2 q, if d ∣ q then reducedDenominatorWeight P d else 0 := by
      rw [Finset.mul_sum]
      apply sum_congr rfl
      intro d hd
      by_cases hdivd : d ∣ q <;> simp [hdivd, mul_comm]

private theorem oneShell_period_hypothesis {P q : ℕ} (hq : 2 ≤ q) (hdiv : q ∣ P) :
    ∀ j ∈ Icc 2 q, oneShellCoefficients q j ≠ 0 → j ∣ P := by
  intro j hj hne
  by_cases hqj : j = q
  · simpa [oneShellCoefficients, hqj] using hdiv
  · simp [oneShellCoefficients, hqj] at hne

private theorem reducedDenominatorWeight_divisor_sum {P q : ℕ} [NeZero P]
    (hq : 2 ≤ q) (hdiv : q ∣ P) :
    (∑ d ∈ q.divisors, reducedDenominatorWeight P d) =
      ((q : ℝ) ^ 2 - 1) / 12 := by
  letI : NeZero q := ⟨by omega⟩
  letI : NeZero (P / q) := ⟨Nat.ne_of_gt
    (Nat.div_pos (Nat.le_of_dvd (NeZero.pos P) hdiv) (NeZero.pos q))⟩
  have hperiod := oneShell_period_hypothesis hq hdiv
  have hdiag := centeredCesaroEnergy_eq_diagonal (P := P) (N := q)
    (oneShellCoefficients q) hq hperiod
  rw [centeredEnergy_oneShell hdiv hq] at hdiag
  rw [centeredDiagonalEnergy_oneShell_sum hq hdiv] at hdiag
  have hIcc :
      (∑ d ∈ Icc 2 q, if d ∣ q then reducedDenominatorWeight P d else 0) =
        ∑ d ∈ q.divisors.erase 1, reducedDenominatorWeight P d := by
    have hsets : (Icc 2 q).filter (fun d => d ∣ q) = q.divisors.erase 1 := by
      ext d
      constructor
      · intro hd
        have h := Finset.mem_filter.mp hd
        have hdivd := h.2
        have hle := (mem_Icc.mp h.1).2
        have hlow := (mem_Icc.mp h.1).1
        have hpos : d ≠ 0 := by omega
        have hne1 : d ≠ 1 := by omega
        have hqne : q ≠ 0 := by omega
        exact Finset.mem_erase.mpr ⟨hne1, Nat.mem_divisors.mpr ⟨hdivd, hqne⟩⟩
      · intro hd
        have he := Finset.mem_erase.mp hd
        have hdivd := (Nat.mem_divisors.mp he.2).1
        have hqne := (Nat.mem_divisors.mp he.2).2
        have hle : d ≤ q := Nat.le_of_dvd (by omega) hdivd
        have hdn : d ≠ 0 := by
          intro hd0
          subst d
          simp at hdivd
          omega
        have hlow : 2 ≤ d := by omega
        exact Finset.mem_filter.mpr ⟨mem_Icc.mpr ⟨hlow, hle⟩, hdivd⟩
    calc
      _ = ∑ d ∈ (Icc 2 q).filter (fun d => d ∣ q),
          reducedDenominatorWeight P d := by
            rw [← Finset.sum_filter]
      _ = _ := by rw [hsets]
  have hWone : reducedDenominatorWeight P 1 = 0 :=
    reducedDenominatorWeight_eq_zero_of_lt_two (by omega)
  have hdivsum : (∑ d ∈ q.divisors, reducedDenominatorWeight P d) =
      ∑ d ∈ q.divisors.erase 1, reducedDenominatorWeight P d := by
    have hqne : q ≠ 0 := by omega
    have hmem : 1 ∈ q.divisors := Nat.mem_divisors.mpr ⟨one_dvd q, hqne⟩
    calc
      _ = (∑ d ∈ q.divisors.erase 1, reducedDenominatorWeight P d) +
            reducedDenominatorWeight P 1 :=
          (Finset.sum_erase_add q.divisors
            (fun d => reducedDenominatorWeight P d) (a := 1) hmem).symm
      _ = _ := by simp [hWone]
  have hscaled :
      ((q : ℝ) ^ 2 - 1) / (12 * (q : ℝ) ^ 2) =
        (q : ℝ)⁻¹ ^ 2 *
          (∑ d ∈ q.divisors.erase 1, reducedDenominatorWeight P d) := by
    rw [hIcc] at hdiag
    exact hdiag
  rw [hdivsum]
  have hqR : (q : ℝ) ≠ 0 := by exact_mod_cast (NeZero.ne q)
  field_simp [hqR] at hscaled
  nlinarith [hscaled]

private theorem reducedDenominatorWeight_divisor_sum_all {P q : ℕ} [NeZero P]
    (hq : 0 < q) (hdiv : q ∣ P) :
    (∑ d ∈ q.divisors, reducedDenominatorWeight P d) =
      ((q : ℝ) ^ 2 - 1) / 12 := by
  by_cases hq1 : q = 1
  · subst q
    have hWone : reducedDenominatorWeight P 1 = 0 :=
      reducedDenominatorWeight_eq_zero_of_lt_two (by omega)
    simp [hWone]
  · have hq2 : 2 ≤ q := by omega
    exact reducedDenominatorWeight_divisor_sum hq2 hdiv

def jordanTwo (q : ℕ) : ℝ :=
  ∑ d ∈ q.divisors, (ArithmeticFunction.moebius d : ℝ) *
    ((q / d : ℕ) : ℝ) ^ 2

private theorem sum_moebius_divisors_eq_zero {q : ℕ} (hq : 2 ≤ q) :
    (∑ d ∈ q.divisors, (ArithmeticFunction.moebius d : ℝ)) = 0 := by
  calc
    _ = (ArithmeticFunction.zeta * ArithmeticFunction.moebius : ArithmeticFunction ℝ) q :=
      (ArithmeticFunction.coe_zeta_mul_apply).symm
    _ = (1 : ArithmeticFunction ℝ) q := by
      exact congrArg (fun f : ArithmeticFunction ℝ => f q)
        ArithmeticFunction.coe_zeta_mul_coe_moebius
    _ = 0 := by simp [ArithmeticFunction.one_apply]; omega

private theorem quotient_dvd_period {P n : ℕ} (hn : n ∣ P) : P / n ∣ P := by
  exact ⟨n, (Nat.div_mul_cancel hn).symm⟩

/-- The divisor-poset coordinate agrees with the ordinary sum over shell
multiples whenever all active shell indices divide the common period. -/
private theorem divisorPosetCoordinate_eq_reducedShellCoordinate
    {P N q : ℕ} [NeZero P] (x : ℕ → ℝ) (hq : 2 ≤ q) (hqP : q ∣ P)
    (hperiod : ∀ j ∈ Icc 2 N, j ∣ P) :
    divisorPosetCoordinate P (shellPosetProfile P N x) q =
      reducedShellCoordinate N x q := by
  classical
  let ds := (P / q).divisors.filter (fun d => P / d ∈ Icc 2 N)
  let js := (Icc 2 N).filter (fun j => q ∣ j)
  have hPpos : 0 < P := NeZero.pos P
  have hqpos : 0 < q := by omega
  have hPqpos : 0 < P / q := Nat.div_pos (Nat.le_of_dvd hPpos hqP) hqpos
  have hleft :
      divisorPosetCoordinate P (shellPosetProfile P N x) q =
        ∑ d ∈ ds, x (P / d) := by
    unfold divisorPosetCoordinate shellPosetProfile
    simp only [ds]
    rw [← Finset.sum_filter]
  have hright : reducedShellCoordinate N x q = ∑ j ∈ js, x j := by
    unfold reducedShellCoordinate
    simp only [js]
    rw [← Finset.sum_filter]
  have hbij : (∑ d ∈ ds, x (P / d)) = ∑ j ∈ js, x j := by
    apply Finset.sum_bij (fun d _ => P / d)
    · intro d hd
      have hdd := (Finset.mem_filter.mp hd).1
      have hdPq : d ∣ P / q := (Nat.mem_divisors.mp hdd).1
      have hdP : d ∣ P := Nat.dvd_trans hdPq (quotient_dvd_period hqP)
      have hqprod : q * d ∣ P := by
        calc
          q * d ∣ q * (P / q) := Nat.mul_dvd_mul_left q hdPq
          _ = P := Nat.mul_div_cancel' hqP
      have hdqprod : d * q ∣ P := by simpa [Nat.mul_comm] using hqprod
      have hqj : q ∣ P / d := Nat.dvd_div_of_mul_dvd hdqprod
      exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hd).2, hqj⟩
    · intro d hd d' hd' heq
      have hdDiv := (Finset.mem_filter.mp hd).1
      have hd'Div := (Finset.mem_filter.mp hd').1
      have hdPq : d ∣ P / q := (Nat.mem_divisors.mp hdDiv).1
      have hd'Pq : d' ∣ P / q := (Nat.mem_divisors.mp hd'Div).1
      have hdP : d ∣ P := Nat.dvd_trans hdPq (quotient_dvd_period hqP)
      have hd'P : d' ∣ P := Nat.dvd_trans hd'Pq (quotient_dvd_period hqP)
      have hpos : 0 < P / d := by
        have hrange := (Finset.mem_filter.mp hd).2
        exact Nat.lt_of_lt_of_le (by omega) (mem_Icc.mp hrange).1
      apply Nat.eq_of_mul_eq_mul_right hpos
      calc
        d * (P / d) = P := Nat.mul_div_cancel' hdP
        _ = d' * (P / d') := (Nat.mul_div_cancel' hd'P).symm
        _ = d' * (P / d) := by rw [heq]
    · intro j hj
      have hjRange := (Finset.mem_filter.mp hj).1
      have hqj := (Finset.mem_filter.mp hj).2
      have hjP := hperiod j hjRange
      let d := P / j
      have hdpos : 0 < d := by
        dsimp [d]
        have hjpos : 0 < j := lt_of_lt_of_le (by omega) (mem_Icc.mp hjRange).1
        exact Nat.div_pos (Nat.le_of_dvd hPpos hjP) hjpos
      have hjd : j * d = P := by
        dsimp [d]
        exact Nat.mul_div_cancel' hjP
      have hqprod : q * d ∣ P := by
        calc
          q * d ∣ j * d := Nat.mul_dvd_mul_right hqj d
          _ = P := hjd
      have hdqprod : d * q ∣ P := by simpa [Nat.mul_comm] using hqprod
      have hdPq : d ∣ P / q := Nat.dvd_div_of_mul_dvd hqprod
      have hPdecomp : P = d * j := by simpa [Nat.mul_comm] using hjd.symm
      have hmap : P / d = j := by
        rw [hPdecomp, Nat.mul_div_right j hdpos]
      refine ⟨d, Finset.mem_filter.mpr ?_, hmap⟩
      refine ⟨Nat.mem_divisors.mpr ⟨hdPq, Nat.ne_of_gt hPqpos⟩, ?_⟩
      simpa [hmap] using hjRange
    · intro d hd
      rfl
  rw [hleft, hright]
  exact hbij

private theorem reducedShellCoordinate_eq_zero_of_gt {N q : ℕ}
    (hq : N < q) (x : ℕ → ℝ) : reducedShellCoordinate N x q = 0 := by
  unfold reducedShellCoordinate
  apply sum_eq_zero
  intro j hj
  by_cases hqj : q ∣ j
  · have hjpos : 0 < j := by have h := (mem_Icc.mp hj).1; omega
    have hqle : q ≤ j := Nat.le_of_dvd hjpos hqj
    have hjle : j ≤ N := (mem_Icc.mp hj).2
    have hfalse : False := by omega
    exact hfalse.elim
  · simp [hqj]

/-- Möbius inversion recovers each shell coefficient from the finite
reduced-denominator coordinates. Terms with `j * ℓ > N` vanish, leaving the
usual truncated formula `x_j = Σ_{ℓ≤N/j} μ(ℓ) B_{jℓ}`. -/
theorem reducedShellCoordinate_mobius_inversion
    {P N j : ℕ} [NeZero P] (x : ℕ → ℝ) (hj : j ∈ Icc 2 N)
    (hperiod : ∀ m ∈ Icc 2 N, m ∣ P) :
    x j = ∑ ℓ ∈ Icc 1 (N / j),
      (ArithmeticFunction.moebius ℓ : ℝ) * reducedShellCoordinate N x (j * ℓ) := by
  classical
  have hPpos : 0 < P := NeZero.pos P
  have hjpos : 0 < j := by have h := (mem_Icc.mp hj).1; omega
  have hjP : j ∣ P := hperiod j hj
  have hPjpos : 0 < P / j := Nat.div_pos (Nat.le_of_dvd hPpos hjP) hjpos
  have hPdivj : P / (P / j) = j := Nat.div_div_self hjP (NeZero.ne P)
  let y := shellPosetProfile P N x
  have hyj : y j = x j := by
    simp [y, shellPosetProfile, hj]
  have hinv := divisorPoset_mobius_inversion P j y hjP hjpos hPpos
  have hsumPoset :
      (∑ ℓ ∈ (P / j).divisors,
        (ArithmeticFunction.moebius ℓ : ℝ) *
          divisorPosetCoordinate P y (j * ℓ)) =
        ∑ ℓ ∈ (P / j).divisors,
          (ArithmeticFunction.moebius ℓ : ℝ) *
            reducedShellCoordinate N x (j * ℓ) := by
    apply sum_congr rfl
    intro ℓ hℓ
    have hℓdiv : ℓ ∣ P / j := (Nat.mem_divisors.mp hℓ).1
    have hqP : j * ℓ ∣ P := by
      calc
        j * ℓ ∣ j * (P / j) := Nat.mul_dvd_mul_left j hℓdiv
        _ = P := Nat.mul_div_cancel' hjP
    have hqge : 2 ≤ j * ℓ := by
      have hℓpos : 0 < ℓ := Nat.pos_of_dvd_of_pos hℓdiv hPjpos
      have hjge := (mem_Icc.mp hj).1
      calc
        2 ≤ j := hjge
        _ = j * 1 := by simp
        _ ≤ j * ℓ := Nat.mul_le_mul_left j (by omega)
    exact congrArg (fun z : ℝ => (ArithmeticFunction.moebius ℓ : ℝ) * z)
      (divisorPosetCoordinate_eq_reducedShellCoordinate x hqge hqP hperiod)
  have hfull : x j =
      ∑ ℓ ∈ (P / j).divisors,
        (ArithmeticFunction.moebius ℓ : ℝ) *
          reducedShellCoordinate N x (j * ℓ) := by
    calc
      x j = y j := hyj.symm
      _ = ∑ ℓ ∈ (P / j).divisors,
          (ArithmeticFunction.moebius ℓ : ℝ) *
            divisorPosetCoordinate P y (j * ℓ) := hinv
      _ = _ := hsumPoset
  let ds := (P / j).divisors.filter (fun ℓ => j * ℓ ∈ Icc 2 N)
  have hsumFilter :
      (∑ ℓ ∈ (P / j).divisors,
        (ArithmeticFunction.moebius ℓ : ℝ) *
          reducedShellCoordinate N x (j * ℓ)) =
        ∑ ℓ ∈ ds,
          (ArithmeticFunction.moebius ℓ : ℝ) *
            reducedShellCoordinate N x (j * ℓ) := by
    simp only [ds]
    calc
      _ = ∑ ℓ ∈ (P / j).divisors,
          if j * ℓ ∈ Icc 2 N then
            (ArithmeticFunction.moebius ℓ : ℝ) * reducedShellCoordinate N x (j * ℓ)
          else 0 := by
            apply sum_congr rfl
            intro ℓ hℓ
            by_cases hq : j * ℓ ∈ Icc 2 N
            · simp [hq]
            · have hℓdiv : ℓ ∣ P / j := (Nat.mem_divisors.mp hℓ).1
              have hℓpos : 0 < ℓ := Nat.pos_of_dvd_of_pos hℓdiv hPjpos
              have hqlo : 2 ≤ j * ℓ := by
                calc
                  2 ≤ j := (mem_Icc.mp hj).1
                  _ = j * 1 := by simp
                  _ ≤ j * ℓ := Nat.mul_le_mul_left j (by omega)
              have hqgt : N < j * ℓ := by
                by_contra hnot
                exact hq (mem_Icc.mpr ⟨hqlo, by omega⟩)
              rw [reducedShellCoordinate_eq_zero_of_gt hqgt]
              simp [hq]
      _ = ∑ ℓ ∈ (P / j).divisors.filter (fun ℓ => j * ℓ ∈ Icc 2 N),
          (ArithmeticFunction.moebius ℓ : ℝ) * reducedShellCoordinate N x (j * ℓ) := by
            rw [← Finset.sum_filter]
  have hds : ds = Icc 1 (N / j) := by
    apply Finset.ext
    intro ℓ
    constructor
    · intro hℓ
      have hℓdiv : ℓ ∣ P / j :=
        (Nat.mem_divisors.mp (Finset.mem_filter.mp hℓ).1).1
      have hℓpos : 0 < ℓ := Nat.pos_of_dvd_of_pos hℓdiv hPjpos
      have hqle : j * ℓ ≤ N := (mem_Icc.mp (Finset.mem_filter.mp hℓ).2).2
      have hdivbound : ℓ ≤ N / j := (Nat.le_div_iff_mul_le hjpos).2 (by simpa [Nat.mul_comm] using hqle)
      exact mem_Icc.mpr ⟨by omega, hdivbound⟩
    · intro hℓ
      have hℓpos : 0 < ℓ := by have h := (mem_Icc.mp hℓ).1; omega
      have hℓbound : ℓ ≤ N / j := (mem_Icc.mp hℓ).2
      have hqbound : j * ℓ ≤ N := by
        have hmul : ℓ * j ≤ N := (Nat.le_div_iff_mul_le hjpos).1 hℓbound
        simpa [Nat.mul_comm] using hmul
      have hqmem : j * ℓ ∈ Icc 2 N := by
        refine mem_Icc.mpr ⟨?_, hqbound⟩
        calc
          2 ≤ j := (mem_Icc.mp hj).1
          _ = j * 1 := by simp
          _ ≤ j * ℓ := Nat.mul_le_mul_left j (by omega)
      have hqP : j * ℓ ∣ P := hperiod (j * ℓ) hqmem
      have hℓPj : ℓ ∣ P / j := Nat.dvd_div_of_mul_dvd hqP
      exact Finset.mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨hℓPj, Nat.ne_of_gt hPjpos⟩, hqmem⟩
  calc
    x j = ∑ ℓ ∈ (P / j).divisors,
        (ArithmeticFunction.moebius ℓ : ℝ) *
          reducedShellCoordinate N x (j * ℓ) := hfull
    _ = ∑ ℓ ∈ ds,
        (ArithmeticFunction.moebius ℓ : ℝ) *
          reducedShellCoordinate N x (j * ℓ) := hsumFilter
    _ = ∑ ℓ ∈ Icc 1 (N / j),
        (ArithmeticFunction.moebius ℓ : ℝ) *
          reducedShellCoordinate N x (j * ℓ) := by rw [hds]

/-- Möbius inversion makes the reduced-denominator variables a free coordinate
system on the finite real shell-coefficient space. -/
theorem reducedCoordinateMap_bijective (N : ℕ) (hN : 2 ≤ N) :
    Function.Bijective (reducedCoordinateMap N) := by
  have hinj : Function.Injective (reducedCoordinateMap N) := by
    intro u v huv
    let P := N.factorial
    have hPpos : 0 < P := by
      dsimp [P]
      exact Nat.factorial_pos N
    letI : NeZero P := ⟨Nat.ne_of_gt hPpos⟩
    have hperiod : ∀ m ∈ Icc 2 N, m ∣ P := by
      intro m hm
      have hm' := mem_Icc.mp hm
      exact Nat.dvd_factorial (by omega) hm'.2
    let xu := shellCoefficientProfile N u
    let xv := shellCoefficientProfile N v
    have hB (q : ReducedCoordinateIndex N) :
        reducedShellCoordinate N xu q.val = reducedShellCoordinate N xv q.val := by
      rw [← reducedCoordinateMap_eq_shellCoordinate N u q,
        ← reducedCoordinateMap_eq_shellCoordinate N v q]
      exact congrFun huv q
    funext q
    have hq : q.val ∈ Icc 2 N := q.property
    have huInv := reducedShellCoordinate_mobius_inversion
      (P := P) (N := N) (j := q.val) xu hq hperiod
    have hvInv := reducedShellCoordinate_mobius_inversion
      (P := P) (N := N) (j := q.val) xv hq hperiod
    have hsum :
        (∑ ℓ ∈ Icc 1 (N / q.val),
          (ArithmeticFunction.moebius ℓ : ℝ) *
            reducedShellCoordinate N xu (q.val * ℓ)) =
        ∑ ℓ ∈ Icc 1 (N / q.val),
          (ArithmeticFunction.moebius ℓ : ℝ) *
            reducedShellCoordinate N xv (q.val * ℓ) := by
      apply sum_congr rfl
      intro ℓ hℓ
      have hℓpos : 0 < ℓ := by have h := (mem_Icc.mp hℓ).1; omega
      have hℓle : ℓ ≤ N / q.val := (mem_Icc.mp hℓ).2
      have hqpos : 0 < q.val := by have h := mem_Icc.mp hq; omega
      have hqℓle : q.val * ℓ ≤ N := by
        have hmul : ℓ * q.val ≤ N :=
          (Nat.le_div_iff_mul_le hqpos).1 hℓle
        simpa [Nat.mul_comm] using hmul
      have hqℓmem : q.val * ℓ ∈ Icc 2 N := by
        refine mem_Icc.mpr ⟨?_, hqℓle⟩
        calc
          2 ≤ q.val := (mem_Icc.mp hq).1
          _ = q.val * 1 := by simp
          _ ≤ q.val * ℓ := Nat.mul_le_mul_left q.val (by omega)
      have hcoords := hB ⟨q.val * ℓ, hqℓmem⟩
      exact congrArg (fun z : ℝ =>
        (ArithmeticFunction.moebius ℓ : ℝ) * z) hcoords
    have hvalue : xu q.val = xv q.val := by
      calc
        xu q.val = ∑ ℓ ∈ Icc 1 (N / q.val),
            (ArithmeticFunction.moebius ℓ : ℝ) *
              reducedShellCoordinate N xu (q.val * ℓ) := huInv
        _ = ∑ ℓ ∈ Icc 1 (N / q.val),
            (ArithmeticFunction.moebius ℓ : ℝ) *
              reducedShellCoordinate N xv (q.val * ℓ) := hsum
        _ = xv q.val := hvInv.symm
    simpa [xu, xv, shellCoefficientProfile, hq] using hvalue
  exact ⟨hinj, (LinearMap.injective_iff_surjective).mp hinj⟩

/-- Every reduced-coordinate vector is realized by actual shell coefficients:
the coefficient attached to normalized coordinate `x_j` is `a_j = j x_j`. -/
theorem shellCoefficientsFromNormalized_coordinates
    (N : ℕ) (x : ReducedCoordinateIndex N → ℝ) (q : ReducedCoordinateIndex N) :
    reducedShellCoordinate N
        (fun j => shellCoefficientsFromNormalized N x j / (j : ℝ)) q.val =
      reducedCoordinateMap N x q := by
  rw [reducedCoordinateMap_eq_shellCoordinate]
  unfold reducedShellCoordinate
  apply sum_congr rfl
  intro j hj
  by_cases hdiv : q.val ∣ j
  · have hjpos : 0 < j := by have h := mem_Icc.mp hj; omega
    have hjne : (j : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hjpos)
    simp [hdiv, shellCoefficientsFromNormalized, shellCoefficientProfile, hj]
    field_simp [hjne]
  · simp [hdiv]

/-- Every real vector of reduced-denominator coordinates is represented by an
actual finite shell coefficient family. -/
theorem reducedDenominatorCoordinates_realizable
    (N : ℕ) (hN : 2 ≤ N) (B : ReducedCoordinateIndex N → ℝ) :
    ∃ a : ℕ → ℝ, ∀ q : ReducedCoordinateIndex N,
      reducedShellCoordinate N (fun j => a j / (j : ℝ)) q.val = B q := by
  obtain ⟨x, hx⟩ := (reducedCoordinateMap_bijective N hN).2 B
  refine ⟨shellCoefficientsFromNormalized N x, ?_⟩
  intro q
  rw [shellCoefficientsFromNormalized_coordinates]
  exact congrFun hx q

private def weightPosetProfile (P : ℕ) [NeZero P] : ℕ → ℝ :=
  fun n => reducedDenominatorWeight P (P / n)

private theorem divisorPosetCoordinate_weight {P n : ℕ} [NeZero P]
    (hn : n ∣ P) (hnpos : 0 < n) :
    divisorPosetCoordinate P (weightPosetProfile P) n =
      (((P / n : ℕ) : ℝ) ^ 2 - 1) / 12 := by
  have hquotdiv : P / n ∣ P := quotient_dvd_period hn
  have hquotpos : 0 < P / n := Nat.div_pos (Nat.le_of_dvd (NeZero.pos P) hn) hnpos
  have hsum := reducedDenominatorWeight_divisor_sum_all hquotpos hquotdiv
  unfold divisorPosetCoordinate
  calc
    _ = ∑ d ∈ (P / n).divisors, reducedDenominatorWeight P d := by
      apply sum_congr rfl
      intro d hd
      have hdn : d ∣ P / n := (Nat.mem_divisors.mp hd).1
      have hdP : d ∣ P := Nat.dvd_trans hdn hquotdiv
      have hPpos : P ≠ 0 := by exact NeZero.ne P
      dsimp [weightPosetProfile]
      rw [Nat.div_div_self hdP hPpos]
    _ = (((P / n : ℕ) : ℝ) ^ 2 - 1) / 12 := hsum

theorem reducedDenominatorWeight_eq_jordanTwo_div12 {P q : ℕ} [NeZero P]
    (hq : 2 ≤ q) (hdiv : q ∣ P) :
    reducedDenominatorWeight P q = jordanTwo q / 12 := by
  let j : ℕ := P / q
  let x : ℕ → ℝ := weightPosetProfile P
  have hPpos : 0 < P := NeZero.pos P
  have hqpos : 0 < q := by omega
  have hjP : j ∣ P := by
    dsimp [j]
    exact quotient_dvd_period hdiv
  have hjpos : 0 < j := by
    dsimp [j]
    exact Nat.div_pos (Nat.le_of_dvd hPpos hdiv) hqpos
  have hPdivj : P / j = q := by
    dsimp [j]
    exact Nat.div_div_self hdiv (NeZero.ne P)
  have hbase : x j = reducedDenominatorWeight P q := by
    dsimp [x, weightPosetProfile]
    rw [hPdivj]
  have hinv := divisorPoset_mobius_inversion P j x hjP hjpos hPpos
  rw [hPdivj] at hinv
  have hfactor : j * q = P := by
    dsimp [j]
    exact Nat.div_mul_cancel hdiv
  have hsum :
      (∑ ℓ ∈ q.divisors,
        (ArithmeticFunction.moebius ℓ : ℝ) *
          divisorPosetCoordinate P x (j * ℓ)) =
        (∑ ℓ ∈ q.divisors,
          (ArithmeticFunction.moebius ℓ : ℝ) *
            ((((q / ℓ : ℕ) : ℝ) ^ 2 - 1) / 12)) := by
    apply sum_congr rfl
    intro ℓ hℓ
    have hℓq : ℓ ∣ q := (Nat.mem_divisors.mp hℓ).1
    have hℓpos : 0 < ℓ := by
      by_contra hnot
      have hzero : ℓ = 0 := by omega
      subst ℓ
      simp at hℓq
      omega
    have hnP : j * ℓ ∣ P := by
      rw [← hfactor]
      exact Nat.mul_dvd_mul_left j hℓq
    have hnpos : 0 < j * ℓ := Nat.mul_pos hjpos hℓpos
    have hcoord := divisorPosetCoordinate_weight hnP hnpos
    have hquot : P / (j * ℓ) = q / ℓ := by
      rw [← Nat.div_div_eq_div_mul P j ℓ, hPdivj]
    rw [hcoord, hquot]
  calc
    reducedDenominatorWeight P q = x j := by rw [hbase]
    _ = ∑ ℓ ∈ q.divisors,
        (ArithmeticFunction.moebius ℓ : ℝ) *
          divisorPosetCoordinate P x (j * ℓ) := hinv
    _ = ∑ ℓ ∈ q.divisors,
        (ArithmeticFunction.moebius ℓ : ℝ) *
          ((((q / ℓ : ℕ) : ℝ) ^ 2 - 1) / 12) := hsum
    _ = (jordanTwo q) / 12 := by
      have hsplit :
          (∑ ℓ ∈ q.divisors,
            (ArithmeticFunction.moebius ℓ : ℝ) *
              ((((q / ℓ : ℕ) : ℝ) ^ 2 - 1)) ) = jordanTwo q := by
        calc
          _ = (∑ ℓ ∈ q.divisors,
                (ArithmeticFunction.moebius ℓ : ℝ) *
                  ((q / ℓ : ℕ) : ℝ) ^ 2) -
                ∑ ℓ ∈ q.divisors, (ArithmeticFunction.moebius ℓ : ℝ) := by
                  calc
                    _ = ∑ ℓ ∈ q.divisors,
                        ((ArithmeticFunction.moebius ℓ : ℝ) *
                          ((q / ℓ : ℕ) : ℝ) ^ 2 -
                          (ArithmeticFunction.moebius ℓ : ℝ)) := by
                            apply sum_congr rfl
                            intro ℓ hℓ
                            ring
                    _ = _ := by rw [Finset.sum_sub_distrib]
          _ = jordanTwo q := by
                rw [sum_moebius_divisors_eq_zero hq]
                simp [jordanTwo]
      have hsum_div :
          (∑ ℓ ∈ q.divisors,
            (ArithmeticFunction.moebius ℓ : ℝ) *
              ((((q / ℓ : ℕ) : ℝ) ^ 2 - 1) / 12)) =
            ((∑ ℓ ∈ q.divisors,
              (ArithmeticFunction.moebius ℓ : ℝ) *
                (((q / ℓ : ℕ) : ℝ) ^ 2 - 1)) / 12) := by
        rw [Finset.sum_div]
        apply sum_congr rfl
        intro ℓ hℓ
        ring
      rw [hsum_div, hsplit]

private def reciprocalGap (d : ℕ) : ℝ := ((d : ℝ) - 1)⁻¹ - (d : ℝ)⁻¹

private theorem sum_Icc_reciprocal_gap (q : ℕ) (hq : 1 ≤ q) :
    (∑ d ∈ Icc 2 q, reciprocalGap d) = 1 - (q : ℝ)⁻¹ := by
  induction q with
  | zero => omega
  | succ q ih =>
      by_cases hq0 : q = 0
      · subst q
        simp [reciprocalGap]
      · have hqpos : 1 ≤ q := by omega
        have hsum := ih hqpos
        rw [Finset.sum_Icc_succ_top (by omega)]
        rw [hsum]
        have hqR : (q : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (by omega : 0 < q))
        simp only [reciprocalGap]
        field_simp [hqR]
        push_cast
        ring

private theorem invSq_le_reciprocal_gap {d : ℕ} (hd : 3 ≤ d) :
    (d : ℝ)⁻¹ ^ 2 ≤ ((d : ℝ) - 1)⁻¹ - (d : ℝ)⁻¹ := by
  have hdR : (d : ℝ) ≠ 0 := by exact_mod_cast (by omega : d ≠ 0)
  have hdm1 : (d : ℝ) - 1 ≠ 0 := by
    exact sub_ne_zero.mpr (by exact_mod_cast (by omega : d ≠ 1))
  have hdRpos : 0 < (d : ℝ) := by exact_mod_cast (by omega : 0 < d)
  have hdm1pos : 0 < (d : ℝ) - 1 := by
    have hdge3 : (3 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
    linarith
  have hineq : (d : ℝ) * ((d : ℝ) - 1) ≤ (d : ℝ) ^ 2 := by
    nlinarith [sq_nonneg (d : ℝ)]
  have hcross : 1 / (d : ℝ) ^ 2 ≤
      1 / ((d : ℝ) * ((d : ℝ) - 1)) :=
    (div_le_div_iff₀ (sq_pos_of_ne_zero hdR)
      (mul_pos hdRpos hdm1pos)).2 (by nlinarith [hineq])
  have hgap : 1 / ((d : ℝ) * ((d : ℝ) - 1)) =
      ((d : ℝ) - 1)⁻¹ - (d : ℝ)⁻¹ := by
    field_simp [hdR, hdm1]
    ring
  calc
    (d : ℝ)⁻¹ ^ 2 = 1 / (d : ℝ) ^ 2 := by field_simp [hdR]
    _ ≤ 1 / ((d : ℝ) * ((d : ℝ) - 1)) := hcross
    _ = _ := hgap

private theorem sum_Icc_invSq_le_three_quarters (q : ℕ) (hq : 2 ≤ q) :
    (∑ d ∈ Icc 2 q, (d : ℝ)⁻¹ ^ 2) ≤ (3 : ℝ) / 4 := by
  have hgapFull := sum_Icc_reciprocal_gap q (by omega)
  have hset : (Icc 2 q).erase 2 = Icc 3 q := by
    ext d
    simp [mem_Icc, Nat.not_lt]
    omega
  have hmem2 : 2 ∈ Icc 2 q := by simp [mem_Icc, hq]
  have hgapRest : (∑ d ∈ Icc 3 q, reciprocalGap d) =
      (1 : ℝ) / 2 - (q : ℝ)⁻¹ := by
    have he := Finset.sum_erase_add (Icc 2 q) reciprocalGap (a := 2) hmem2
    rw [hset] at he
    have hgap2 : reciprocalGap 2 = (1 : ℝ) / 2 := by norm_num [reciprocalGap]
    rw [hgap2] at he
    linarith [hgapFull]
  have hsubset : (Icc 2 q).erase 2 ⊆ Icc 3 q := by rw [hset]
  have hrest : (∑ d ∈ (Icc 2 q).erase 2, (d : ℝ)⁻¹ ^ 2) ≤
      ∑ d ∈ Icc 3 q, reciprocalGap d := by
    calc
      _ ≤ ∑ d ∈ (Icc 2 q).erase 2, reciprocalGap d := by
        apply sum_le_sum
        intro d hd
        have hdmem : d ∈ Icc 2 q := Finset.mem_of_mem_erase hd
        have hdne : d ≠ 2 := (Finset.mem_erase.mp hd).1
        have hdlo : 3 ≤ d := by
          have := (mem_Icc.mp hdmem).1
          omega
        exact invSq_le_reciprocal_gap hdlo
      _ ≤ ∑ d ∈ Icc 3 q, reciprocalGap d :=
        Finset.sum_le_sum_of_subset_of_nonneg hsubset (fun d hd hnot => by
          have hdlo : 3 ≤ d := (mem_Icc.mp hd).1
          have hdR : (d : ℝ) ≥ 3 := by exact_mod_cast hdlo
          have hpos : 0 < (d : ℝ) - 1 := by linarith
          have hpos' : 0 < (d : ℝ) := by linarith
          have hinv : (d : ℝ)⁻¹ ≤ ((d : ℝ) - 1)⁻¹ :=
            (inv_le_inv₀ hpos' hpos).2 (by linarith)
          exact sub_nonneg.mpr hinv)
  have hsplit :
      (∑ d ∈ Icc 2 q, (d : ℝ)⁻¹ ^ 2) =
        (∑ d ∈ (Icc 2 q).erase 2, (d : ℝ)⁻¹ ^ 2) + (2 : ℝ)⁻¹ ^ 2 := by
    symm
    exact Finset.sum_erase_add (Icc 2 q) (fun d => (d : ℝ)⁻¹ ^ 2) (a := 2) hmem2
  rw [hsplit]
  rw [hgapRest] at hrest
  have hqRpos : 0 < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
  have hqInv : 0 ≤ (q : ℝ)⁻¹ := inv_nonneg.mpr hqRpos.le
  have hquarter : (2 : ℝ)⁻¹ ^ 2 = (1 : ℝ) / 4 := by norm_num
  rw [hquarter]
  linarith [hrest, hqInv]

private theorem jordanTwo_tail_bound {q : ℕ} (hq : 2 ≤ q) :
    (∑ d ∈ q.divisors.erase 1,
      (((q / d : ℕ) : ℝ) ^ 2)) ≤ (q : ℝ) ^ 2 * ((3 : ℝ) / 4) := by
  have hqne : q ≠ 0 := by omega
  have hset : q.divisors.erase 1 ⊆ Icc 2 q := by
    intro d hd
    have he := Finset.mem_erase.mp hd
    have hdivd := (Nat.mem_divisors.mp he.2).1
    have hdn : d ≠ 0 := by
      intro hz
      subst d
      simp at hdivd
      omega
    have hle : d ≤ q := Nat.le_of_dvd (by omega) hdivd
    have hlow : 2 ≤ d := by omega
    exact mem_Icc.mpr ⟨hlow, hle⟩
  have hterm (d : ℕ) (hd : d ∈ q.divisors.erase 1) :
      (((q / d : ℕ) : ℝ) ^ 2) = (q : ℝ) ^ 2 * (d : ℝ)⁻¹ ^ 2 := by
    have hdivd : d ∣ q := (Nat.mem_divisors.mp (Finset.mem_erase.mp hd |>.2)).1
    have hdpos : 0 < d := by
      have hdn : d ≠ 0 := by
        intro hz
        subst d
        simp at hdivd
        omega
      omega
    have hcast : ((q / d : ℕ) : ℝ) = (q : ℝ) / (d : ℝ) :=
      Nat.cast_div hdivd (by exact_mod_cast (Nat.ne_of_gt hdpos))
    rw [hcast]
    ring
  have hsubset := Finset.sum_le_sum_of_subset_of_nonneg hset
    (fun d hd hnot => sq_nonneg ((d : ℝ)⁻¹))
  calc
    _ = (q : ℝ) ^ 2 *
        ∑ d ∈ q.divisors.erase 1, (d : ℝ)⁻¹ ^ 2 := by
      calc
        _ = ∑ d ∈ q.divisors.erase 1, (q : ℝ) ^ 2 * (d : ℝ)⁻¹ ^ 2 := by
          apply sum_congr rfl
          intro d hd
          exact hterm d hd
        _ = _ := by rw [Finset.mul_sum]
    _ ≤ (q : ℝ) ^ 2 * ∑ d ∈ Icc 2 q, (d : ℝ)⁻¹ ^ 2 :=
      mul_le_mul_of_nonneg_left hsubset (sq_nonneg (q : ℝ))
    _ ≤ (q : ℝ) ^ 2 * ((3 : ℝ) / 4) :=
      mul_le_mul_of_nonneg_left (sum_Icc_invSq_le_three_quarters q hq)
        (sq_nonneg (q : ℝ))

private theorem jordanTwo_eq_sq_add_tail {q : ℕ} (hq : 2 ≤ q) :
    jordanTwo q = (q : ℝ) ^ 2 +
      ∑ d ∈ q.divisors.erase 1,
        (ArithmeticFunction.moebius d : ℝ) * (((q / d : ℕ) : ℝ) ^ 2) := by
  have hqne : q ≠ 0 := by omega
  have hmem : 1 ∈ q.divisors := Nat.mem_divisors.mpr ⟨one_dvd q, hqne⟩
  have hmu : (ArithmeticFunction.moebius 1 : ℝ) = 1 := by simp
  unfold jordanTwo
  calc
    _ = (∑ d ∈ q.divisors.erase 1,
          (ArithmeticFunction.moebius d : ℝ) * (((q / d : ℕ) : ℝ) ^ 2)) +
        (ArithmeticFunction.moebius 1 : ℝ) * (((q / 1 : ℕ) : ℝ) ^ 2) :=
          (Finset.sum_erase_add q.divisors
            (fun d => (ArithmeticFunction.moebius d : ℝ) * (((q / d : ℕ) : ℝ) ^ 2))
            (a := 1) hmem).symm
    _ = _ := by rw [hmu]; simp; ring

private theorem moebius_real_bounds (d : ℕ) :
    -1 ≤ (ArithmeticFunction.moebius d : ℝ) ∧
      (ArithmeticFunction.moebius d : ℝ) ≤ 1 := by
  have h : |(ArithmeticFunction.moebius d : ℝ)| ≤ 1 := by
    exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n := d)
  exact abs_le.mp h

private theorem jordanTwo_tail_bounds {q : ℕ} (hq : 2 ≤ q) :
    -(∑ d ∈ q.divisors.erase 1, (((q / d : ℕ) : ℝ) ^ 2)) ≤
        ∑ d ∈ q.divisors.erase 1,
          (ArithmeticFunction.moebius d : ℝ) * (((q / d : ℕ) : ℝ) ^ 2) ∧
      (∑ d ∈ q.divisors.erase 1,
          (ArithmeticFunction.moebius d : ℝ) * (((q / d : ℕ) : ℝ) ^ 2)) ≤
        ∑ d ∈ q.divisors.erase 1, (((q / d : ℕ) : ℝ) ^ 2) := by
  constructor
  · calc
      -(∑ d ∈ q.divisors.erase 1, (((q / d : ℕ) : ℝ) ^ 2)) =
          ∑ d ∈ q.divisors.erase 1, -(((q / d : ℕ) : ℝ) ^ 2) := by simp
      _ ≤ ∑ d ∈ q.divisors.erase 1,
          (ArithmeticFunction.moebius d : ℝ) * (((q / d : ℕ) : ℝ) ^ 2) := by
            apply Finset.sum_le_sum
            intro d hd
            have hmu := moebius_real_bounds d
            have hy : 0 ≤ (((q / d : ℕ) : ℝ) ^ 2) := sq_nonneg _
            calc
              -(((q / d : ℕ) : ℝ) ^ 2) = (-1) * (((q / d : ℕ) : ℝ) ^ 2) := by ring
              _ ≤ (ArithmeticFunction.moebius d : ℝ) * (((q / d : ℕ) : ℝ) ^ 2) :=
                mul_le_mul_of_nonneg_right hmu.1 hy
  · apply Finset.sum_le_sum
    intro d hd
    have hmu := moebius_real_bounds d
    simpa using mul_le_mul_of_nonneg_right hmu.2
      (sq_nonneg (((q / d : ℕ) : ℝ)))

private theorem jordanTwo_le_two_sq {q : ℕ} (hq : 2 ≤ q) :
    jordanTwo q ≤ 2 * (q : ℝ) ^ 2 := by
  have hdecomp := jordanTwo_eq_sq_add_tail hq
  have htail := jordanTwo_tail_bounds hq
  have hsum := jordanTwo_tail_bound hq
  nlinarith

private theorem jordanTwo_ge_quarter_sq {q : ℕ} (hq : 4 ≤ q) :
    (q : ℝ) ^ 2 / 4 ≤ jordanTwo q := by
  have hdecomp := jordanTwo_eq_sq_add_tail (by omega : 2 ≤ q)
  have htail := jordanTwo_tail_bounds (by omega : 2 ≤ q)
  have hsum := jordanTwo_tail_bound (by omega : 2 ≤ q)
  nlinarith

private theorem jordanTwo_lower_bound {q : ℕ} (hq : 2 ≤ q) :
    (q : ℝ) ^ 2 / 4 ≤ jordanTwo q := by
  by_cases hq4 : 4 ≤ q
  · exact jordanTwo_ge_quarter_sq hq4
  · have hq23 : q = 2 ∨ q = 3 := by omega
    rcases hq23 with rfl | rfl
    · norm_num [jordanTwo, ArithmeticFunction.moebius_apply_prime]
    · norm_num [jordanTwo, ArithmeticFunction.moebius_apply_prime]

theorem reducedDenominatorWeight_quadratic_bounds {P q : ℕ} [NeZero P]
    (hq : 2 ≤ q) (hdiv : q ∣ P) :
    (q : ℝ) ^ 2 / 48 ≤ reducedDenominatorWeight P q ∧
      reducedDenominatorWeight P q ≤ (q : ℝ) ^ 2 / 6 := by
  rw [reducedDenominatorWeight_eq_jordanTwo_div12 hq hdiv]
  constructor
  · have hj := jordanTwo_lower_bound hq
    nlinarith
  · have hj := jordanTwo_le_two_sq hq
    nlinarith

private theorem reducedDenominatorWeight_pos {P q : ℕ} [NeZero P]
    (hq : 2 ≤ q) (hdiv : q ∣ P) : 0 < reducedDenominatorWeight P q := by
  have h := (reducedDenominatorWeight_quadratic_bounds hq hdiv).1
  have hqpos : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (show 0 < q by omega)
  nlinarith

theorem reducedPrimitiveKernel_bounds {P q : ℕ} [NeZero P] (K : Fin P)
    (hq : 2 ≤ q) (hdiv : q ∣ P) :
    0 ≤ reducedPrimitiveKernel P q K ∧
      reducedPrimitiveKernel P q K ≤ 2 * reducedDenominatorWeight P q := by
  classical
  unfold reducedPrimitiveKernel reducedDenominatorWeight
  let s := Finset.univ.filter (fun h : ZMod P => h ≠ 0 ∧ addOrderOf h = q)
  have hnonneg :
      0 ≤ ∑ h ∈ s,
        (1 - (ZMod.stdAddChar (-(h * (K.val : ZMod P)))).re) *
          Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹) := by
    apply sum_nonneg
    intro h hh
    have hchar := stdChar_re_bounds (-(h * (K.val : ZMod P)))
    exact mul_nonneg (by linarith [hchar.1]) (Complex.normSq_nonneg _)
  have hupper :
      (∑ h ∈ s,
        (1 - (ZMod.stdAddChar (-(h * (K.val : ZMod P)))).re) *
          Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹)) ≤
      ∑ h ∈ s, 2 * Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹) := by
    apply sum_le_sum
    intro h hh
    have hchar := stdChar_re_bounds (-(h * (K.val : ZMod P)))
    exact mul_le_mul_of_nonneg_right (by linarith [hchar.2]) (Complex.normSq_nonneg _)
  constructor
  · exact hnonneg
  · calc
      _ ≤ ∑ h ∈ s, 2 * Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹) := hupper
      _ = 2 * ∑ h ∈ s, Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹) := by
        rw [← Finset.mul_sum]

/-- Averaging the primitive kernel over one full period gives the denominator
weight exactly. -/
theorem reducedPrimitiveKernel_period_sum {P q : ℕ} [NeZero P] :
    (∑ K : Fin P, reducedPrimitiveKernel P q K) =
      (P : ℝ) * reducedDenominatorWeight P q := by
  classical
  unfold reducedPrimitiveKernel
  let s := Finset.univ.filter (fun h : ZMod P => h ≠ 0 ∧ addOrderOf h = q)
  calc
    (∑ K : Fin P,
        ∑ h ∈ s,
          (1 - (ZMod.stdAddChar (-(h * (K.val : ZMod P)))).re) *
            Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹)) =
        ∑ h ∈ s, ∑ K : Fin P,
          (1 - (ZMod.stdAddChar (-(h * (K.val : ZMod P)))).re) *
            Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹) := by
              rw [Finset.sum_comm]
    _ = ∑ h ∈ s,
          (P : ℝ) * Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹) := by
            apply sum_congr rfl
            intro h hh
            have hnonzero : h ≠ 0 := (Finset.mem_filter.mp hh).2.1
            have hchar := stdChar_sum_fin_eq_zero h hnonzero
            have hsumre :
                (Finset.univ.sum (fun K : Fin P =>
                  (ZMod.stdAddChar (-(h * (K.val : ZMod P)))).re)) = 0 := by
              rw [← Complex.re_sum]
              exact congrArg Complex.re hchar
            have hsumfactor :
                (Finset.univ.sum (fun k : Fin P =>
                  1 - (ZMod.stdAddChar (-(h * (k.val : ZMod P)))).re)) = (P : ℝ) := by
              rw [Finset.sum_sub_distrib, hsumre]
              simp
            calc
              (Finset.univ.sum (fun k : Fin P =>
                  (1 - (ZMod.stdAddChar (-(h * (k.val : ZMod P)))).re) *
                    Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹))) =
                  (Finset.univ.sum (fun k : Fin P =>
                    1 - (ZMod.stdAddChar (-(h * (k.val : ZMod P)))).re)) *
                    Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹) := by
                      rw [← Finset.sum_mul]
              _ = (P : ℝ) * Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹) := by
                    rw [hsumfactor]
    _ = (P : ℝ) * reducedDenominatorWeight P q := by
          unfold reducedDenominatorWeight
          rw [Finset.mul_sum]

private theorem divisorCoordinate_ofReal (N q : ℕ) (x : ℕ → ℝ) :
    divisorCoordinate N (fun j => (x j : ℂ)) q =
      (reducedShellCoordinate N (fun j => x j / (j : ℝ)) q : ℂ) := by
  unfold divisorCoordinate reducedShellCoordinate
  rw [Complex.ofReal_sum]
  apply sum_congr rfl
  intro j hj
  by_cases hqj : q ∣ j
  · simp [hqj, Complex.ofReal_div]
  · simp [hqj]

private theorem centeredPrimitive_fourier_mode {P N : ℕ} [NeZero P]
    (x : ℕ → ℝ) (K : Fin P) (h : ZMod P) (hh : h ≠ 0)
    (hperiod : ∀ j ∈ Icc 2 N, j ∣ P) :
    Complex.re
        (normalizedDft P
          (centeredShellSection P N (fun j => (x j : ℂ))) h *
          (∑ k : Fin K.val, ZMod.stdAddChar (h * (k.val : ZMod P)))) =
      -(reducedShellCoordinate N (fun j => x j / (j : ℝ)) (addOrderOf h)) *
        ((1 - (ZMod.stdAddChar (-(h * (K.val : ZMod P)))).re) *
          Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹)) := by
  have hperiodC : ∀ j ∈ Icc 2 N, (x j : ℂ) ≠ 0 → j ∣ P := by
    intro j hj hne
    have hx : x j ≠ 0 := by
      intro hz
      apply hne
      simp [hz]
    exact hperiod j hj
  have hcoeff := normalizedDft_centeredShell_factor
    (P := P) (N := N) (fun j => (x j : ℂ)) hperiodC h hh
  rw [divisorCoordinate_ofReal] at hcoeff
  let zn := ZMod.stdAddChar (-h)
  let zp := ZMod.stdAddChar h
  let zK := ZMod.stdAddChar (h * (K.val : ZMod P))
  have hcharstar : star zn = zp := by
    dsimp [zn, zp]
    rw [AddChar.map_neg_eq_conj]
    simp
  have hstar : star (1 - zn) = 1 - zp := by simp [hcharstar]
  have hns : (Complex.normSq ((1 - zn)⁻¹) : ℂ) =
      (1 - zp)⁻¹ * (1 - zn)⁻¹ := by
    calc
      _ = star ((1 - zn)⁻¹) * (1 - zn)⁻¹ := Complex.normSq_eq_conj_mul_self
      _ = (1 - zp)⁻¹ * (1 - zn)⁻¹ := by rw [star_inv₀, hstar]
  have hzn : 1 - zn ≠ 0 := by
    intro hz
    have hchar : ZMod.stdAddChar (-h) = ZMod.stdAddChar (0 : ZMod P) := by
      simpa [zn] using (sub_eq_zero.mp hz).symm
    have hneg : -h = 0 := ZMod.injective_stdAddChar hchar
    exact hh (neg_eq_zero.mp hneg)
  have hzp : 1 - zp ≠ 0 := by
    intro hz
    have hchar : ZMod.stdAddChar h = ZMod.stdAddChar (0 : ZMod P) := by
      simpa [zp] using (sub_eq_zero.mp hz).symm
    exact hh (ZMod.injective_stdAddChar hchar)
  have hpow : (ZMod.stdAddChar h) ^ K.val = zK := by
    dsimp [zK]
    exact (stdChar_pos_nat_mul P h K.val).symm
  have hgeomEq :
      (∑ k : Fin K.val, ZMod.stdAddChar (h * (k.val : ZMod P))) =
        (1 - zK) / (1 - zp) := by
    rw [stdChar_sum_fin_geom (P := P) (n := K.val) h hh, hpow]

  have hcomplex :
      (-(reducedShellCoordinate N (fun j => x j / (j : ℝ))
        (addOrderOf h) : ℂ) / (1 - zn)) *
          ((1 - zK) / (1 - zp)) =
        -(reducedShellCoordinate N (fun j => x j / (j : ℝ))
          (addOrderOf h) : ℂ) *
          (1 - zK) * (Complex.normSq ((1 - zn)⁻¹) : ℂ) := by
    rw [hns]
    field_simp [hzn, hzp]
  have harg :
      1 - (ZMod.stdAddChar (-(h * (K.val : ZMod P)))).re = (1 - zK).re := by
    have hstarK : star zK = ZMod.stdAddChar (-(h * (K.val : ZMod P))) := by
      dsimp [zK]
      rw [AddChar.map_neg_eq_conj]
    calc
      _ = 1 - (star zK).re := by rw [hstarK]
      _ = (1 - zK).re := by simp [Complex.conj_re]
  rw [hcoeff, hgeomEq]
  rw [hcomplex, harg]
  simp [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im]
  ring

/-- The finite Fourier inverse makes the primitive of an actual real shell
section equal to its reduced-denominator evaluation functional. -/
theorem integerCenteredPrimitive_eq_reducedPrimitiveEvaluation
    {P N : ℕ} [NeZero P] (x : ℕ → ℝ) (K : Fin P) (hN : 2 ≤ N)
    (hperiod : ∀ j ∈ Icc 2 N, j ∣ P) :
    Complex.re (integerCenteredPrimitive P N (fun j => (x j : ℂ)) K) =
      reducedPrimitiveEvaluation P N
        (fun q => reducedShellCoordinate N (fun j => x j / (j : ℝ)) q) K := by
  classical
  let s : Finset (ZMod P) := Finset.univ.erase 0
  let term (h : ZMod P) : ℝ :=
    reducedShellCoordinate N (fun j => x j / (j : ℝ)) (addOrderOf h) *
      ((1 - (ZMod.stdAddChar (-(h * (K.val : ZMod P)))).re) *
        Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹))
  have hfourier : integerCenteredPrimitive P N (fun j => (x j : ℂ)) K =
      ∑ h : ZMod P,
        normalizedDft P (centeredShellSection P N (fun j => (x j : ℂ))) h *
          (∑ k : Fin K.val, ZMod.stdAddChar (h * (k.val : ZMod P))) := by
    unfold integerCenteredPrimitive
    calc
      _ = ∑ k : Fin K.val, ∑ h : ZMod P,
          normalizedDft P (centeredShellSection P N (fun j => (x j : ℂ))) h *
            ZMod.stdAddChar (h * (k.val : ZMod P)) := by
              apply sum_congr rfl
              intro k hk
              exact normalizedDft_inverse
                (centeredShellSection P N (fun j => (x j : ℂ)))
                ⟨k.val, Nat.lt_trans k.isLt K.isLt⟩
      _ = ∑ h : ZMod P, ∑ k : Fin K.val,
          normalizedDft P (centeredShellSection P N (fun j => (x j : ℂ))) h *
            ZMod.stdAddChar (h * (k.val : ZMod P)) := by rw [Finset.sum_comm]
      _ = _ := by
              apply sum_congr rfl
              intro h hh
              rw [Finset.mul_sum]
  have hnonzero (h : ZMod P) (hh : h ∈ s) : h ≠ 0 :=
    (Finset.mem_erase.mp hh).1
  have hterms :
      Complex.re (integerCenteredPrimitive P N (fun j => (x j : ℂ)) K) =
        -∑ h ∈ s, term h := by
    rw [hfourier, Complex.re_sum]
    have hzero : normalizedDft P
        (centeredShellSection P N (fun j => (x j : ℂ))) 0 = 0 :=
      normalizedDft_centeredShell_zero _
    have hpoint (h : ZMod P) :
        Complex.re
          (normalizedDft P (centeredShellSection P N (fun j => (x j : ℂ))) h *
            (∑ k : Fin K.val, ZMod.stdAddChar (h * (k.val : ZMod P)))) =
          if h = 0 then 0 else -term h := by
      by_cases hh : h = 0
      · subst h
        simp [hzero]
      · simp only [if_neg hh]
        simpa [term] using centeredPrimitive_fourier_mode x K h hh hperiod
    calc
      _ = ∑ h : ZMod P, if h = 0 then 0 else -term h := by
            apply sum_congr rfl
            intro h hh
            exact hpoint h
      _ = -∑ h ∈ s, term h := by
            have hsum :
                (∑ h : ZMod P, if h = 0 then 0 else -term h) =
                  ∑ h ∈ s, -term h := by
              change (∑ h ∈ (Finset.univ : Finset (ZMod P)),
                if h = 0 then 0 else -term h) = ∑ h ∈ s, -term h
              calc
                _ = ∑ h ∈ Finset.univ,
                    if h ≠ 0 then -term h else 0 := by
                      apply sum_congr rfl
                      intro h hh
                      by_cases h0 : h = 0 <;> simp [h0]
                _ = ∑ h ∈ Finset.univ with h ≠ 0, -term h := by
                      rw [← Finset.sum_filter]
                _ = ∑ h ∈ s, -term h := by
                      rw [show s = Finset.univ.filter (fun h : ZMod P => h ≠ 0) by
                        ext h
                        simp [s]]
            rw [hsum, Finset.sum_neg_distrib]
  let weightTerm (h : ZMod P) : ℝ := term h
  have hfiber :
      (∑ q : Fin (P + 1), ∑ h ∈ s with denominatorIndex h = q, weightTerm h) =
        ∑ h ∈ s, weightTerm h := by
    exact Finset.sum_fiberwise_of_maps_to
      (s := s) (t := Finset.univ) (g := denominatorIndex)
      (fun _ _ => Finset.mem_univ _) weightTerm
  have hclass (q : Fin (P + 1)) :
      (∑ h ∈ s with denominatorIndex h = q, weightTerm h) =
        if q.val ∈ Icc 2 N then
          reducedShellCoordinate N (fun j => x j / (j : ℝ)) q.val *
            reducedPrimitiveKernel P q.val K else 0 := by
    by_cases hq : q.val ∈ Icc 2 N
    · rw [if_pos hq]
      calc
        _ = ∑ h ∈ s with denominatorIndex h = q,
            reducedShellCoordinate N (fun j => x j / (j : ℝ)) q.val *
              ((1 - (ZMod.stdAddChar (-(h * (K.val : ZMod P)))).re) *
                Complex.normSq ((1 - ZMod.stdAddChar (-h))⁻¹)) := by
              apply sum_congr rfl
              intro h hh
              have horder := (denominatorIndex_eq_iff h q).mp
                (Finset.mem_filter.mp hh).2
              simp [weightTerm, term, horder]
        _ = reducedShellCoordinate N (fun j => x j / (j : ℝ)) q.val *
            reducedPrimitiveKernel P q.val K := by
              rw [← Finset.mul_sum]
              congr 1
              have hsets :
                  s.filter (fun h : ZMod P => denominatorIndex h = q) =
                    Finset.univ.filter fun h : ZMod P =>
                      h ≠ 0 ∧ addOrderOf h = q.val := by
                ext h
                simp [s, denominatorIndex_eq_iff]
              rw [hsets, reducedPrimitiveKernel]
    · rw [if_neg hq]
      have hsumzero :
          (∑ h ∈ s with denominatorIndex h = q, weightTerm h) = 0 := by
        apply Finset.sum_eq_zero
        intro h hh
        rcases Finset.mem_filter.mp hh with ⟨hins, hEq⟩
        have horder := (denominatorIndex_eq_iff h q).mp hEq
        have hge := addOrderOf_ge_two_of_ne_zero h (Finset.mem_erase.mp hins).1
        have hlow : 2 ≤ q.val := by simpa [horder] using hge
        have hgt : N < q.val := by
          by_contra hn
          exact hq (mem_Icc.mpr ⟨hlow, Nat.le_of_not_gt hn⟩)
        simp [weightTerm, term, horder,
          reducedShellCoordinate_eq_zero_of_gt hgt (fun j => x j / (j : ℝ))]
      exact hsumzero
  have hgroup :
      (∑ h ∈ s, weightTerm h) =
        ∑ q ∈ (Finset.univ.filter fun q : Fin (P + 1) => q.val ∈ Icc 2 N),
          reducedShellCoordinate N (fun j => x j / (j : ℝ)) q.val *
            reducedPrimitiveKernel P q.val K := by
    calc
      _ = ∑ q : Fin (P + 1),
          ∑ h ∈ s with denominatorIndex h = q, weightTerm h := hfiber.symm
      _ = ∑ q : Fin (P + 1),
          if q.val ∈ Icc 2 N then
            reducedShellCoordinate N (fun j => x j / (j : ℝ)) q.val *
              reducedPrimitiveKernel P q.val K else 0 := by
              apply sum_congr rfl
              intro q hq
              exact hclass q
      _ = _ := by rw [← Finset.sum_filter]
  have hsumIcc :
      (∑ q ∈ (Finset.univ.filter fun q : Fin (P + 1) => q.val ∈ Icc 2 N),
        reducedShellCoordinate N (fun j => x j / (j : ℝ)) q.val *
          reducedPrimitiveKernel P q.val K) =
        ∑ q ∈ Icc 2 N, reducedShellCoordinate N (fun j => x j / (j : ℝ)) q *
          reducedPrimitiveKernel P q K :=
    sum_fin_filter_eq_Icc (P := P) (N := N)
      (Nat.le_of_dvd (NeZero.pos P) (hperiod N (mem_Icc.mpr ⟨hN, le_rfl⟩)))
      (fun q => reducedShellCoordinate N (fun j => x j / (j : ℝ)) q *
        reducedPrimitiveKernel P q K)
  rw [hterms, hgroup, hsumIcc]
  rfl

/-- Parseval's diagonal energy for real shell coefficients is the weighted
quadratic form in their reduced-denominator coordinates. -/
theorem centeredCesaroEnergy_eq_reducedCoordinateEnergy
    {P N : ℕ} [NeZero P] (a : ℕ → ℝ) (hN : 2 ≤ N)
    (hperiod : ∀ j ∈ Icc 2 N, j ∣ P) :
    centeredCesaroEnergy P N (fun j => (a j : ℂ)) =
      reducedCoordinateEnergy P N
        (fun q => reducedShellCoordinate N (fun j => a j / (j : ℝ)) q) := by
  have hperiodC : ∀ j ∈ Icc 2 N, (a j : ℂ) ≠ 0 → j ∣ P := by
    intro j hj hne
    exact hperiod j hj
  rw [centeredCesaroEnergy_eq_diagonal (fun j => (a j : ℂ)) hN hperiodC]
  unfold centeredDiagonalEnergy reducedCoordinateEnergy
  rw [sum_fin_filter_eq_Icc (P := P) (N := N)
    (Nat.le_of_dvd (NeZero.pos P) (hperiod N (mem_Icc.mpr ⟨hN, le_rfl⟩)))
    (fun q => Complex.normSq
      (divisorCoordinate N (fun j => (a j : ℂ)) q) * reducedDenominatorWeight P q)]
  apply sum_congr rfl
  intro q hq
  rw [divisorCoordinate_ofReal]
  simp [Complex.normSq_ofReal]
  ring

/-- Weighted Cauchy--Schwarz gives the exact squared dual norm of one integer
primitive evaluation. -/
theorem reducedPrimitiveEvaluation_sq_le_dualNormSq {P N : ℕ} [NeZero P]
    (B : ℕ → ℝ) (K : Fin P) (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    (reducedPrimitiveEvaluation P N B K) ^ 2 ≤
      reducedCoordinateEnergy P N B * primitiveEvaluationDualNormSq P N K := by
  classical
  let s := Icc 2 N
  let f := fun q => Real.sqrt (reducedDenominatorWeight P q) * B q
  let g := fun q => reducedPrimitiveKernel P q K /
    Real.sqrt (reducedDenominatorWeight P q)
  have hWpos (q : ℕ) (hq : q ∈ s) : 0 < reducedDenominatorWeight P q :=
    reducedDenominatorWeight_pos (mem_Icc.mp hq).1 (hperiod q hq)
  have hsumfg : (∑ q ∈ s, f q * g q) =
      ∑ q ∈ s, B q * reducedPrimitiveKernel P q K := by
    apply sum_congr rfl
    intro q hq
    have hsqrtpos := Real.sqrt_pos.2 (hWpos q hq)
    dsimp [f, g]
    field_simp [ne_of_gt hsqrtpos]
  have hsumf : (∑ q ∈ s, f q ^ 2) = reducedCoordinateEnergy P N B := by
    unfold reducedCoordinateEnergy
    apply sum_congr rfl
    intro q hq
    have hw := hWpos q hq
    dsimp [f]
    rw [mul_pow, Real.sq_sqrt (le_of_lt hw)]
  have hsumg : (∑ q ∈ s, g q ^ 2) = primitiveEvaluationDualNormSq P N K := by
    unfold primitiveEvaluationDualNormSq
    apply sum_congr rfl
    intro q hq
    have hw := hWpos q hq
    have hsqrtpos := Real.sqrt_pos.2 hw
    have hsqrtsq := Real.sq_sqrt (le_of_lt hw)
    dsimp [g]
    rw [div_pow, hsqrtsq]
  have hcs := Finset.sum_mul_sq_le_sq_mul_sq s f g
  rw [hsumfg, hsumf, hsumg] at hcs
  unfold reducedPrimitiveEvaluation
  nlinarith [hcs]

/-- The dual norm is attained by the reduced-coordinate vector proportional to
`D_q(K)/W(q)`. -/
theorem reducedPrimitiveEvaluation_dualNormSq_attained {P N : ℕ} [NeZero P]
    (K : Fin P) (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    let B : ℕ → ℝ := fun q => reducedPrimitiveKernel P q K /
      reducedDenominatorWeight P q
    reducedCoordinateEnergy P N B = primitiveEvaluationDualNormSq P N K ∧
      reducedPrimitiveEvaluation P N B K = -primitiveEvaluationDualNormSq P N K := by
  classical
  intro B
  have hWpos (q : ℕ) (hq : q ∈ Icc 2 N) : 0 < reducedDenominatorWeight P q :=
    reducedDenominatorWeight_pos (mem_Icc.mp hq).1 (hperiod q hq)
  have henergy : reducedCoordinateEnergy P N B =
      primitiveEvaluationDualNormSq P N K := by
    unfold reducedCoordinateEnergy primitiveEvaluationDualNormSq
    apply sum_congr rfl
    intro q hq
    have hw := hWpos q hq
    have hwne : reducedDenominatorWeight P q ≠ 0 := ne_of_gt hw
    dsimp [B]
    field_simp [hwne]
  have heval : reducedPrimitiveEvaluation P N B K =
      -primitiveEvaluationDualNormSq P N K := by
    unfold reducedPrimitiveEvaluation primitiveEvaluationDualNormSq
    congr 1
    apply sum_congr rfl
    intro q hq
    have hw := hWpos q hq
    have hwne : reducedDenominatorWeight P q ≠ 0 := ne_of_gt hw
    dsimp [B]
    field_simp [hwne]
  exact ⟨henergy, heval⟩

/-- The exact Cauchy--Schwarz extremizer is representable by genuine shell
coefficients, so the reduced-coordinate dual norm is the actual finite-shell
evaluation norm. -/
theorem integerCenteredPrimitive_dualNormSq_attained_by_shell
    {P N : ℕ} [NeZero P] (K : Fin P) (hN : 2 ≤ N)
    (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    ∃ a : ℕ → ℝ,
      centeredCesaroEnergy P N (fun j => (a j : ℂ)) =
          primitiveEvaluationDualNormSq P N K ∧
        Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K) =
          -primitiveEvaluationDualNormSq P N K := by
  classical
  let B : ℕ → ℝ := fun q =>
    reducedPrimitiveKernel P q K / reducedDenominatorWeight P q
  let Bvec : ReducedCoordinateIndex N → ℝ := fun q => B q.val
  obtain ⟨a, ha⟩ := reducedDenominatorCoordinates_realizable N hN Bvec
  let Acoords : ℕ → ℝ :=
    fun q => reducedShellCoordinate N (fun j => a j / (j : ℝ)) q
  have hcoord (q : ℕ) (hq : q ∈ Icc 2 N) : Acoords q = B q := by
    simpa [Acoords, Bvec, B] using ha ⟨q, hq⟩
  have heval : reducedPrimitiveEvaluation P N Acoords K =
      reducedPrimitiveEvaluation P N B K := by
    unfold reducedPrimitiveEvaluation
    apply congrArg Neg.neg
    apply sum_congr rfl
    intro q hq
    rw [hcoord q hq]
  have henergy : reducedCoordinateEnergy P N Acoords =
      reducedCoordinateEnergy P N B := by
    unfold reducedCoordinateEnergy
    apply sum_congr rfl
    intro q hq
    rw [hcoord q hq]
  obtain ⟨henergyB, hevalB⟩ := reducedPrimitiveEvaluation_dualNormSq_attained K hperiod
  have henergyA : reducedCoordinateEnergy P N Acoords =
      primitiveEvaluationDualNormSq P N K := henergy.trans henergyB
  have hevalA : reducedPrimitiveEvaluation P N Acoords K =
      -primitiveEvaluationDualNormSq P N K := heval.trans hevalB
  refine ⟨a, ?_, ?_⟩
  · rw [centeredCesaroEnergy_eq_reducedCoordinateEnergy a hN hperiod]
    exact henergyA
  · rw [integerCenteredPrimitive_eq_reducedPrimitiveEvaluation a K hN hperiod]
    exact hevalA

/-- The maximum squared primitive amplification over one full period. -/
private def primitiveDualValues (P N : ℕ) [NeZero P] : Finset ℝ :=
  Finset.univ.image (fun K : Fin P => primitiveEvaluationDualNormSq P N K)

private theorem primitiveDualValues_nonempty (P N : ℕ) [NeZero P] :
    (primitiveDualValues P N).Nonempty := by
  classical
  let K : Fin P := ⟨0, NeZero.pos P⟩
  exact ⟨primitiveEvaluationDualNormSq P N K,
    Finset.mem_image.mpr ⟨K, Finset.mem_univ _, rfl⟩⟩

noncomputable def primitiveAmplificationSquared (P N : ℕ) [NeZero P] : ℝ :=
  (primitiveDualValues P N).max' (primitiveDualValues_nonempty P N)

noncomputable def primitiveAmplification (P N : ℕ) [NeZero P] : ℝ :=
  Real.sqrt (primitiveAmplificationSquared P N)

/-- The total diagonal mass through denominator `N`. -/
def reducedDenominatorTotal (P N : ℕ) [NeZero P] : ℝ :=
  ∑ q ∈ Icc 2 N, reducedDenominatorWeight P q

private theorem sum_Icc_nat_sq_ge_cubic (N : ℕ) (hN : 2 ≤ N) :
    (N : ℝ) ^ 3 / 27 ≤ ∑ q ∈ Icc 2 N, (q : ℝ) ^ 2 := by
  let L := max 2 (N / 2)
  have hLlo : 2 ≤ L := le_max_left _ _
  have hLhi : L ≤ N := by dsimp [L]; omega
  have hLbound : L ≤ N / 2 + 1 := by dsimp [L]; omega
  have hNle3L : N ≤ 3 * L := by dsimp [L]; omega
  have hcountNat : N ≤ 2 * (N - L + 1) := by omega
  have hcount : (N : ℝ) / 2 ≤ ((N - L + 1 : ℕ) : ℝ) := by
    have hcountCast : (N : ℝ) ≤ 2 * ((N - L + 1 : ℕ) : ℝ) := by exact_mod_cast hcountNat
    linarith
  have hsum_lower :
      ((N - L + 1 : ℕ) : ℝ) * ((N : ℝ) / 3) ^ 2 ≤
        ∑ q ∈ Icc L N, (q : ℝ) ^ 2 := by
    have hcard : (Icc L N).card = N - L + 1 := by simp; omega
    have hconst :
        ((N - L + 1 : ℕ) : ℝ) * ((N : ℝ) / 3) ^ 2 =
          ∑ q ∈ Icc L N, ((N : ℝ) / 3) ^ 2 := by
      simp [Finset.sum_const, nsmul_eq_mul, hcard]
    rw [hconst]
    apply sum_le_sum
    intro q hq
    have hNle3q : N ≤ 3 * q := le_trans hNle3L (Nat.mul_le_mul_left 3 (mem_Icc.mp hq).1)
    have hcast : (N : ℝ) ≤ 3 * (q : ℝ) := by exact_mod_cast hNle3q
    nlinarith
  have hsubset : Icc L N ⊆ Icc 2 N := by
    intro q hq
    exact mem_Icc.mpr ⟨le_trans hLlo (mem_Icc.mp hq).1, (mem_Icc.mp hq).2⟩
  have htotal :
      (∑ q ∈ Icc L N, (q : ℝ) ^ 2) ≤ ∑ q ∈ Icc 2 N, (q : ℝ) ^ 2 := by
    exact sum_le_sum_of_subset_of_nonneg hsubset (fun _ _ _ => by positivity)
  have hNcast : 0 ≤ (N : ℝ) := by positivity
  nlinarith [hsum_lower, hcount, htotal]

theorem reducedDenominatorTotal_cubic_bounds {P N : ℕ} [NeZero P]
    (hN : 2 ≤ N) (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    (N : ℝ) ^ 3 / 1296 ≤ reducedDenominatorTotal P N ∧
      reducedDenominatorTotal P N ≤ (N : ℝ) ^ 3 / 6 := by
  constructor
  · unfold reducedDenominatorTotal
    have hterm : ∀ q ∈ Icc 2 N,
        (q : ℝ) ^ 2 / 48 ≤ reducedDenominatorWeight P q := by
      intro q hq
      exact (reducedDenominatorWeight_quadratic_bounds (mem_Icc.mp hq).1 (hperiod q hq)).1
    have hsum := sum_Icc_nat_sq_ge_cubic N hN
    have hsum' : (N : ℝ) ^ 3 / (27 * 48) ≤
        ∑ q ∈ Icc 2 N, (q : ℝ) ^ 2 / 48 := by
      rw [← Finset.sum_div]
      nlinarith
    have hle : (∑ q ∈ Icc 2 N, (q : ℝ) ^ 2 / 48) ≤
        ∑ q ∈ Icc 2 N, reducedDenominatorWeight P q := by
      apply sum_le_sum
      intro q hq
      exact hterm q hq
    nlinarith [hsum', hle]
  · unfold reducedDenominatorTotal
    have hterm : ∀ q ∈ Icc 2 N,
        reducedDenominatorWeight P q ≤ (N : ℝ) ^ 2 / 6 := by
      intro q hq
      have hqbound := (reducedDenominatorWeight_quadratic_bounds
        (mem_Icc.mp hq).1 (hperiod q hq)).2
      have hqcast : (q : ℝ) ≤ N := by exact_mod_cast (mem_Icc.mp hq).2
      nlinarith
    have hcard : (Icc 2 N).card ≤ N := by simp
    have hsum :
        (∑ q ∈ Icc 2 N, reducedDenominatorWeight P q) ≤
          (Icc 2 N).card * ((N : ℝ) ^ 2 / 6) := by
      calc
        _ ≤ ∑ _q ∈ Icc 2 N, (N : ℝ) ^ 2 / 6 := sum_le_sum fun q hq => hterm q hq
        _ = _ := by simp [Finset.sum_const, nsmul_eq_mul]
    have hcardcast : ((Icc 2 N).card : ℝ) ≤ (N : ℝ) := by exact_mod_cast hcard
    have hprod := mul_le_mul_of_nonneg_right hcardcast (sq_nonneg (N : ℝ))
    nlinarith [hsum, hprod]

private theorem reducedDenominatorWeight_nonneg {P q : ℕ} [NeZero P] :
    0 ≤ reducedDenominatorWeight P q := by
  unfold reducedDenominatorWeight
  exact sum_nonneg fun _ _ => Complex.normSq_nonneg _

private theorem reducedDenominatorTotal_nonneg {P N : ℕ} [NeZero P] :
    0 ≤ reducedDenominatorTotal P N := by
  unfold reducedDenominatorTotal
  exact sum_nonneg fun q _ => reducedDenominatorWeight_nonneg (P := P) (q := q)

private theorem primitiveEvaluationDualNormSq_nonneg {P N : ℕ} [NeZero P]
    (K : Fin P) (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    0 ≤ primitiveEvaluationDualNormSq P N K := by
  unfold primitiveEvaluationDualNormSq
  apply sum_nonneg
  intro q hq
  exact div_nonneg (sq_nonneg _) (le_of_lt
    (reducedDenominatorWeight_pos (mem_Icc.mp hq).1 (hperiod q hq)))

private theorem primitiveEvaluationDualNormSq_le_four_total
    {P N : ℕ} [NeZero P] (K : Fin P)
    (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    primitiveEvaluationDualNormSq P N K ≤ 4 * reducedDenominatorTotal P N := by
  unfold primitiveEvaluationDualNormSq reducedDenominatorTotal
  rw [Finset.mul_sum]
  apply sum_le_sum
  intro q hq
  have hWpos := reducedDenominatorWeight_pos (mem_Icc.mp hq).1 (hperiod q hq)
  have hD := reducedPrimitiveKernel_bounds K (mem_Icc.mp hq).1 (hperiod q hq)
  have hWnonneg : 0 ≤ reducedDenominatorWeight P q := le_of_lt hWpos
  have hsq : (reducedPrimitiveKernel P q K) ^ 2 ≤
      4 * (reducedDenominatorWeight P q) ^ 2 := by
    have hprod := mul_nonneg
      (sub_nonneg.mpr hD.2)
      (add_nonneg (mul_nonneg (show (0 : ℝ) ≤ 2 by norm_num) hWnonneg) hD.1)
    nlinarith
  apply (div_le_iff₀ hWpos).2
  nlinarith [hsq]

private theorem primitiveEvaluationDualNormSq_period_sum_lower
    {P N : ℕ} [NeZero P] (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    (P : ℝ) * reducedDenominatorTotal P N ≤
      ∑ K : Fin P, primitiveEvaluationDualNormSq P N K := by
  classical
  have hqLower (q : ℕ) (hq : q ∈ Icc 2 N) :
      (P : ℝ) * reducedDenominatorWeight P q ≤
        ∑ K : Fin P,
          (reducedPrimitiveKernel P q K) ^ 2 / reducedDenominatorWeight P q := by
    have hWpos := reducedDenominatorWeight_pos (mem_Icc.mp hq).1 (hperiod q hq)
    have hPpos : (0 : ℝ) < P := by exact_mod_cast (NeZero.pos P)
    have hsumD := reducedPrimitiveKernel_period_sum (P := P) (q := q)
    have hcs0 := Finset.sum_mul_sq_le_sq_mul_sq
      (Finset.univ : Finset (Fin P)) (fun _ => (1 : ℝ))
      (fun K => reducedPrimitiveKernel P q K)
    have hones : (∑ K : Fin P, (1 : ℝ) ^ 2) = (P : ℝ) := by simp
    have hcs :
        (∑ K : Fin P, reducedPrimitiveKernel P q K) ^ 2 ≤
          (P : ℝ) * ∑ K : Fin P, (reducedPrimitiveKernel P q K) ^ 2 := by
      simpa [hones] using hcs0
    have hcs' :
        ((P : ℝ) * reducedDenominatorWeight P q) ^ 2 ≤
          (P : ℝ) * ∑ K : Fin P, (reducedPrimitiveKernel P q K) ^ 2 := by
      simpa [hsumD] using hcs
    have hdiv :
        ((P : ℝ) * reducedDenominatorWeight P q) ^ 2 / (P : ℝ) ≤
          ∑ K : Fin P, (reducedPrimitiveKernel P q K) ^ 2 := by
      apply (div_le_iff₀ hPpos).2
      simpa [mul_comm] using hcs'
    have hPne : (P : ℝ) ≠ 0 := ne_of_gt hPpos
    have hmain :
        (P : ℝ) * (reducedDenominatorWeight P q) ^ 2 ≤
          ∑ K : Fin P, (reducedPrimitiveKernel P q K) ^ 2 := by
      have heq :
          ((P : ℝ) * reducedDenominatorWeight P q) ^ 2 / (P : ℝ) =
            (P : ℝ) * (reducedDenominatorWeight P q) ^ 2 := by
        field_simp [hPne]
      rw [heq] at hdiv
      exact hdiv
    have hweighted :
        (P : ℝ) * reducedDenominatorWeight P q ≤
          (∑ K : Fin P, (reducedPrimitiveKernel P q K) ^ 2) /
            reducedDenominatorWeight P q := by
      apply (le_div_iff₀ hWpos).2
      calc
        (P : ℝ) * reducedDenominatorWeight P q * reducedDenominatorWeight P q =
            (P : ℝ) * (reducedDenominatorWeight P q) ^ 2 := by ring
        _ ≤ ∑ K : Fin P, (reducedPrimitiveKernel P q K) ^ 2 := hmain
    calc
      (P : ℝ) * reducedDenominatorWeight P q ≤
          (∑ K : Fin P, (reducedPrimitiveKernel P q K) ^ 2) /
            reducedDenominatorWeight P q := hweighted
      _ = ∑ K : Fin P,
          (reducedPrimitiveKernel P q K) ^ 2 / reducedDenominatorWeight P q := by
            rw [Finset.sum_div]
  unfold reducedDenominatorTotal primitiveEvaluationDualNormSq
  calc
    (P : ℝ) * ∑ q ∈ Icc 2 N, reducedDenominatorWeight P q =
        ∑ q ∈ Icc 2 N, (P : ℝ) * reducedDenominatorWeight P q := by
          rw [Finset.mul_sum]
    _ ≤ ∑ q ∈ Icc 2 N, ∑ K : Fin P,
          (reducedPrimitiveKernel P q K) ^ 2 / reducedDenominatorWeight P q := by
          apply sum_le_sum
          intro q hq
          exact hqLower q hq
    _ = ∑ K : Fin P, ∑ q ∈ Icc 2 N,
          (reducedPrimitiveKernel P q K) ^ 2 / reducedDenominatorWeight P q := by
          rw [Finset.sum_comm]

private theorem primitiveAmplificationSquared_pos {P N : ℕ} [NeZero P]
    (hN : 2 ≤ N) (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    0 < primitiveAmplificationSquared P N := by
  classical
  have hSpos : 0 < reducedDenominatorTotal P N := by
    unfold reducedDenominatorTotal
    apply Finset.sum_pos
    · intro q hq
      exact reducedDenominatorWeight_pos (mem_Icc.mp hq).1 (hperiod q hq)
    · exact ⟨2, mem_Icc.mpr ⟨le_rfl, hN⟩⟩
  have hPpos : (0 : ℝ) < P := by exact_mod_cast (NeZero.pos P)
  have hsumpos : 0 < ∑ K : Fin P, primitiveEvaluationDualNormSq P N K := by
    have hsum := primitiveEvaluationDualNormSq_period_sum_lower hperiod
    nlinarith
  have hexists : ∃ K : Fin P, 0 < primitiveEvaluationDualNormSq P N K := by
    by_contra hnone
    push_neg at hnone
    have hsumle : (∑ K : Fin P, primitiveEvaluationDualNormSq P N K) ≤ 0 := by
      calc
        _ ≤ ∑ _K : Fin P, (0 : ℝ) :=
          Finset.sum_le_sum (fun K _ => hnone K)
        _ = 0 := by simp
    linarith
  obtain ⟨K, hK⟩ := hexists
  have hmem : primitiveEvaluationDualNormSq P N K ∈ primitiveDualValues P N := by
    unfold primitiveDualValues
    exact Finset.mem_image.mpr ⟨K, Finset.mem_univ _, rfl⟩
  have hle := Finset.le_max' (s := primitiveDualValues P N)
    (x := primitiveEvaluationDualNormSq P N K) hmem
  exact lt_of_lt_of_le hK hle

theorem primitiveAmplificationSquared_bracket {P N : ℕ} [NeZero P]
    (hN : 2 ≤ N) (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    reducedDenominatorTotal P N ≤ primitiveAmplificationSquared P N ∧
      primitiveAmplificationSquared P N ≤ 4 * reducedDenominatorTotal P N := by
  classical
  have hPpos : (0 : ℝ) < P := by exact_mod_cast (NeZero.pos P)
  have hsumlower := primitiveEvaluationDualNormSq_period_sum_lower hperiod
  have hpoint (K : Fin P) :
      primitiveEvaluationDualNormSq P N K ≤ primitiveAmplificationSquared P N := by
    have hmem : primitiveEvaluationDualNormSq P N K ∈ primitiveDualValues P N := by
      unfold primitiveDualValues
      exact Finset.mem_image.mpr ⟨K, Finset.mem_univ _, rfl⟩
    exact Finset.le_max' (s := primitiveDualValues P N)
      (x := primitiveEvaluationDualNormSq P N K) hmem
  have hsummax :
      (∑ K : Fin P, primitiveEvaluationDualNormSq P N K) ≤
        (P : ℝ) * primitiveAmplificationSquared P N := by
    calc
      _ ≤ ∑ _K : Fin P, primitiveAmplificationSquared P N :=
        sum_le_sum fun K _ => hpoint K
      _ = _ := by simp [Finset.sum_const, nsmul_eq_mul]
  have hlowerMul : (P : ℝ) * reducedDenominatorTotal P N ≤
      (P : ℝ) * primitiveAmplificationSquared P N := le_trans hsumlower hsummax
  have hlower : reducedDenominatorTotal P N ≤ primitiveAmplificationSquared P N :=
    (mul_le_mul_iff_of_pos_left hPpos).mp hlowerMul
  have hupper : primitiveAmplificationSquared P N ≤
      4 * reducedDenominatorTotal P N := by
    unfold primitiveAmplificationSquared primitiveDualValues
    apply Finset.max'_le
    intro y hy
    rcases Finset.mem_image.mp hy with ⟨K, hK, rfl⟩
    exact primitiveEvaluationDualNormSq_le_four_total K hperiod
  exact ⟨hlower, hupper⟩

private theorem integerCenteredPrimitive_abs_le_amplification
    {P N : ℕ} [NeZero P] (a : ℕ → ℝ) (K : Fin P) (hN : 2 ≤ N)
    (hperiod : ∀ j ∈ Icc 2 N, j ∣ P) :
    |Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K)| ≤
      primitiveAmplification P N * Real.sqrt
        (centeredCesaroEnergy P N (fun j => (a j : ℂ))) := by
  have hQnonneg : 0 ≤ centeredCesaroEnergy P N (fun j => (a j : ℂ)) := by
    unfold centeredCesaroEnergy
    apply mul_nonneg
    · positivity
    · exact sum_nonneg fun k _ => Complex.normSq_nonneg _
  have hMpos := primitiveAmplificationSquared_pos hN hperiod
  have hMnonneg := le_of_lt hMpos
  have hEvalSq :
      (Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K)) ^ 2 ≤
        centeredCesaroEnergy P N (fun j => (a j : ℂ)) *
          primitiveEvaluationDualNormSq P N K := by
    rw [integerCenteredPrimitive_eq_reducedPrimitiveEvaluation a K hN hperiod,
      centeredCesaroEnergy_eq_reducedCoordinateEnergy a hN hperiod]
    exact reducedPrimitiveEvaluation_sq_le_dualNormSq
      (fun q => reducedShellCoordinate N (fun j => a j / (j : ℝ)) q) K hperiod
  have hmem : primitiveEvaluationDualNormSq P N K ∈ primitiveDualValues P N := by
    unfold primitiveDualValues
    exact Finset.mem_image.mpr ⟨K, Finset.mem_univ _, rfl⟩
  have hpoint : primitiveEvaluationDualNormSq P N K ≤ primitiveAmplificationSquared P N :=
    Finset.le_max' (s := primitiveDualValues P N)
      (x := primitiveEvaluationDualNormSq P N K) hmem
  have hsq :
      (Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K)) ^ 2 ≤
        (primitiveAmplification P N * Real.sqrt
          (centeredCesaroEnergy P N (fun j => (a j : ℂ)))) ^ 2 := by
    calc
      _ ≤ centeredCesaroEnergy P N (fun j => (a j : ℂ)) *
          primitiveEvaluationDualNormSq P N K := hEvalSq
      _ ≤ centeredCesaroEnergy P N (fun j => (a j : ℂ)) *
          primitiveAmplificationSquared P N :=
            mul_le_mul_of_nonneg_left hpoint hQnonneg
      _ = _ := by
            rw [primitiveAmplification, mul_pow, Real.sq_sqrt hMnonneg,
              Real.sq_sqrt hQnonneg]
            ring
  have hrhs : 0 ≤ primitiveAmplification P N * Real.sqrt
      (centeredCesaroEnergy P N (fun j => (a j : ℂ))) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  have habsSq :
      |Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K)| ^ 2 ≤
        (primitiveAmplification P N * Real.sqrt
          (centeredCesaroEnergy P N (fun j => (a j : ℂ)))) ^ 2 := by
    simpa [sq_abs] using hsq
  by_contra hnot
  have hlt : primitiveAmplification P N * Real.sqrt
      (centeredCesaroEnergy P N (fun j => (a j : ℂ))) <
        |Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K)| :=
    lt_of_not_ge hnot
  have hpos : 0 < |Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K)| +
      primitiveAmplification P N * Real.sqrt
        (centeredCesaroEnergy P N (fun j => (a j : ℂ))) := by
    have := abs_nonneg (Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K))
    linarith
  have hprod : 0 <
      (|Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K)| -
        primitiveAmplification P N * Real.sqrt
          (centeredCesaroEnergy P N (fun j => (a j : ℂ))) ) *
      (|Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K)| +
        primitiveAmplification P N * Real.sqrt
          (centeredCesaroEnergy P N (fun j => (a j : ℂ)))) :=
    mul_pos (by linarith) hpos
  have habsSq' :
      |Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K)| ^ 2 ≤
        (primitiveAmplification P N * Real.sqrt
          (centeredCesaroEnergy P N (fun j => (a j : ℂ)))) ^ 2 := habsSq
  nlinarith

private theorem realCenteredPrimitivePrefix_succ
    {P N : ℕ} [NeZero P] (a : ℕ → ℝ) (K : Fin P) :
    realCenteredPrimitivePrefix P N a (K.val + 1) (Nat.succ_le_of_lt K.isLt) =
      realCenteredPrimitivePrefix P N a K.val (Nat.le_of_lt K.isLt) +
        realCenteredShellSection P N a K := by
  unfold realCenteredPrimitivePrefix
  rw [Fin.sum_univ_castSucc]
  simp [realCenteredShellSection]

/-- The finite dual maximum is exactly the supremum over nonzero real shell
coefficients and every point in their continuous, piecewise-affine primitive.
The first conjunct is the universal normalized bound; the second supplies a
nonzero extremizing shell and endpoint, so this bound is attained. -/
theorem primitiveAmplification_is_actual_shell_supremum
    {P N : ℕ} [NeZero P] (hN : 2 ≤ N)
    (hperiod : ∀ j ∈ Icc 2 N, j ∣ P) :
    (∀ (a : ℕ → ℝ) (K : Fin P) (θ : ℝ), 0 ≤ θ → θ ≤ 1 →
      |finiteCellPrimitive P (realCenteredShellSection P N a) K θ| ≤
        primitiveAmplification P N * Real.sqrt
          (centeredCesaroEnergy P N (fun j => (a j : ℂ)))) ∧
    ∃ (a : ℕ → ℝ) (K : Fin P),
      0 < centeredCesaroEnergy P N (fun j => (a j : ℂ)) ∧
        |finiteCellPrimitive P (realCenteredShellSection P N a) K 0| /
          Real.sqrt (centeredCesaroEnergy P N (fun j => (a j : ℂ))) =
            primitiveAmplification P N := by
  classical
  constructor
  · intro a K θ hθ0 hθ1
    have hcell := finiteCellPrimitive_abs_le_endpoints
      (realCenteredShellSection P N a) K θ hθ0 hθ1
    have hleftEq :
        (∑ k : Fin K.val, realCenteredShellSection P N a
          ⟨k.val, Nat.lt_trans k.isLt K.isLt⟩) =
          Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K) := by
      calc
        _ = realCenteredPrimitivePrefix P N a K.val (Nat.le_of_lt K.isLt) := by rfl
        _ = _ := realCenteredPrimitivePrefix_eq_integer a K
    have hleft := integerCenteredPrimitive_abs_le_amplification a K hN hperiod
    have hleftBound :
        |∑ k : Fin K.val, realCenteredShellSection P N a
          ⟨k.val, Nat.lt_trans k.isLt K.isLt⟩| ≤
          primitiveAmplification P N * Real.sqrt
            (centeredCesaroEnergy P N (fun j => (a j : ℂ))) := by
      rw [hleftEq]
      exact hleft
    have hrightPrefix :
        (∑ k : Fin K.val, realCenteredShellSection P N a
          ⟨k.val, Nat.lt_trans k.isLt K.isLt⟩) + realCenteredShellSection P N a K =
          realCenteredPrimitivePrefix P N a (K.val + 1)
            (Nat.succ_le_of_lt K.isLt) := by
      rw [realCenteredPrimitivePrefix_succ]
      rfl
    have hrightBound :
        |(∑ k : Fin K.val, realCenteredShellSection P N a
          ⟨k.val, Nat.lt_trans k.isLt K.isLt⟩) + realCenteredShellSection P N a K| ≤
          primitiveAmplification P N * Real.sqrt
            (centeredCesaroEnergy P N (fun j => (a j : ℂ))) := by
      rw [hrightPrefix]
      by_cases hlt : K.val + 1 < P
      · let K' : Fin P := ⟨K.val + 1, hlt⟩
        have hprefix : realCenteredPrimitivePrefix P N a (K.val + 1)
            (Nat.succ_le_of_lt K.isLt) =
            realCenteredPrimitivePrefix P N a K'.val (Nat.le_of_lt K'.isLt) := by
          rfl
        rw [hprefix, realCenteredPrimitivePrefix_eq_integer]
        exact integerCenteredPrimitive_abs_le_amplification a K' hN hperiod
      · have hEqP : K.val + 1 = P := by omega
        have hprefixZero : realCenteredPrimitivePrefix P N a (K.val + 1)
            (Nat.succ_le_of_lt K.isLt) = 0 := by
          simpa only [hEqP] using realCenteredPrimitivePrefix_period_zero a
        rw [hprefixZero]
        have hnonneg : 0 ≤ primitiveAmplification P N * Real.sqrt
            (centeredCesaroEnergy P N (fun j => (a j : ℂ))) :=
          mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
        simpa using hnonneg
    have hbound := max_le hleftBound hrightBound
    exact le_trans hcell hbound
  · have hMpos := primitiveAmplificationSquared_pos hN hperiod
    have hmaxmem : primitiveAmplificationSquared P N ∈ primitiveDualValues P N := by
      unfold primitiveAmplificationSquared
      exact Finset.max'_mem _ _
    rcases Finset.mem_image.mp hmaxmem with ⟨K, hK, hKM⟩
    obtain ⟨a, henergy, heval⟩ :=
      integerCenteredPrimitive_dualNormSq_attained_by_shell K hN hperiod
    have henergy' : centeredCesaroEnergy P N (fun j => (a j : ℂ)) =
        primitiveAmplificationSquared P N := henergy.trans hKM
    have heval' : Complex.re (integerCenteredPrimitive P N
        (fun j => (a j : ℂ)) K) = -primitiveAmplificationSquared P N := by
      calc
        _ = -primitiveEvaluationDualNormSq P N K := heval
        _ = -primitiveAmplificationSquared P N := by rw [hKM]
    have hcell : finiteCellPrimitive P (realCenteredShellSection P N a) K 0 =
        Complex.re (integerCenteredPrimitive P N (fun j => (a j : ℂ)) K) := by
      unfold finiteCellPrimitive
      simp only [zero_mul, add_zero]
      calc
        _ = realCenteredPrimitivePrefix P N a K.val (Nat.le_of_lt K.isLt) := by rfl
        _ = _ := realCenteredPrimitivePrefix_eq_integer a K
    refine ⟨a, K, ?_, ?_⟩
    · rw [henergy']
      exact hMpos
    · rw [hcell, heval', abs_neg, abs_of_pos hMpos]
      rw [henergy', primitiveAmplification]
      have hrootpos : 0 < Real.sqrt (primitiveAmplificationSquared P N) :=
        Real.sqrt_pos.2 hMpos
      apply (div_eq_iff (ne_of_gt hrootpos)).2
      nlinarith [Real.sq_sqrt (le_of_lt hMpos)]

theorem primitiveAmplification_bracket {P N : ℕ} [NeZero P]
    (hN : 2 ≤ N) (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    Real.sqrt (reducedDenominatorTotal P N) ≤ primitiveAmplification P N ∧
      primitiveAmplification P N ≤ 2 * Real.sqrt (reducedDenominatorTotal P N) := by
  have hbounds := primitiveAmplificationSquared_bracket hN hperiod
  have hSnonneg := reducedDenominatorTotal_nonneg (P := P) (N := N)
  constructor
  · exact Real.sqrt_le_sqrt hbounds.1
  · calc
      primitiveAmplification P N ≤ Real.sqrt (4 * reducedDenominatorTotal P N) :=
        Real.sqrt_le_sqrt hbounds.2
      _ = 2 * Real.sqrt (reducedDenominatorTotal P N) := by
        rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4)]
        norm_num

theorem primitiveAmplificationSquared_cubic_bounds {P N : ℕ} [NeZero P]
    (hN : 2 ≤ N) (hperiod : ∀ q ∈ Icc 2 N, q ∣ P) :
    (N : ℝ) ^ 3 / 1296 ≤ primitiveAmplificationSquared P N ∧
      primitiveAmplificationSquared P N ≤ (2 / 3) * (N : ℝ) ^ 3 := by
  have hS := reducedDenominatorTotal_cubic_bounds hN hperiod
  have hA := primitiveAmplificationSquared_bracket hN hperiod
  constructor
  · exact le_trans hS.1 hA.1
  · calc
      primitiveAmplificationSquared P N ≤ 4 * reducedDenominatorTotal P N := hA.2
      _ ≤ 4 * ((N : ℝ) ^ 3 / 6) := by nlinarith [hS.2]
      _ = (2 / 3) * (N : ℝ) ^ 3 := by ring

