    {
      "object_id": "mathia_synthesis_ee4c934b5f5abebe0c5b65313b985d46bd744d1925a81705a8a00c7a88802bb2",
      "object_role": "synthesis",
      "proposed_content": "For the normalized four-term recurrence, C=3 is a common boundary across three representations: it is included in the proved C>=3 real-zero/interlacing regime, it is the degenerate endpoint obtained by limiting the positive-density contour formula, and its initial Hankel determinants match the tabulated vertically symmetric ASM counts.",
