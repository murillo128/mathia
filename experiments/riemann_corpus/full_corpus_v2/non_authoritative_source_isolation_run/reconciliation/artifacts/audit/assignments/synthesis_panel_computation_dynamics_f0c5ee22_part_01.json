    {
      "object_id": "mathia_synthesis_2eee81e4551b35099edbfd1b56618525d40bf21a2f13c3f3cac95227e5b645a6",
      "object_role": "synthesis",
      "proposed_content": "Finite-height critical-line verification composes two logically distinct certificates: an exhaustive multiplicity count for a bounded region and enough distinct critical-line sign-change witnesses to match that count. Equality closes the completeness gap. Endpoint extensions, targeted reruns, cross-machine checks, and overlaps audit the numerical realization, but they do not replace the count-versus-witness closure.",
