    {
      "object_id": "mathia_synthesis_c2bfcd5d1ebc1fe05504ec436a30d1fcee5d139c9c7784ff7b061b9e81e1029f",
      "object_role": "synthesis",
      "proposed_content": "Method rankings depend on the actual proof workload. A cheap surrogate can reverse the ranking produced by the downstream zero-free constant, batch precomputation can improve throughput without reducing singleton latency, and a search order successful on common short Gram blocks can become inefficient on rarer long blocks. Optimization should therefore be conditioned on the certificate objective, query regime, or block class actually encountered.",
