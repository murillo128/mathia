    {
      "object_id": "mathia_synthesis_7399c15cb67307acc269bdfd5db38d17582aed2545ee1cca12d1d95883783fcd",
      "object_role": "synthesis",
      "proposed_content": "When the downstream claim depends only on a root count or on whether all roots are real, a computation can retain that decision statistic instead of reconstructing every root coordinate. The zeta implementation stops after a certified sign change is counted, while the Jensen-polynomial implementation uses a Sturm count to decide whether the real-root total falls short of the degree.",
