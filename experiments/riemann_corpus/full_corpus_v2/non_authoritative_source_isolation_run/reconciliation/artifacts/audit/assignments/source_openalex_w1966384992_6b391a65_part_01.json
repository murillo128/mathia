    {
      "object_id": "mathia_synthesis_c99b2bcc0efb52e4b279108ce60e8e1b6c8b78b165295b324e4b84c0715aff64",
      "object_role": "synthesis",
      "proposed_content": "Continuation uniqueness changes with the scalar component category: on the bicomplex product of punctured complex planes, complex-component holomorphicity and the identity theorem make the continuation unique, whereas restriction to real idempotent components with the source's D-holomorphic difference quotient permits a distinct continuation agreeing with the Dirichlet series on its original domain.",
