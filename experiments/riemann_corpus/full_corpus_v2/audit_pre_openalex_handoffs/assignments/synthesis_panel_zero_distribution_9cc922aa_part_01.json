    {
      "object_id": "mathia_synthesis_7094cebb7b2c74da6f4dbe930ba53768783c8cf2c2f63911589c550852e33eab",
      "object_role": "synthesis",
      "proposed_content": "The common pipeline is typed: replace the target zero statistic by an auxiliary zero count, bound that count through Littlewood or Jensen by a shifted mollified mean square, and reduce the mean square to an explicit quadratic objective. Mollifier profiles and differential coefficients can then be varied subject to their admissibility and length constraints to improve differently defined zero proportions.",
