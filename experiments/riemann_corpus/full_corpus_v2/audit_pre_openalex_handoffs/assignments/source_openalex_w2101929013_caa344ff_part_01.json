    {
      "object_id": "mathia_interpretation_96d8a91d593f6f970ba982ee3188189857e20c4ddf78491221ba061d3b1574d8",
      "object_role": "interpretation",
      "proposed_content": "The theorem identifies a one-sided observable consequence of the proposed mechanism without claiming the full asymptotic. This is useful calibration: the resonant profile is provably visible, but current control does not squeeze counts from both sides sharply enough.",
