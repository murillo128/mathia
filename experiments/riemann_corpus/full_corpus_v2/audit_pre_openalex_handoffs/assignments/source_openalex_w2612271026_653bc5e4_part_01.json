    {
      "object_id": "mathia_synthesis_f9d1275d7d152eda51699e2fa539deaa78af85d51c543cec6d15169968c17e87",
      "object_role": "synthesis",
      "proposed_content": "The partition-versus-subset mismatch in the two-swap correlation calculation is resolved by a matching redundancy in the factorized shift equations. Decompositions of A,B select the same fixed two-element swap many times, while divisor rescalings give equally many equivalent coordinate descriptions of the underlying paired equations; quotienting by this matched multiplicity leaves one recipe copy.",
