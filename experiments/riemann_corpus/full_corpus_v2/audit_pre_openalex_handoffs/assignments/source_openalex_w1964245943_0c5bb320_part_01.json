    {
      "object_id": "mathia_synthesis_4e773742881a89377a1d244993df5a95be140bf006bd9da382f9e6ff2bd6b211",
      "object_role": "synthesis",
      "proposed_content": "The symmetric convergence convention first makes the transformed multiset coefficients legitimate; the half-plane theorem then turns any point beyond the boundary into finitely many dominant transformed terms whose phases can be aligned to force exponentially large negative values, and conjugation plus functional-equation reflection supplies the mirrored containment needed to replace the one-sided half-plane conclusion by critical-line equality.",
