    {
      "object_id": "mathia_synthesis_e0686f95090d8074eb911d7a27f9a04c77c28cda0843942c8e7da3572f75536b",
      "object_role": "synthesis",
      "proposed_content": "Compact Fourier support limits a zero-difference statistic to frequencies for which arithmetic information is available. In pair correlation this keeps the associated Dirichlet polynomial within the range where diagonal Parseval errors are subordinate; in an n-level calculation, strict support slack bounds prime-power products tightly enough that approximate multiplicative balance contradicts integer spacing unless the two products are exactly equal.",
