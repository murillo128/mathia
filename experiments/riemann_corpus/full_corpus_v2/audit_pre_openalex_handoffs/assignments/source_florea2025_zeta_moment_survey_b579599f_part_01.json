    {
      "object_id": "mathia_synthesis_83b22e59d76f2b4bfd409bde8a1d60c062f3f614cadca9420bb44c6ff55f7f65",
      "object_role": "synthesis",
      "proposed_content": "The survey connects distributional averages to pointwise control through moment order, and its upper-bound proofs make that connection effective by replacing log|ζ| with prime Dirichlet polynomials whose typical ranges are estimated directly while rare large ranges are isolated as exceptional sets.",
