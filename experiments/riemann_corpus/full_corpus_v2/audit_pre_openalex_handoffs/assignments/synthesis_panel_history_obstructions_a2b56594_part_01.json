    {
      "object_id": "mathia_synthesis_7801224920170208b5edf68034670a69ed43ab766726ae75bcc9df93e4c6aa23",
      "object_role": "synthesis",
      "proposed_content": "An exhaustive finite zero census yields only a bounded-height statement unless a separate theorem transfers that finite premise to another global quantity. In the 2021 example, the achieved verification height crosses a published heat-flow threshold and therefore yields the unconditional but weaker conclusion Lambda<=0.2.",
