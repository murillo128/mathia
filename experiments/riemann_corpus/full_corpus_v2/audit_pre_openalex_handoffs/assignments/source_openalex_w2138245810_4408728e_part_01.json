    {
      "object_id": "mathia_interpretation_1e09273542ad4a2e0d9695ead1721054c4726d40155c5eff6c866ed7fc138504",
      "object_role": "interpretation",
      "proposed_content": "Exterior saddle tails regain quadratic structure after two contour choices. Rotating y creates decay; rotating x according to the quadratic sign leaves one growing half-line, which is written as a full Gaussian line minus a decaying complement. The Gaussian is explicit and the complement truncates to incomplete-gamma and weighted quadratic sums.",
