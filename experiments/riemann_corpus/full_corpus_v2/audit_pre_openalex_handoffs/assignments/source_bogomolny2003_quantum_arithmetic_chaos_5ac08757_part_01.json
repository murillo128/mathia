    {
      "object_id": "mathia_synthesis_ce29e63fb78201aa1b0ecddccc288953f291f9c33a82f8478d6228fbcc1f9ce7",
      "object_role": "synthesis",
      "proposed_content": "The resolvent trace is the common carrier, but its mathematical status changes with the available geometry. For Euclidean and hyperbolic quotients, a free Green kernel can be summed over discrete-group images; quotient identifications and then conjugacy classes turn group elements into primitive lengths and repetitions, producing exact smoothed rectangle and Selberg trace identities. For a generic Hamiltonian without that image construction, the long-path Green kernel is only semiclassical, and tracing it plus stationary phase selects periodic orbits and yields the asymptotic Gutzwiller formula.",
      "parent_sources": [
        {
          "source_object_id": "mathia_source_b3b20d8859a4d8eee2e7cd7d73ea132fa18a2b6ff135e17f74c11cce1bd0358d",
          "source_id": "bogomolny2003_quantum_arithmetic_chaos",
          "source_unit_ids": [
            "bogomolny2003_quantum_arithmetic_chaos_v2u03"
          ],
          "content_ref": "artifact://riemann-corpus-v2/depth/units/bogomolny2003_quantum_arithmetic_chaos_v2u03.txt",
          "source_title": "Quantum and Arithmetical Chaos",
          "source_year": 2003,
          "source_type": "advanced-lecture-notes",
          "viewpoint_tags": [
            "spectral-physics",
            "zero-statistics-random-matrix",
            "trace-formula",
            "selberg"
