    {
      "object_id": "mathia_synthesis_fa4d8e75e94d79df8891816834211181f16031b107cff2433f5b46b9287e6b59",
      "object_role": "synthesis",
      "proposed_content": "After unfolding ordinates to remove changing mean density, zeta-zero correlations can be compared with random Hermitian spectra; that statistical match supplies a conjecture dictionary for spacing and moments, known moment cases and high-zero computations calibrate it, and function fields provide a related setting where some RMT-suggested results become theorems.",
