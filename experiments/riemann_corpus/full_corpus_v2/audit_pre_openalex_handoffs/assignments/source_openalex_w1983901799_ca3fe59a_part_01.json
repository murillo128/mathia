    {
      "object_id": "mathia_interpretation_bf40c7b8d8ba7a87cd2e7f409f972d87a5afd795bbaa6602cdb80ef54b4984c1",
      "object_role": "interpretation",
      "proposed_content": "A finite exceptional set is stable under differentiation because the infinite regular real-zero population controls the asymptotic sign. Local exceptions cannot compete with a cumulative logarithmic contribution.",
