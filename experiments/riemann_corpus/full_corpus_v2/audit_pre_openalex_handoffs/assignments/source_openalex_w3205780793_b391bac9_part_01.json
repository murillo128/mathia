    {
      "object_id": "mathia_synthesis_2e13d23d97b5dfd0512530282c691b5ba1f70e31c35806b4d5d41de47fe13b95",
      "object_role": "synthesis",
      "proposed_content": "No qualifying cross-unit synthesis is established: the claimed perturbative survival of the Mobius-weighted Baez-Duarte approximants, including the variance-controlled low-frequency estimate, zeta-controlled high-frequency estimate, and tuned cutoff, is already stated and proved within unit u06.",
