    {
      "object_id": "mathia_synthesis_b6d342ca7cdfddb348769ce195fc30e7837ad3f77213e637ebe3fa8ee7949903",
      "object_role": "synthesis",
      "proposed_content": "For zeta, the functional equation pairs the divergent long tail with conjugates of the early Dirichlet terms at the stationary cutoff, yielding a finite real main sum. For a Hermitian quantum problem, reality of the spectral determinant plays the analogous role: after reorganizing primitive orbits into composite pseudo-orbits, analytic continuation pairs contributions across half the Heisenberg time to give a finite real determinant formula. Abrupt cutoffs in both representations create discontinuities, motivating local Riemann-Siegel corrections on the zeta side and an Erfc-smoothed transition that also transfers to the quantum determinant.",
      "parent_sources": [
        {
          "source_object_id": "mathia_source_829965a8708aac8da59b52a94e9f449a3c87fd59c5de57d78485e5463d4b172a",
          "source_id": "openalex_w1991057622",
          "source_unit_ids": [
            "openalex_w1991057622_v2_u15"
          ],
          "content_ref": "artifact://riemann-corpus-v2/depth/units/openalex_w1991057622_v2_u15.txt",
