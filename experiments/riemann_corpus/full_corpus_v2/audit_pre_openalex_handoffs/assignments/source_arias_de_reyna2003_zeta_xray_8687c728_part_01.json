    {
      "object_id": "mathia_synthesis_faeeb8023ca8df5fc811cc26d8fe74045ea2f448a2eb476549d4a7901cb462c2",
      "object_role": "synthesis",
      "proposed_content": "Gram points form a phase mesh whose usual alternating Hardy signs locally bracket zeros, but neighboring empty and double intervals show that cell-by-cell allocation is unstable. Conditional on RH, matching a Gram point and a zero through their common sheet replaces this failed local adjacency rule with a global pairing that absorbs compensating defects; Lehmer-pair geometry illustrates how near-degenerate routing can be highly sensitive without producing an actual off-line zero.",
      "parent_sources": [
