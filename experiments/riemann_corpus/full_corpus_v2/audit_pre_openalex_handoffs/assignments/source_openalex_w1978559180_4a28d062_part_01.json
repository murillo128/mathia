    {
      "object_id": "mathia_synthesis_b8754ba1a1e444176d9c98f41ab06ccf2f0ead62a04e08ced0a30bbb0108159b",
      "object_role": "synthesis",
      "proposed_content": "The verified-height and zero-free-region splice supplies an improved theta-error envelope for the asymptotic regime; overlapping finite-range estimates and reported low-range verification extend that envelope to every x at least 149; the partial-summation identity then carries it into an explicit pi-minus-li bound, with the remaining range compressed to reported checks at prime-interval endpoints.",
