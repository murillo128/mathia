    {
      "object_id": "mathia_synthesis_d2b1724a58fc862eddf7d8e2dbcb88c03e6a7b811914ec1f6072cfd76909fc32",
      "object_role": "synthesis",
      "proposed_content": "A multiple real zero is translated into two complementary local certificates: an arbitrarily small backward deformation violates a necessary Laguerre-Polya inequality, while a small forward deformation of a double zero produces nearby simple real zeros. Coupled with the threshold characterization, this makes a multiple-zero time a certificate on the lower-bound side of the real-rootedness boundary and yields simplicity strictly above that boundary.",
