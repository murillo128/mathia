    {
      "object_id": "mathia_interpretation_3be2d8a1373cbaf7f27fdd01af12ba33bd51936da6870aa8b531685ba1b3b8a8",
      "object_role": "interpretation",
      "proposed_content": "The detector localizes the zero problem: nearby zeros appear explicitly with sign, while the rest of the analytic function is represented by boundary growth. It is an exact decomposition designed so available growth estimates can be traded against the hypothesized zero.",
