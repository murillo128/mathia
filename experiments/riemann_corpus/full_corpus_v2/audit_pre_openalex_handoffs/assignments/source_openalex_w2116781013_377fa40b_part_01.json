    {
      "object_id": "mathia_synthesis_f8341ff65b7963e9d27883327e6120f504a8fd78cef3c970e5cffd3d4359db5e",
      "object_role": "synthesis",
      "proposed_content": "Observed Gram-block and Rosser-exception statistics are jointly conditional on two distinct algorithmic choices: shifted evaluation points can change which exceptions are detected or how they are classified, while an outer-interval-first separation strategy is well matched to blocks of lengths two through five but becomes mismatched for longer blocks as the missing zeros move inward. Comparisons of coverage or efficiency therefore need the evaluation protocol, search policy, block-length mixture, and range as provenance.",
