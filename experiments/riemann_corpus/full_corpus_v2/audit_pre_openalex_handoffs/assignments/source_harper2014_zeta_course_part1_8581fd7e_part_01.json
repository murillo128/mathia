    {
      "object_id": "mathia_synthesis_fee7e3ba4aa7d06f84e65b0f08c8c0b16895422c18db0e759356c0694c4326b6",
      "object_role": "synthesis",
      "proposed_content": "Truncated Perron inversion fixes the interface from -zeta'/zeta to Psi and makes T the resolution parameter; the zero-free width and matching logarithmic-derivative bounds then determine how far that same contour can move, so balancing shifted-line decay against truncation converts a wider zero-free region into a sharper prime-counting error scale.",
