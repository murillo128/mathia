    {
      "object_id": "mathia_synthesis_b49f92296ed2d24c91cb9f33083b1b6cd1bc822a071af874ee89e6c07b0823a5",
      "object_role": "synthesis",
      "proposed_content": "Unfolding an automorphic average maps its constant or scalar projection to a Mellin–Eisenstein object whose contour singularities can produce zeta-zero-indexed exponents or residues. Those terms are observable-dependent: an explicit theta example annihilates every zero coefficient, whereas a regularized scalar CFT projection retains zero poles, so ambient spectral availability alone does not ensure detection.",
      "parent_sources": [
        {
