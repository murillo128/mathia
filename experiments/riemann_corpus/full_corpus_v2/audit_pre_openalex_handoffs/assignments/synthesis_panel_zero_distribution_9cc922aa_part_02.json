    {
      "object_id": "mathia_synthesis_8a08ecdd63e596fd8d460cb86609e597e886f154fb743bfa507de81dee5c47b0",
      "object_role": "synthesis",
      "proposed_content": "Close-pair factorization gives a microscopic map from an unfolded zeta-zero gap, through the logarithmic-derivative background field, to a nearby derivative zero. Littlewood boundary integrals instead summarize derivative zeros macroscopically by horizontal-displacement moments. These are complementary resolutions of derivative-zero geometry, not the same statistic or a derivation of one from the other.",
