    {
      "object_id": "mathia_synthesis_5c6fd65d81c0e717b218304c2831b9d5292b5d794993594142b616a426e9c032",
      "object_role": "synthesis",
      "proposed_content": "Zeros of zeta-prime mark where oriented level-set trajectories can change their local continuation: regular monotone arcs become multi-branch switch points, constant-argument separatrices form the proposed Speiser obstruction, and near-real critical values explain exact or near partner changes in the plotted Lehmer geometry.",
