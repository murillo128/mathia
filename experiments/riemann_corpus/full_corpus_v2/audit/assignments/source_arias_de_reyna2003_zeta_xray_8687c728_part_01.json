    {
      "object_id": "mathia_synthesis_fd8a5a1c635ba03ddb02d3f665d4e8d8c54656dc195744c9a302a04d86defdf3",
      "object_role": "synthesis",
      "proposed_content": "A crossing-capacity constraint converts unequal populations of level curves into paired returning components, or sheets; monotone real values then give each sheet a unique zero, so whether every such component meets the critical line becomes a global connectivity formulation of RH.",
