    {
      "object_id": "mathia_synthesis_f1850b0fbde8746284eff3346c66b6a562ff8921c68e5b13e5a16a3c5f329509",
      "object_role": "synthesis",
      "proposed_content": "The numerical pipeline has separable speed and trust layers: phase normalization makes critical-line zeta real and a short Riemann–Siegel sum quickly exposes sign changes, Euler–MacLaurin supplies a slower continuation with controllable remainder for small sign margins, and sampled continuation of those values into plotted level curves remains computational evidence rather than proof.",
