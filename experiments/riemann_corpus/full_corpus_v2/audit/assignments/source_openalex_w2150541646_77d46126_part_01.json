    {
      "object_id": "mathia_synthesis_46eb6e916eaf6746e26b0a9610dedce41651f8a95744af5baaf3b401ad6c9ef5",
      "object_role": "synthesis",
      "proposed_content": "Reflection parity filters the differentiated integer sum to a rational linear form supported on a bounded band of odd zeta values, and the cotangent residue kernel then preserves that already filtered sum while changing it into a vertical contour integral. Thus later contour deformation and saddle estimation operate on a representation whose arithmetic support was fixed before the asymptotic analysis.",
