    {
      "object_id": "mathia_interpretation_5dadb56eb6a06b76123ba2d3924b6ee18b6d19c92bf8ce4981d2ff807d4bad6b",
      "object_role": "interpretation",
      "proposed_content": "Amplification converts an auxiliary commuting spectrum into a selector. The gain comes from coherent spectral response of the target exceeding the geometric cost of many correspondences, quantified by a lattice near-return problem.",
