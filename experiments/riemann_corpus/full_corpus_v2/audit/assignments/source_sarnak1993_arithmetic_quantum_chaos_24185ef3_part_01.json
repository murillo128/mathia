    {
      "object_id": "mathia_interpretation_79adc0c0d048faadec43a08bda60c20cbfb10232474abab7c5b3f65fe135831d",
      "object_role": "interpretation",
      "proposed_content": "This is a representation change from trajectories in phase space to spectral data. It makes correspondence with classical flow testable through asymptotic eigenvalues and eigenfunctions rather than by following quantum states directly.",
