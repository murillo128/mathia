    {
      "object_id": "mathia_interpretation_6be241e908a8901f690b63cb85f94fbd390a895fdfea1fa8336654d4afa1ac0b",
      "object_role": "interpretation",
      "proposed_content": "Keeping multiplicity and correlation statistics separate avoids treating a simple spectrum as automatically rigid or random-matrix-like. The stadium also shows how a local universal fit can coexist with long-range dynamical structure.",
