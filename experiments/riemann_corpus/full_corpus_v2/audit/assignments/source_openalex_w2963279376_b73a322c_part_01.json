    {
      "object_id": "mathia_synthesis_90770732ea7f36e3159f527021b6bdfda6791ff8cb13edac1f44accfa0207746",
      "object_role": "synthesis",
      "proposed_content": "The added one-prime divisor polynomial is not handled as an undifferentiated perturbation: expanding products sorts correction terms by whether a marked prime appears on one or both coefficient factors, whether prime indices coincide, and whether the shift k -> pk adds a new divisor. Those incidence classes are then mapped, term by term, through the same divisor-sum asymptotics and logarithmic-coordinate reductions to distinct nested integrals.",
