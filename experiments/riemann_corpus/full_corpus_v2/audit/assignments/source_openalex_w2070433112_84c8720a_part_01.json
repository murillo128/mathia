    {
      "object_id": "mathia_synthesis_0d50ef5bb576a1ecfca7964ecf5b7321195d9f949156a5ca1ef9643f8a27f593",
      "object_role": "synthesis",
      "proposed_content": "The paper redirects the closure problem from explicit Gramian distances for dilates of rho_1 to transport by T_{f'}, whose dilation commutation preserves generated spans and whose L2 boundedness preserves convergence. This makes kernel choice available as a search variable for potentially simpler scalar products without requiring a Mellin nonvanishing condition in the necessity direction.",
