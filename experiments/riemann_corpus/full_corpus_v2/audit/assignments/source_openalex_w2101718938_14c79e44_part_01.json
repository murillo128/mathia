    {
      "object_id": "mathia_synthesis_5290bce9e4bcc55b7aaebc8b2c6a114788ff34fb70090f1ab6684ad0f416e0cd",
      "object_role": "synthesis",
      "proposed_content": "Within a fixed exponent pattern, pairwise exchanges move larger exponents onto smaller primes, while replacing the prime support by consecutive smallest primes produces m(e-bar); together these operations make m(e-bar) both the least integer and the largest sigma(n)/n value in its pattern, so Robin failures transfer to canonical Hardy-Ramanujan representatives.",
