    {
      "object_id": "mathia_synthesis_046b5b6651a80edf93d0e2b2e6d011926cf1b535572aea20878b0c0c4bf537ee",
      "object_role": "synthesis",
      "proposed_content": "Computationally cheaper observation schemes alter the evidence they produce: shifted Gram-point evaluations can miss or reclassify rare exceptions, while screening only selected subranges can recover many exceptions without certifying completeness. The source therefore uses overlap comparisons and explicit sampling provenance as checks on optimization-induced changes, not as incidental bookkeeping.",
