    {
      "object_id": "mathia_synthesis_61028244a12028ea453ba26affd1c8f3dc1cda8965c2f9259769b3ace1a052ad",
      "object_role": "synthesis",
      "proposed_content": "The outer-first search heuristic has a source-measured, block-length-dependent regime: its localized search is effective for lengths two through five, but for longer blocks the missing pair increasingly moves to an interval just inside an outer interval, so interval priority should be conditioned on length rather than extrapolated uniformly.",
