    {
      "object_id": "mathia_interpretation_b72d4d21a6da83f8cb744e13d5f798580e26ae5a3cba15754bf4f92f0bf0ba9d",
      "object_role": "interpretation",
      "proposed_content": "The target is not an unnecessarily accurate value of Z but exclusion of zero from its error enclosure. This supports a cascade: use a cheap approximation when its margin dominates the certified error and escalate precision only near the decision boundary.",
