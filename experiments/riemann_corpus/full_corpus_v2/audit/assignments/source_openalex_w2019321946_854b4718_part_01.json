    {
      "object_id": "mathia_interpretation_553dc01ff5339363eae6de2d46ef734eba8b963324b8ca3200bb889d6a6e13b1",
      "object_role": "interpretation",
      "proposed_content": "This is finite moment matching: exact cancellation is imposed on a growing low-dimensional subspace, and all uncertainty is localized to its orthogonal tail. The boundary corrections repair the two aggregate modes left by the raw Möbius coefficients.",
