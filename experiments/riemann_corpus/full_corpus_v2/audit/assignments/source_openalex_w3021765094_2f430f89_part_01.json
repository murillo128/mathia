    {
      "object_id": "mathia_synthesis_77b71aa8d42e18bd6c89be8c14153f4c777bb10a761ef582cd7bc91af4467144",
      "object_role": "synthesis",
      "proposed_content": "The source derives Franel's discrepancy formula through a sequence of representation changes: squared Farey displacement is expanded in B_1 features, Lemma 7 converts the resulting Bernoulli correlations to generalized Dedekind sums, cyclic relabeling manufactures the three-term reciprocity combination, and its gcd output is reduced by common-divisor extraction and Möbius convolution to lower-dimensional arithmetic sums.",
      "parent_sources": [
        {
          "source_object_id": "mathia_source_3f7d3cd491b2924234ac883a48ed3c7878b2eaf0505b033941766892d0a9c38a",
          "source_id": "openalex_w3021765094",
          "source_unit_ids": [
