    {
      "object_id": "mathia_interpretation_8d9bc5077c3ea5d1f401871f2ae6152896087834343bda0a39357f9a4fdfc9cb",
      "object_role": "interpretation",
      "proposed_content": "The theorem places derivative zeros and ordinary zeta zeros in one common representation: one-sided weighted horizontal-displacement sums over the same height interval, compared up to an O(U) remainder. Aggregate comparison becomes possible, but individual zero locations and the cause of the comparison are not supplied.",
