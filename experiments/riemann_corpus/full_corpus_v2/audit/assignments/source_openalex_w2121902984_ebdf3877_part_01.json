    {
      "object_id": "mathia_interpretation_811e469cd8084c48a122bb777c90726ef021b62b1c73b91db5aede98327bdec9",
      "object_role": "interpretation",
      "proposed_content": "Spectral orthogonality becomes an arithmetic decomposition. The diagonal encodes exact coincidence, while the Kloosterman side retains cross-correlation in a form for which independent cancellation bounds are available.",
      "parent_sources": [
        {
          "source_object_id": "mathia_source_516f0c73d63bd9751461c8bdc2cf410dd1ccd1b1f09ea9866fa706c8e0909841",
