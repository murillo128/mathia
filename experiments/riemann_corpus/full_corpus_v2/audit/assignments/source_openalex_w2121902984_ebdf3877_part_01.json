      "object_id": "mathia_interpretation_88f5c68eccf715313477f2febe75320a36341ddf59a086fed9efa7e90012393a",
      "object_role": "interpretation",
      "proposed_content": "The theta lift changes an opaque analytic value into positive coefficient data, and embedding it in a larger family creates room for averaging and stronger estimates.",
      "parent_sources": [
        {
          "source_object_id": "mathia_source_017e183a9224bf27e00cde09a5638d092e4778ea2997af18d988cf66e0cc6a6e",
