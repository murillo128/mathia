    {
      "object_id": "mathia_synthesis_f25f8ea52d8023ea63ed2e9a8d3bc2e05da6ca20c4c277518b83e04e1da3b661",
      "object_role": "synthesis",
      "proposed_content": "Finite critical-line verification has two noninterchangeable channels: sign changes of a real critical-line function localize odd-order on-line zeros, while argument-principle, Backlund, or Turing-style accounting supplies an independently justified total with multiplicity. Equality of the localized count and the total upgrades sampling evidence to a bounded completeness certificate.",
