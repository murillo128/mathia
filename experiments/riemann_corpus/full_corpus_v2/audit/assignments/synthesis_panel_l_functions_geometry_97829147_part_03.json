    {
      "object_id": "mathia_synthesis_c2b37e461bb7c07d479b24a398b55efefcac7b2d400b9d32bd0373e6b7677c2b",
      "object_role": "synthesis",
      "proposed_content": "Orthogonality is a selector whose output depends on the averaging regime. Character orthogonality supplies independence directions for joint universality and modular diagonals for family moments, while continuous t-averaging approximately selects equal multiplicative frequencies; unique factorization then organizes the exact high-moment diagonal.",
