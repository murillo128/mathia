    {
      "object_id": "mathia_interpretation_960e73a6efa8dc5b2d97c558bff81c345c9647159ecf42c2f4846c1472b19523",
      "object_role": "interpretation",
      "proposed_content": "The case split selects the representation in which the partial sum is controllable. The invariant target is an ensemble fourth-moment bound; what changes is whether the partial sum is approximated directly or mediated by an integral.",
