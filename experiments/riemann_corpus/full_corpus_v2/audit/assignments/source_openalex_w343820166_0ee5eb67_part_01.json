    {
      "object_id": "mathia_synthesis_7e1325c3dfb57222516f0d0b9c1e98b31df8bb1f785f939f2dffbbbd7646caea",
      "object_role": "synthesis",
      "proposed_content": "The contour reduction identifies a critical-line partial-sum quantity as a control point at which the source records several routes: length-dependent representations coupled to fourth moments, direct use of critical-line L-value estimates, and a cited zero-free-region plus functional-equation and convexity argument. These routes retain the intermediate target while changing the analytic input and lead to separately claimed density consequences.",
