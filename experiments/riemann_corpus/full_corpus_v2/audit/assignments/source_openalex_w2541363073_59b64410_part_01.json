    {
      "object_id": "mathia_interpretation_f568a003cb6a88edf85421eb6e23043987085a3a94481a7de8ae8b5792a90b98",
      "object_role": "interpretation",
      "proposed_content": "The auxiliary variables cease to be merely formal because their large-N stationarity obeys the physical eigenangle equation. Splitting one complex saddle produces both the spectral dynamics and the candidate representation boundary.",
