    {
      "object_id": "mathia_interpretation_031c96b8a8b3e1efe5fc9b7b41d9f23654b50db3d98fa7661f858ce6ff1aea08",
      "object_role": "interpretation",
      "proposed_content": "This is a compression by complexification: one object stores phase-dependent spectral geometry in its real part and fixed model input in its imaginary part. Taking different projections exposes different semantics without identifying those semantics with one another.",
