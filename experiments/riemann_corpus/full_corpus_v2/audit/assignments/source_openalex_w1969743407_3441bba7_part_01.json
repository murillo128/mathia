    {
      "object_id": "mathia_synthesis_2556fbe1da7a6cc425818be0daa01916eae25e5e58316e3a39d9df6ff51fd49b",
      "object_role": "synthesis",
      "proposed_content": "Changing from the unitary to the symplectic symmetry class changes the admissible combinatorial representation: arbitrary nonnegative margin tables become symmetric nonnegative tables with even diagonal, and truncation changes prescribed equal margins into upper-bounded capacities within that constrained subspace. The quadratic-character pseudomoment carries the same symplectic constraint through F_k together with a separate arithmetic factor.",
