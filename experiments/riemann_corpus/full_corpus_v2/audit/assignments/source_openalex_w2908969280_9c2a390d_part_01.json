    {
      "object_id": "mathia_synthesis_31bf1828e5cea79fab02fb98aaec844b96b6a38f7a2e871d231c5befce8ba5fc",
      "object_role": "synthesis",
      "proposed_content": "The source connects interval length to three correlation geometries: for negative theta, a common prefix is followed by a shortened branching tree; at theta zero, one full log-correlated tree is visible; for positive theta, the interval contains a forest of approximately independent unit-scale trees. These geometries account for the distinct leading maximum and moment regimes.",
