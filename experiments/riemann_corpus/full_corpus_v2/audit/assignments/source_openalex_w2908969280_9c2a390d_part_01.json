    {
      "object_id": "mathia_synthesis_79497f42e3b03b991811bfd5a79dc01f6a65e63311985d25f184dec51c439fcd",
      "object_role": "synthesis",
      "proposed_content": "The upper and lower moment arguments implement the same constrained entropy-energy optimization. Height contributes beta times the level, high-point abundance supplies the entropy term, and the optimizer moves from an interior height below criticality to the maximal admissible height above criticality, producing the frozen linear branch.",
