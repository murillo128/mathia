    {
      "object_id": "mathia_synthesis_0d45ccb641a917b0a2fb1dd6dfe41c4fa457b1ed1734a8b7c82d13c1cb8456c1",
      "object_role": "synthesis",
      "proposed_content": "The short-interval proof changes certification mode at a scale boundary. A uniform theta-error certificate makes the theta increment over the target interval positive for x>=e^35, while maximal-gap certificates summarize whole finite prime prefixes and are iteratively converted into lower coverage thresholds until a final exhaustive check is small enough to run.",
