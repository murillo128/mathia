    {
      "object_id": "mathia_synthesis_4ee210327660dc77e63554a3a72b4f4be80f14106e09335da7ad42fe1f7f8d52",
      "object_role": "synthesis",
      "proposed_content": "At the operative scale n=10^20, the source prefers Schoenfeld's nominally weaker two-logarithm estimate because its explicit constant is slightly better than the available one-logarithm alternative. That finite-scale choice yields the nearby-prime residual bound 1.615×10^12, which is the quantity that must fit inside the downstream two-prime coverage through 10^13.",
