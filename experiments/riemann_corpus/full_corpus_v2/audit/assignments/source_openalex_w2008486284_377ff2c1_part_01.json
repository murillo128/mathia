    {
      "object_id": "mathia_synthesis_a953ba1088f57f2f7ea5d6d31527bf66c16ee53d7ff263590f086af9024091dc",
      "object_role": "synthesis",
      "proposed_content": "A double-root limit anchors a unique analytic branch of a nearby derivative root. Exchange symmetry makes its complex displacement an even series beginning quadratically in the normalized gap; projecting that branch to radial distance and applying the inverse-map Jacobian to the repulsive CUE spacing density produces the square-root leading density near the unit circle.",
