    {
      "object_id": "mathia_interpretation_407f1090e86f2c4d418529fb6d4ca221cb2359e875edae835e67d9c1fd87c578",
      "object_role": "interpretation",
      "proposed_content": "A moment is controlled by matching the growth of its exponential weight against tail decay. The same balance identifies the saddle-scale band: values far below it carry too little weight and values far above it are too rare.",
