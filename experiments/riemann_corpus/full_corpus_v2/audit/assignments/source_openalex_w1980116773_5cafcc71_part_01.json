    {
      "object_id": "mathia_synthesis_88faee70378799ed9e328c9b60e99f755f12f45207bb8554624c0bd00d1e48c3",
      "object_role": "synthesis",
      "proposed_content": "Across the computational methods, a remainder estimate governs routing: the short Riemann-Siegel evaluation enables broad sign screening, values near its error scale trigger abstention and local mesh refinement, and cases still unresolved are recomputed with the costlier earlier expansion and a smaller remainder.",
