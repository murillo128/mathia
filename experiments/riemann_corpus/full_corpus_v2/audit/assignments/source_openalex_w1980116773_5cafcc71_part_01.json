    {
      "object_id": "mathia_synthesis_ef659344d690149c2129a35cf4ae0850ee8390fdcf433b58cd4e8bd3a0b05289",
      "object_role": "synthesis",
      "proposed_content": "Representing the scan as a sequence of per-Gram-interval root counts turns a binary failure inventory into a spatial displacement account: most empty intervals in the reported range are balanced by an extra root nearby, a smaller class is balanced one interval farther away, and some failures form coupled multi-interval clusters even while the overall failure rate rises.",
