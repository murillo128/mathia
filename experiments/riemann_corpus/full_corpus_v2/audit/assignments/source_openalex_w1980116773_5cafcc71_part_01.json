    {
      "object_id": "mathia_synthesis_85288b416215122ce8a93591d3e0419e6e3fafa22e63942d415fecc0e99dc2fb",
      "object_role": "synthesis",
      "proposed_content": "The broad scan's hardest local certifications arise when the extremum between close roots is too small relative to the approximation error: this shifts attention from failure frequency to amplitude, requires finer sampling and sometimes a more accurate representation, and supplies the observed low maximum that Lehmer later interprets informally as a delicate balance among series terms and uses to motivate targeted distant searches.",
