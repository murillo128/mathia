    {
      "object_id": "mathia_interpretation_ad901ce981ce0ab66638ed412c9e484848ead3f21e79fcc131fddf7dcfc9615e",
      "object_role": "interpretation",
      "proposed_content": "A locally false rule can remain a useful organizing heuristic when its failures have structured displacement. The significant object is therefore not a binary interval success flag alone, but the redistribution of root counts across adjacent intervals.",
