    {
      "object_id": "mathia_synthesis_9a1bfbea08dbe063b31cf6b7c7213439d23a86a0873961c8a04cea7799ef0aaa",
      "object_role": "synthesis",
      "proposed_content": "The cited RH equivalents preserve the same truth value while presenting different global obligations: hyperbolicity across an entire Jensen hierarchy, Nicolas inequalities at every cutoff, and membership of one target in a closed natural-dilation span. Equivalence alone does not determine which obligation exposes a usable obstruction.",
