    {
      "object_id": "mathia_synthesis_7f41f9bc38c51c3b7d23fb2a33c04afc96c9f656e2afb155a632ac535e94d704",
      "object_role": "synthesis",
      "proposed_content": "Character orthogonality converts both the S moment and the I mean square into congruence-constrained coefficient sums. The support bound at the square-root scale then separates the product congruences: the positive sign collapses to the exact multiplicative diagonal, whereas the negative sign becomes the complementary relation in which the two products add to q and can be bounded as a non-diagonal contribution.",
