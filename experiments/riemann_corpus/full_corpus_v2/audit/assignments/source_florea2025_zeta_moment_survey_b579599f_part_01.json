    {
      "object_id": "mathia_synthesis_9ca38d2063980640c0020477afae6f52a78f010991ebccf9a9ba70c2eb1f88c4",
      "object_role": "synthesis",
      "proposed_content": "A moment computable with short Dirichlet-polynomial insertion acts as an exponent-range anchor: the upper-bound principle propagates control downward from the anchor, while the lower-bound principles use twisted mean values to reach above the first moment and a twisted second moment to reach below it.",
