    {
      "object_id": "mathia_interpretation_048d43e903b978a2254fb666c71eb107bdeb6e269e7ee10809b62adf16aff65c",
      "object_role": "interpretation",
      "proposed_content": "Arithmetic factorization converts one global correlation into local prime-power modules. Kloosterman sums encode the coupling between a residue and its multiplicative inverse, precisely the structure left by determinant-one matrices.",
