    {
      "object_id": "mathia_synthesis_daaa79d50b0d7f8df9e4efaf6f7d6682455f19845e2643a7a9767bc3d33c205a",
      "object_role": "synthesis",
      "proposed_content": "Repeated Poisson or van der Corput shortening is progressive only after an intervention restores a usable representation: coefficients are normalized, and in the cubic case the nonpolynomial saddle phase is expanded so that sufficiently small higher-order terms can be removed while the retained phase remains cubic. The next iteration can then act on a shorter sum of essentially the same controlled type.",
