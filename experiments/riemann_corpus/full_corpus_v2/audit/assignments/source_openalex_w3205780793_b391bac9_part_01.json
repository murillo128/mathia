    {
      "object_id": "mathia_synthesis_3022bcdf0ebed02b151870cf141b22b39e33957f0f0f4344a9efd2f778e0668e",
      "object_role": "synthesis",
      "proposed_content": "Placing expectation outside the squared Hilbert-space error in pNB preserves a samplewise error event that can be intersected with a positive-probability admissibility event, whereas averaging each feature first in gNB removes that samplewise route and leads instead to Mellin zero exclusion with explicit moment and coefficient-tail hypotheses.",
