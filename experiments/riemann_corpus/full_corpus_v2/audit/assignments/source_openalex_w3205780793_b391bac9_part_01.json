    {
      "object_id": "mathia_synthesis_93d00c364c4f9d2697bb9f9d1c653234355d69d5f20a5ac52980ae82e6f1b625",
      "object_role": "synthesis",
      "proposed_content": "The reciprocal-integer criterion is stable under the paper's quantitatively concentrated triangular randomization because variance first recovers simultaneous admissible support and then controls the central Mellin-frequency perturbation, while a power cutoff balances that estimate against the high-frequency tail.",
