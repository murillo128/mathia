    {
      "object_id": "mathia_synthesis_fa5a5c4a5a2fe52a491e00b5c65308c9e8d8e547b097c0f9b7485543e2868997",
      "object_role": "synthesis",
      "proposed_content": "The two Hamiltonian normalizations redistribute partial-wave dependence between the commutator scale and an additive energy shift while being asserted to preserve the same partial-wave scattering matrix. The later boundary is nevertheless observable-selective: for dilation it yields a discrete spectrum, whereas on Kruskal plane waves it only relates coefficients at opposite momenta and leaves the momentum labels continuous.",
