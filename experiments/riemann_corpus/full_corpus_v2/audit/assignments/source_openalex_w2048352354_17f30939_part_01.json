    {
      "object_id": "mathia_synthesis_3e66680efda47347e28a519ea45439fe4704cf4398559c42b9e7dfc43c1b5c31",
      "object_role": "synthesis",
      "proposed_content": "Conditioning on a distinguished eigenangle becomes computable through a chain of interfaces: remove that eigenangle to obtain a lower-dimensional two-point moment, express the moment as finite combinatorial data, pass through constant-term and Selberg forms, expose a hypergeometric coefficient array, and certify its collapse to the crossover profile by WZ telescoping.",
