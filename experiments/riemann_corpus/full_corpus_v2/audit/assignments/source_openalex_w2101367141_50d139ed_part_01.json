    {
      "object_id": "mathia_synthesis_b8ea52a1b8a38f976662d5efd85980c8c46f7e17b02b8d0af96844ad22cce8a7",
      "object_role": "synthesis",
      "proposed_content": "The moment recipe is a deliberately lossy two-stage detector: functional-equation phase or root-number averaging retains compatible branches, coefficient averaging retains diagonal correlations, and completion yields a compact proposed main term only under the hypothesis that omitted and added main-sized contributions cancel globally.",
