    {
      "object_id": "mathia_synthesis_d68467d470ed942343b7dfe489b97db3696eb733234cc4eb7ee217d8b84bb90d",
      "object_role": "synthesis",
      "proposed_content": "Independent shifts deform a coalesced moment into labeled functional-equation branches with simple singular factors; balanced branch selection and contour compression then produce a combined expression whose collision singularities cancel, allowing the unshifted moment to be recovered by coalescing the shifts.",
