    {
      "object_id": "mathia_synthesis_a52ba11b77acb356693399a14731003d939ef0ea35565e1071c866c3a976832d",
      "object_role": "synthesis",
      "proposed_content": "Finite-range validation must use the full family-specific moment polynomial with the same weighting and sampling range as the data: lower-order coefficients can dominate at accessible scale, smoothing can expose residual information beyond the integrated main polynomial, and large central values can drive correlated deviations that grow with moment order.",
