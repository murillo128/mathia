    {
      "object_id": "mathia_synthesis_826cdf935a3525aa88ffc80dcb91236687671cbc4b50bc821d80fb1047f6f2c0",
      "object_role": "synthesis",
      "proposed_content": "The source packages finite-prime and congruence corrections into multiplicative factors, transports the known pole through two functional-equation steps into an explicit target-line residue, and then applies an Euler-product pole-order test to the resulting character-indexed terms; under the limiting normalization, only the all-principal character term survives.",
