    {
      "object_id": "mathia_synthesis_3dbc322c55e3cf34e5fcce8da4fd53fcb857c7a988e6d1d51a1580ecbbc369b5",
      "object_role": "synthesis",
      "proposed_content": "Coarse Frobenius-Schur symmetry type is useful only through observables that can see it. Low trace indicators can recover coarse unitary, orthogonal, and symplectic masses, restricted Fourier support can make distinct one-level laws indistinguishable, and a nonconstant Fourier-side density changes the band-limited extremizer and the resulting arithmetic bounds.",
