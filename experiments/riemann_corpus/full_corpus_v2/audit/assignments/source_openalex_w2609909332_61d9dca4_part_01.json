    {
      "object_id": "mathia_interpretation_8ec5616b88d7161df36c10b9c42e11370d9db210087354f022ddfa23aadb7313",
      "object_role": "interpretation",
      "proposed_content": "Passing from S to S1 is not merely smoothing: differentiation is moved onto the analytic kernel, so modulus information is encoded in a controlled weighted average of the primitive. A large output of this linear functional forces S1 to be large somewhere, but the signed kernel loses one-sided sign control.",
