    {
      "object_id": "mathia_synthesis_c8003f134c682dd30160a6d6fc762b5102037d54d20f2499fa12fe108ca605f8",
      "object_role": "synthesis",
      "proposed_content": "The source joins complementary phase estimates through a critical-line cutoff: Lemma 2.3 controls arg(G_k/zeta) away from the line by Jensen and Cauchy bounds with an explicit gap cost, while Lemmas 2.4-2.5 supply a near-line growth-to-argument estimate. Splitting the residual contour integral at sigma=1/2+2 epsilon_0 and choosing epsilon_0=1/(4 log T) makes the two regimes compatible and yields the O_k((log log T)^2) error.",
      "parent_sources": [
        {
          "source_object_id": "mathia_source_87076552af795a2680eaecc9658c0815e3c31bd33313b0ceb4f8934bbd915258",
          "source_id": "openalex_w2963782307",
          "source_unit_ids": [
