    {
      "object_id": "mathia_synthesis_a3b5f0e4ef6b853f5ea3a3fe0d440ff8edff93e8c569d98521cdb6a57839c374",
      "object_role": "synthesis",
      "proposed_content": "Flat-space Fourier multiplication gives xi(1/2+i Box) an operational definition, but that diagonal representation is unavailable in the curved-space treatment and promotion to a quantum field introduces distributional, spectral, and positivity obligations. The zero-factor formulas are proposed surrogates across those changes, not automatic extensions of the flat definition.",
