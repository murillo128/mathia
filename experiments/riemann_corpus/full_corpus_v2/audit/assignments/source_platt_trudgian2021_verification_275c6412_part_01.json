    {
      "object_id": "mathia_synthesis_3fa7cf825f12189c6ea2a936c61c8a35a531f78519a833257717932ef00b52e8",
      "object_role": "synthesis",
      "proposed_content": "A bounded RH certificate couples rigorously controlled numerical evaluation to two logically different zero checks: critical-line sign changes supply local witnesses, while Turing-style expected-zero accounting supplies completeness. Because the certificate consumes existence and count information rather than a high-precision zero database, localization can stop after a sufficient witness without changing the certificate's logical form.",
