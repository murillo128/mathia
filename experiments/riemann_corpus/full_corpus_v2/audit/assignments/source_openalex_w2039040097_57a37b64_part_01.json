    {
      "object_id": "mathia_synthesis_d6ffb61e0a5af09e3abd70d0bcfc0e198c155be72e97f5070da9df8158f81cd2",
      "object_role": "synthesis",
      "proposed_content": "Euler-Maclaurin refines the already controlled S1 contribution by adding Bernoulli-weighted endpoint corrections to its digamma bulk term, but the Li decomposition shows that sharper S1 asymptotics do not remove the independent need to control the eta-binomial residual S2.",
