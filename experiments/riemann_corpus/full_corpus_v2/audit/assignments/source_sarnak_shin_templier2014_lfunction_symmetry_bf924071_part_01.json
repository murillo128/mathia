    {
      "object_id": "mathia_synthesis_10584b61d3ef2c2151ab7e9d1533b32e84131daf6e7b3a3d6be833987c3a9893",
      "object_role": "synthesis",
      "proposed_content": "Persistent central vanishing and parity-forced central zeros enter through distinct family invariants: geometric rank is read from the secondary term in the primewise local average after the Sato–Tate main term, whereas root number is assembled from ramified local epsilon factors and its distribution is controlled by Möbius-type cancellation.",
