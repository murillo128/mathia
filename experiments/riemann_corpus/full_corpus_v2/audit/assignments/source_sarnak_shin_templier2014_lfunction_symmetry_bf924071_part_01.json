    {
      "object_id": "mathia_synthesis_7902f4eaa3a6d65a7a0a668e2ecb4927c5f0bd9bc0f6f9911e025562cfc7b226",
      "object_role": "synthesis",
      "proposed_content": "Vertical local equidistribution supplies a family Sato–Tate measure whose trace moments recover coarse unitary, orthogonal, and symplectic masses; the symplectic mass must then be refined by the independent root number before conductor-scaled low zeros are assigned their random-matrix laws.",
