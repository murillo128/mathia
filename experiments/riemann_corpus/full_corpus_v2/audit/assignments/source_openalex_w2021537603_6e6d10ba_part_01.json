    {
      "object_id": "mathia_synthesis_0a31b24d5a8f56deee698cba7f8b61bfb52f336a0ca001464e2bf59a667d012a",
      "object_role": "synthesis",
      "proposed_content": "The two signs of the Kloosterman kernel enter the spectral formula by complementary routes: the opposite-sign trace formula yields Maass and continuous pieces, while the positive-sign Kloosterman-zeta decomposition adds Maass, continuous, holomorphic, and diagonal pieces; the auxiliary diagonal term is then proved to cancel before the positive-sign contribution is assembled into three spectral branches.",
