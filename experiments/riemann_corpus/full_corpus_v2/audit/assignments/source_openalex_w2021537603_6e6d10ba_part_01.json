    {
      "object_id": "mathia_synthesis_b7895c1bd07aa57d5ef230a3c22f0297192633098fa39b87db9928b7d9b53138",
      "object_role": "synthesis",
      "proposed_content": "The explicit formula is obtained only after global continuation separates directly specializable spectral branches from a singular main aggregate: the regular branches are evaluated at the target, the main aggregate is pulled back along a generic complex line so its Laurent singularities cancel collectively, and an exceptional kernel is split into an explicit residue and a regular remainder that is bounded before the continued kernels are identified with the theorem's hypergeometric kernel.",
