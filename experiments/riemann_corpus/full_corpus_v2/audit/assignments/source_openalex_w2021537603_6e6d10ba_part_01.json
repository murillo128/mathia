    {
      "object_id": "mathia_synthesis_0168433b8264f14fca352c0274631a4a97b2235718e5c36dec91114e91cbf032",
      "object_role": "synthesis",
      "proposed_content": "The source localizes continuation work in one master Mellin-Barnes kernel: algebraic relations reduce the earlier spectral kernels to it, finite residue extraction plus an arbitrarily enlargeable regular remainder proves its global meromorphy and decay, and a separate contour shift continues the continuous-spectrum integral while explicitly retaining every crossed arithmetic pole before specialization.",
