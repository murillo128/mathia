    {
      "object_id": "mathia_synthesis_7de2e8105cfa55120d2b929135d4dbd54d4d94c66baec91298db7cbf85666df8",
      "object_role": "synthesis",
      "proposed_content": "The archimedean local term is written as a trace defect relative to independent time and frequency projections. The spectrum of the associated projection product records their relative angles and also enters the Fredholm generating function for large-random-matrix interval counts, giving a concrete shared invariant between local cutoff geometry and a probabilistic gap observable.",
