    {
      "object_id": "mathia_synthesis_df5ee7b1adc0ca41c2c2ac33b6e3a7f78275f8863d7bf394fa87751866de8d9a",
      "object_role": "synthesis",
      "proposed_content": "The leading inverse-hole-width term is geometric, determined by total hole size, so the one-hole coefficient is twice the leading symmetric two-hole coefficient. The source removes that term either explicitly, by subtracting 2/epsilon from the one-hole coefficient, or relationally, by subtracting twice the symmetric two-hole coefficient; it states that the resulting correction satisfies the displayed small-hole bound for every positive delta exactly when RH holds.",
