    {
      "object_id": "mathia_interpretation_3e8f6faf8f0cdb4ec24b8265e9cd1694be2da43d39a87fc91e4586a7d6fc5da1",
      "object_role": "interpretation",
      "proposed_content": "The analytic representation distributes a sharp feature across complex modes. Nonsmoothness in hole width is therefore global information in the pole expansion rather than the contribution of a single real asymptotic term.",
