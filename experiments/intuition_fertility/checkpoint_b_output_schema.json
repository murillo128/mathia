{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "uncertain"
  ],
  "properties": {
    "label": {
      "type": "string",
      "enum": [
        "strategic",
        "borderline",
        "proof_like"
      ]
    },
    "uncertain": {
      "type": "boolean"
    }
  }
}
